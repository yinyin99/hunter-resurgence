<Application x:Class="Backup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Blazor app tokens (src/Ui/wwwroot/theme.css) over WPF UI's Dark keys. Direct keys beat the merged dictionaries.
                 Dark.xaml binds most brush colors with StaticResource, so those are overridden as brushes here.
                 The window background is set in MainWindow.xaml.cs (FluentWindow resets it) and the window text colour in MainWindow.xaml.
                 The accent is set in App.xaml.cs: accent keys set only here did not hold (ticks and toggles rendered system blue). -->

            <!-- keyboard focus ring: accent token -->
            <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="#F9560D" />

            <!-- surfaces: surface-1 window, surface-2 .panel, line card stroke -->
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#111111" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#161616" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#222222" />
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#161616" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#222222" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="#333333" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#161616" />

            <!-- text: text-1, fg-muted, fg-muted-3 (disabled) -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#999999" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#888888" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#666666" />

            <!-- controls take their text colour from their own keys, not from TextFillColorPrimaryBrush -->
            <SolidColorBrush x:Key="ButtonForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#EEEEEE" />
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="RadioButtonForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="InfoBarTitleForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="MessageBoxForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#EEEEEE" />

            <!-- fields (.field): surface-3, line-2 border, text-2 text, accent focus border (TextControlFocusedBorderBrush is already the accent) -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#222222" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#707070" /> <!-- 3.4:1 on the field -->
            <SolidColorBrush x:Key="TextControlForeground" Color="#DDDDDD" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8A8A" /> <!-- 4.9:1 on the field, dimmer than typed text -->
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#1C1C1C" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#1C1C1C" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#222222" />

            <!-- plain buttons: btn-ui-bg, btn-inverse-bg, surface-6 -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#3C3C3C" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#444444" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#333333" />

            <!-- primary button (.btn-primary): primary / primary-hover, white text. Also white on-accent glyphs (WPF UI uses black on its dark accent) -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#F9370D" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E72D06" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E72D06" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />

            <!-- progress track: the template draws it with the border brush (the 2px inside the margin), 3:1 on the card and the window -->
            <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="#666666" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
