<ui:FluentWindow x:Class="Backup.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="880" Height="690" MinWidth="720" MinHeight="600"
                 WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- Start sits on the accent fill, so the accent focus ring vanishes: a white ring outside the button -->
        <Style x:Key="StartFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" Stroke="White" StrokeThickness="2" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBarMain" />

        <Grid x:Name="Body" Grid.Row="1" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="420" /> <!-- status card, two group rows and the folder card: the list scrolls below that, it never collapses -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- cards: locked while a backup runs. The group list takes the space that is left and scrolls, so the folder card, Start and Details stay on a small screen -->
            <Grid x:Name="Inputs">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="StatusIcon" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <ComboBox x:Name="LangBox" Grid.Column="2" MinWidth="130" Margin="12,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                        <WrapPanel>
                            <RadioButton x:Name="OwnRadio" GroupName="Source" IsChecked="True" MinWidth="0" Margin="0,0,16,0" />
                            <RadioButton x:Name="PublicRadio" GroupName="Source" MinWidth="0" />
                            <ui:TextBox x:Name="Who" Width="230" Margin="12,0,0,0" IsEnabled="False" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="GroupsTitle" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <UniformGrid x:Name="Groups" Columns="2" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.ColumnSpan="2" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="OutDir" />
                            <ui:Button x:Name="Browse" Grid.Column="1" Margin="8,0,0,0" />
                        </Grid>
                        <ui:ToggleSwitch x:Name="Zip" Grid.Row="1" IsChecked="True" />
                        <ui:ToggleSwitch x:Name="Skip" Grid.Row="1" Grid.Column="1" IsChecked="True" />
                        <ui:ToggleSwitch x:Name="Upload" Grid.Row="2" IsEnabled="False" />
                        <ui:ToggleSwitch x:Name="Older" Grid.Row="2" Grid.Column="1" IsChecked="False" IsEnabled="False" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="Start" Appearance="Primary" Width="150" Height="36" HorizontalContentAlignment="Center" FocusVisualStyle="{StaticResource StartFocus}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="0" Height="4" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:InfoBar x:Name="Result" IsOpen="False" IsClosable="False" Margin="0,0,0,8" />
                <ui:Button x:Name="OpenBtn" Grid.Column="1" Margin="8,0,0,8" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Row="4">
                <Expander x:Name="Details" VerticalAlignment="Stretch">
                    <TextBox x:Name="LogBox" Height="155" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </Expander>
                <ui:Button x:Name="NotCoveredLink" Appearance="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,44,0" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
