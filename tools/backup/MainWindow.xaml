<ui:FluentWindow x:Class="Backup.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Profile backup (read-only)" Width="880" Height="690" MinWidth="720" MinHeight="600"
                 WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Profile backup (read-only)" />

        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- cards: locked while a backup runs -->
            <StackPanel x:Name="Inputs">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="StatusIcon" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OwnRadio" GroupName="Source" Content="My account (from the running game)" IsChecked="True"
                                         MinWidth="0" Margin="0,0,16,0" AutomationProperties.Name="My account, from the running game" />
                            <RadioButton x:Name="PublicRadio" GroupName="Source" Content="Public profile" MinWidth="0"
                                         AutomationProperties.Name="Public profile" />
                            <ui:TextBox x:Name="Who" Width="230" Margin="12,0,0,0" IsEnabled="False" PlaceholderText="handle or id"
                                        AutomationProperties.Name="Handle or id of the public profile" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="What to save" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <UniformGrid x:Name="Groups" Columns="2" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.ColumnSpan="2" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="OutDir" PlaceholderText="Output folder" AutomationProperties.Name="Output folder" />
                            <ui:Button x:Name="Browse" Grid.Column="1" Content="Browse…" Margin="8,0,0,0" AutomationProperties.Name="Browse for the output folder" />
                        </Grid>
                        <ui:ToggleSwitch x:Name="Zip" Grid.Row="1" Content="Save a zip" IsChecked="True" AutomationProperties.Name="Save a zip" />
                        <ui:ToggleSwitch x:Name="Skip" Grid.Row="1" Grid.Column="1" Content="Skip files already saved (resume)" IsChecked="True"
                                         AutomationProperties.Name="Skip files already saved" />
                        <ui:ToggleSwitch Grid.Row="2" Grid.ColumnSpan="2" Content="Upload to server: coming later" IsEnabled="False"
                                         AutomationProperties.Name="Upload to server, not available yet" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="Start" Content="Start" Appearance="Primary" Width="150" Height="36" HorizontalContentAlignment="Center"
                           AutomationProperties.Name="Start the backup" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="0" Height="4" AutomationProperties.Name="Backup progress" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:InfoBar x:Name="Result" IsOpen="False" IsClosable="False" Margin="0,0,0,8" />
                <ui:Button x:Name="OpenBtn" Grid.Column="1" Content="Open folder" Margin="8,0,0,8" VerticalAlignment="Center" Visibility="Collapsed"
                           AutomationProperties.Name="Open the backup in Explorer" />
            </Grid>

            <Grid Grid.Row="4">
                <Expander x:Name="Details" Header="Details" VerticalAlignment="Stretch">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             AutomationProperties.Name="Log" />
                </Expander>
                <ui:Button x:Name="NotCoveredLink" Content="What isn't saved?" Appearance="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,2,44,0" AutomationProperties.Name="What is not saved" />
                <Popup x:Name="NotCoveredPopup" PlacementTarget="{Binding ElementName=NotCoveredLink}" Placement="Top" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource Card}" Background="{DynamicResource ApplicationBackgroundBrush}" Padding="14,10" Margin="8" MaxWidth="600">
                        <TextBlock x:Name="NotCoveredText" TextWrapping="Wrap" />
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
