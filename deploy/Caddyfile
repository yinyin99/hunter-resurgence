# The website and the community server on one domain (SITE_DOMAIN in .env), behind Cloudflare with an origin certificate.
# The server's address is server:8080, on the internal network only; it believes X-Game-Host only from this Caddy's fixed address (docs/deploy.md).

# every proxied request: the client of Cloudflare (trustworthy because the firewall lets only Cloudflare reach 80 and 443), and a wait while a deploy
# recreates the container (about 12 s): Caddy dials again until the new one answers, instead of a 502. Only a failed dial is retried for a
# POST, so a heartbeat or a purchase that reached the old container is never sent twice
(upstream) {
	header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	lb_try_duration 30s
	lb_try_interval 500ms
}

# the server on the website's domain: the browser's Host decides here, never a header a visitor set
(to_server) {
	reverse_proxy server:8080 {
		import upstream
		header_up -X-Game-Host
	}
}

{$SITE_DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip
	header -Server

	# the server's own paths on the website's domain: sign-in and what goes with it, the account's own data (the backup tool's upload too), the public profiles and
	# boards, the store's catalogue, the gallery photos. The launcher on a player's PC calls them here, the website's server over SERVER_URL. The one place to change them.
	@server_paths path /auth/* /account/* /hunters /hunters/* /catalog/* /photos/*
	# the minigames' boards share their paths with the website's leaderboard pages: a page load asks for HTML and stays the website's
	@server_boards {
		path /leaderboards/*
		not header Accept *text/html*
	}
	# every game request of a player's local forwarder: the hostname the game asked for is in X-Game-Host
	@game header X-Game-Host *

	handle @game {
		reverse_proxy server:8080 {
			import upstream
		}
	}
	handle @server_paths {
		import to_server
	}
	handle @server_boards {
		import to_server
	}
	handle {
		reverse_proxy web:8080 {
			import upstream
			header_up -X-Game-Host
			# SignalR fallbacks (server-sent events, long polling) unbuffered
			flush_interval -1
		}
	}
}

# other projects' sites on this host (docs/deploy.md)
import /etc/caddy/sites/*.caddy
