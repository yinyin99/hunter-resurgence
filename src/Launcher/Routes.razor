@using Microsoft.JSInterop
@inject HostMode Mode
@inject Resurgence.Services.ISessionService Sessions
@inject IJSRuntime JS

<Router AppAssembly="typeof(Routes).Assembly"
        AdditionalAssemblies="new[] { typeof(Strings).Assembly }"
        NotFoundPage="typeof(Resurgence.Ui.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Resurgence.Ui.Layouts.ShellLayout)" />
    </Found>
</Router>

@code {
    protected override Task OnInitializedAsync() => Mode.ApplyMockSessionAsync(Sessions);

    // the host page is static HTML: tell it the language of this run
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await using var shell = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Resurgence.Ui/shell.js");
        await shell.InvokeVoidAsync("setLang", System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
    }
}
