@inject HostMode Mode
@inject Resurgence.Services.ISessionService Sessions

<Router AppAssembly="typeof(Routes).Assembly"
        AdditionalAssemblies="new[] { typeof(Strings).Assembly }"
        NotFoundPage="typeof(Resurgence.Ui.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Resurgence.Ui.Layouts.ShellLayout)" />
    </Found>
</Router>

@code {
    protected override Task OnInitializedAsync() => Mode.ApplyMockSessionAsync(Sessions);
}
