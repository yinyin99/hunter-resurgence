@implements IDisposable
@inject LauncherState State

<div class="statusbar">
    <a class="chip" href="/players/@SampleData.Me.Handle"><Avatar Handle="@SampleData.Me.Handle" /> @SampleData.Me.Handle</a>
    <span><span class="muted">@L["Launcher.Wallet"]</span> <span class="credits">@L["Launcher.Credits", State.Wallet]</span></span>
    <a href="/" title="@L["Launcher.ChangeServer"]">
        <span class="muted">@L["Launcher.Server"]</span>
        <ServerStatusLabel Status="State.SelectedServer.Status" Compact="true" /> @State.SelectedServer.Name
    </a>
    <span class="spacer"></span>
    <a href="/sign-in">@L["Launcher.SignOut"]</a>
</div>

@code {
    protected override void OnInitialized() => State.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= Refresh;
}
