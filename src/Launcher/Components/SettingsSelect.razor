<SettingsRow Label="@Label" Hint="@Hint">
    <select id="@context" class="input" @onchange="e => ValueChanged.InvokeAsync(int.Parse((string)e.Value!))">
        @for (var i = 0; i < Options.Count; i++)
        {
            <option value="@i" selected="@(i == Value)">@Options[i]</option>
        }
    </select>
</SettingsRow>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    /// <summary>Already localized display texts; the value is the index.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Options { get; set; } = [];
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
}
