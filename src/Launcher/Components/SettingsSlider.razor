<SettingsRow Label="@Label" Hint="@Hint">
    <input id="@context" type="range" class="slider" min="@Min" max="@Max" value="@Value"
           @oninput="e => ValueChanged.InvokeAsync(int.Parse((string)e.Value!))" />
    <output class="mono" for="@context" style="min-width: 2.5rem; text-align: right">@Value</output>
</SettingsRow>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public int Min { get; set; }
    [Parameter] public int Max { get; set; } = 100;
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
}
