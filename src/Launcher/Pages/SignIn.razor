@page "/sign-in"
@layout Resurgence.Launcher.Layout.SignInLayout
@inject NavigationManager Nav

<PageTitle>@L["Nav.SignIn"] - @L["App.Name"]</PageTitle>

<div class="card stack">
    <h1>@L["SignIn.Title"]</h1>
    <ol class="stepper">
        <li class="step @(codeSent ? "done" : "current")">@L["SignIn.StepEmail"]</li>
        <li class="step @(codeSent ? "current" : null)" aria-current="@(codeSent ? "step" : null)">@L["SignIn.StepCode"]</li>
    </ol>

    @if (!codeSent)
    {
        <form class="stack" @onsubmit="SendCode" novalidate>
            <p class="muted">@L["SignIn.EmailLead"]</p>
            <div class="field">
                <label for="signin-email">@L["SignIn.Email"]</label>
                <input id="signin-email" class="input" type="email" autocomplete="email" @bind="email" @bind:event="oninput"
                       aria-invalid="@Invalid" aria-describedby="signin-error" />
            </div>
            @Error
            <button type="submit" class="btn">@L["SignIn.SendCode"]</button>
        </form>
    }
    else
    {
        <form class="stack" @onsubmit="Verify" novalidate>
            <p class="muted">@L["SignIn.CodeSent", email.Trim()]</p>
            <div class="field">
                <label for="signin-code">@L["SignIn.Code"]</label>
                <input id="signin-code" class="input mono" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code"
                       @bind="code" @bind:event="oninput" aria-invalid="@Invalid" aria-describedby="signin-error" />
            </div>
            @Error
            <button type="submit" class="btn">@L["Nav.SignIn"]</button>
            <button type="button" class="link-btn" @onclick="UseAnotherEmail">@L["SignIn.UseAnotherEmail"]</button>
        </form>
    }

    <p class="hint">@L["SignIn.SteamNote"]</p>
</div>

@code {
    string email = "", code = "";
    bool codeSent;
    LocalizedString? error;

    string? Invalid => error is null ? null : "true";
    RenderFragment Error => @<text>@if (error is not null) { <p id="signin-error" class="error" role="alert">@error</p> }</text>;

    void SendCode()
    {
        var e = email.Trim();
        error = e.Length > 0 && e.Contains('@') ? null : L["SignIn.EmailInvalid"];
        if (error is null) { codeSent = true; code = ""; }
    }

    void Verify()
    {
        error = code.Length == 6 && code.All(char.IsAsciiDigit) ? null : L["SignIn.CodeInvalid"];
        if (error is null) Nav.NavigateTo("/");
    }

    void UseAnotherEmail() { codeSent = false; error = null; }
}
