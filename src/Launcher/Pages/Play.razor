@page "/"
@using Resurgence.Launcher.Components
@inject LauncherState State

<PageHeader Title="@L["Nav.Play"]" Lead="@L["Play.Lead"]" />

@if (gameFound)
{
    <p class="row"><span class="badge ok">@L["Play.GameFoundBadge"]</span> <span>@L["Play.GameFound", SampleData.GameFolder]</span></p>
}
else
{
    <p class="row"><span class="badge warn">@L["Play.GameMissingBadge"]</span> <span>@L["Play.GameMissing"] <a href="/settings/app">@L["Play.GameMissingLink"]</a></span></p>
}

<section class="card hero" aria-labelledby="hero-title">
    <div class="stack">
        <span class="muted">@L["Play.Server"]</span>
        <h2 id="hero-title">@server.Name</h2>
        <dl class="facts">
            <div><dt>@L["Play.Region"]</dt><dd>@server.Region</dd></div>
            <div><dt>@L["Play.PlayersOnline"]</dt><dd class="mono">@server.Players / @server.MaxPlayers</dd></div>
            <div><dt>@L["Play.Ping"]</dt><dd class="mono">@Ping(server)</dd></div>
            <div><dt>@L["Play.Version"]</dt><dd>@server.Version</dd></div>
            <div><dt>@L["Play.Status"]</dt><dd><ServerStatusLabel Status="server.Status" /></dd></div>
        </dl>
        <div><button type="button" class="btn btn-secondary" @onclick="() => pickerOpen = true">@L["Play.ChangeServer"]</button></div>
    </div>
    <div class="go">
        <button type="button" class="btn btn-lg" disabled="@(!gameFound || server.Status == ServerStatus.Offline)">@L["Play.HuntNow"]</button>
    </div>
</section>

<div class="section row">
    <span id="mode-label" class="muted">@L["Play.Mode"]</span>
    <div class="segmented" role="group" aria-labelledby="mode-label">
        <button type="button" class="segment" aria-pressed="@Pressed(Mode.Single)" @onclick="() => mode = Mode.Single">@L["Play.ModeSingle"]</button>
        <button type="button" class="segment" aria-pressed="@Pressed(Mode.Host)" @onclick="() => mode = Mode.Host">@L["Play.ModeHost"]</button>
        <button type="button" class="segment" aria-pressed="@Pressed(Mode.Join)" @onclick="() => mode = Mode.Join">@L["Play.ModeJoin"]</button>
    </div>
</div>

@if (mode == Mode.Join)
{
    <h2 class="section-title">@L["Play.OpenGames"]</h2>
    @if (SampleData.OpenGames.Count == 0)
    {
        <p class="empty">@L["Play.NoOpenGames"]</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th scope="col">@L["Play.Host"]</th>
                        <th scope="col">@L["Play.Reserve"]</th>
                        <th scope="col">@L["Play.Players"]</th>
                        <th scope="col">@L["Play.Access"]</th>
                        <th scope="col"><span class="visually-hidden">@L["Play.Join"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in SampleData.OpenGames)
                    {
                        <tr>
                            <th scope="row">@g.Host</th>
                            <td>@g.Reserve</td>
                            <td class="mono">@g.Players / @g.MaxPlayers</td>
                            <td>@if (g.Locked) { <span class="badge accent">@L["Play.Password"]</span> } else { <span class="badge">@L["Play.Open"]</span> }</td>
                            <td class="num"><button type="button" class="btn btn-sm" disabled="@(!gameFound || g.Players >= g.MaxPlayers)">@(g.Players >= g.MaxPlayers ? L["Play.Full"] : L["Play.Join"])</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <h2 class="section-title">@L["Play.ChooseReserve"]</h2>
    @if (SampleData.Reserves.Count == 0)
    {
        <p class="empty">@L["Page.Empty"]</p>
    }
    else
    {
        <div class="grid">
            @foreach (var r in SampleData.Reserves)
            {
                var name = r.Name;
                <button type="button" class="card reserve" aria-pressed="@(reserve == name ? "true" : "false")" @onclick="() => reserve = name">
                    <span class="art" aria-hidden="true">@name[0]</span>
                    <strong>@name</strong>
                    <span class="muted">@r.Description</span>
                </button>
            }
        </div>
    }

    @if (mode == Mode.Host)
    {
        <section class="card section" aria-labelledby="host-title">
            <h2 id="host-title" class="section-title">@L["Play.HostOptions"]</h2>
            <div class="form-grid">
                <div class="field">
                    <label for="host-name">@L["Play.GameName"]</label>
                    <input id="host-name" class="input" maxlength="40" @bind="gameName" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label for="host-max">@L["Play.MaxPlayers"]</label>
                    <select id="host-max" class="input" @bind="maxPlayers">
                        @for (var n = 2; n <= 8; n++)
                        {
                            <option value="@n">@n</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="host-password">@L["Play.GamePassword"]</label>
                    <input id="host-password" class="input" type="password" autocomplete="new-password" aria-describedby="host-password-hint" @bind="password" @bind:event="oninput" />
                    <p id="host-password-hint" class="hint">@L["Play.PasswordHint"]</p>
                </div>
                <div class="field">
                    <span id="host-public-label" class="label">@L["Play.PublicGame"]</span>
                    <label class="switch">
                        <input type="checkbox" role="switch" aria-labelledby="host-public-label" @bind="isPublic" />
                        <span class="switch-track"></span>
                    </label>
                    <p class="hint">@L["Play.PublicHint"]</p>
                </div>
            </div>
        </section>
    }
}

<section class="section" aria-labelledby="news-title">
    <h2 id="news-title" class="section-title">@L["Play.News"]</h2>
    @if (SampleData.News.Count == 0)
    {
        <p class="empty">@L["Page.Empty"]</p>
    }
    else
    {
        <div class="grid wide">
            @foreach (var n in SampleData.News)
            {
                <article class="card">
                    <h3>@n.Title</h3>
                    <time class="muted" datetime="@n.Date.ToString("yyyy-MM-dd")">@n.Date.ToString("d")</time>
                    <p>@n.Excerpt</p>
                </article>
            }
        </div>
    }
</section>

<div class="picker">
    <Dialog Open="pickerOpen" Title="@L["Play.ChooseServer"]" OnClose="() => pickerOpen = false">
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th scope="col">@L["Play.Server"]</th>
                        <th scope="col">@L["Play.Region"]</th>
                        <th scope="col">@L["Play.Players"]</th>
                        <th scope="col">@L["Play.Ping"]</th>
                        <th scope="col">@L["Play.Status"]</th>
                        <th scope="col"><span class="visually-hidden">@L["Common.Select"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in SampleData.Servers)
                    {
                        var current = s == server;
                        <tr aria-current="@(current ? "true" : null)" class="@(current ? "me" : null)">
                            <th scope="row">@s.Name @if (current) { <span class="badge accent">@L["Play.Current"]</span> }</th>
                            <td>@s.Region</td>
                            <td class="mono">@s.Players / @s.MaxPlayers</td>
                            <td class="mono">@Ping(s)</td>
                            <td><ServerStatusLabel Status="s.Status" /></td>
                            <td class="num"><button type="button" class="btn btn-sm" disabled="@(current || s.Status == ServerStatus.Offline)" @onclick="() => Pick(s)">@L["Common.Select"]</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Dialog>
</div>

@code {
    enum Mode { Single, Host, Join }

    Mode mode;
    string reserve = SampleData.Reserves[0].Name;
    string gameName = "";
    // a field, not the const itself: the compiler would flag the unused branch of the check
    readonly bool gameFound = SampleData.GameFound;
    int maxPlayers = 4;
    bool isPublic = true;
    string password = "";
    bool pickerOpen;

    protected override void OnInitialized() => gameName = L["Play.DefaultGameName", SampleData.Me.Handle];

    ServerInfo server => State.SelectedServer;

    string Pressed(Mode m) => mode == m ? "true" : "false";
    string Ping(ServerInfo s) => s.Status == ServerStatus.Offline ? "-" : L["Play.PingMs", s.PingMs];

    void Pick(ServerInfo s)
    {
        State.SelectServer(s);
        pickerOpen = false;
    }
}
