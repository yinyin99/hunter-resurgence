@page "/restore"
@inject LauncherEnv Env

<PageHeader Title="@L["Nav.Restore"]" Lead="@L["Restore.Lead"]" />

<section class="card">
    <p>@L["Restore.Explain"]</p>
    <p class="hint">
        <a href="https://github.com/yinyin99/hunter-resurgence/blob/main/docs/backup.md#what-is-not-saved" target="_blank" rel="noopener">@L["Restore.NotRestored"]</a>
    </p>
</section>

<ol class="stepper" aria-label="@L["Restore.Steps"]">
    @for (var i = 0; i < StepNames.Length; i++)
    {
        <li class="step @(i < step ? "done" : i == step ? "current" : "")" aria-current="@(i == step ? "step" : null)">
            @L[$"Restore.Step.{StepNames[i]}"]
        </li>
    }
</ol>

<section class="card stack">
    @switch (step)
    {
        case 0:
            <p class="hint">@L["Restore.File.Hint"]</p>
            <div class="row">
                <button type="button" class="btn btn-secondary" @onclick="Choose">@L["Restore.Choose"]</button>
                @if (zipPath is not null) { <span class="mono">@Path.GetFileName(zipPath)</span> }
            </div>
            @if (result?.Error is { } error)
            {
                <p role="alert"><span class="badge warn">@L[$"Restore.Error.{error}"]</span></p>
            }
            else if (info is not null)
            {
                <p role="status"><span class="badge ok">@L["Restore.Valid"]</span></p>
                <dl class="summary">
                    <dt>@L["Restore.Uid"]</dt><dd class="mono">@info.Uid</dd>
                    <dt>@L["Restore.Handle"]</dt><dd>@(info.Handle ?? "-")</dd>
                    <dt>@L["Restore.ToolVersion"]</dt><dd>@info.ToolVersion</dd>
                    <dt>@L["Restore.Date"]</dt><dd>@info.StartedUtc.ToLocalTime().ToString("g")</dd>
                    <dt>@L["Restore.Groups"]</dt><dd>@string.Join(", ", info.Groups.Select(GroupName))</dd>
                </dl>
            }
            break;
        case 1:
            <p><span class="badge ok">@L["Restore.Claim.Ok"]</span></p>
            <p class="hint">@L["Restore.Claim.Hint"]</p>
            <h2>@L["Restore.Steam"]</h2>
            @if (info!.SteamId64 is null)
            {
                <p><span class="badge">@L["Restore.Steam.None"]</span></p>
            }
            else if (Env.SteamId64 is null)
            {
                <p><span class="badge">@L["Restore.Steam.NotRunning"]</span></p>
            }
            else if (Env.SteamId64 == info.SteamId64)
            {
                <p><span class="badge ok">@L["Restore.Steam.Same"]</span></p>
            }
            else
            {
                <p><span class="badge warn">@L["Restore.Steam.Differs"]</span></p>
            }
            <p class="hint">@L["Restore.Steam.Hint"]</p>
            break;
        case 2:
            <div class="tiles">
                <div class="tile"><span class="value mono">@info!.Files.ToString("N0")</span><span class="caption">@L["Restore.Files"]</span></div>
                <div class="tile"><span class="value mono">@((info.Files - info.Failed).ToString("N0"))</span><span class="caption">@L["Restore.FilesSaved"]</span></div>
                <div class="tile"><span class="value mono">@info.Failed.ToString("N0")</span><span class="caption">@L["Restore.FilesFailed"]</span></div>
                <div class="tile"><span class="value mono">@info.Groups.Count</span><span class="caption">@L["Restore.Groups"]</span></div>
            </div>
            <p>@string.Join(", ", info.Groups.Select(GroupName))</p>
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr>
                            <th scope="col">@L["Restore.Endpoint"]</th>
                            <th scope="col" class="num">@L["Restore.Files"]</th>
                            <th scope="col" class="num">@L["Restore.FilesFailed"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in info.Endpoints)
                        {
                            <tr>
                                <td class="mono">@e.Endpoint</td>
                                <td class="num mono">@e.Files</td>
                                <td class="num mono">@e.Failed</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            break;
        default:
            <dl class="summary">
                <dt>@L["Restore.Summary.File"]</dt><dd class="mono">@Path.GetFileName(zipPath)</dd>
                <dt>@L["Restore.Uid"]</dt><dd class="mono">@info!.Uid</dd>
                <dt>@L["Restore.Handle"]</dt><dd>@(info.Handle ?? "-")</dd>
                <dt>@L["Restore.Files"]</dt><dd>@info.Files.ToString("N0")</dd>
            </dl>
            <p class="hint">@L["Restore.Offline"]</p>
            break;
    }
</section>

<div class="row">
    <button type="button" class="btn btn-secondary" disabled="@(step == 0)" @onclick="() => step--">@L["Common.Back"]</button>
    @if (step < StepNames.Length - 1)
    {
        <button type="button" class="btn" disabled="@(info is null)" @onclick="() => step++">@L["Common.Next"]</button>
    }
    else
    {
        <button type="button" class="btn" disabled aria-describedby="restore-needs">@L["Restore.Confirm"]</button>
        <span id="restore-needs" class="muted">@L["Play.NeedsServer"]</span>
    }
</div>

@code {
    private static readonly string[] StepNames = ["Upload", "Verify", "Preview", "Confirm"];

    private int step;
    private string? zipPath;
    private BackupResult? result;

    private BackupInfo? info => result?.Info;

    // the zip is read in place (read-only); nothing is copied or sent
    private void Choose()
    {
        if (LauncherEnv.PickZip() is not { } path) return;
        zipPath = path;
        result = BackupZip.Read(path);
    }

    private string GroupName(string g) => L[$"Restore.Group.{g}"].ResourceNotFound ? g : L[$"Restore.Group.{g}"];
}
