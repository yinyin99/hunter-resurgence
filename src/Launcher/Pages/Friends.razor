@page "/friends"

<PageHeader Title="@L["Nav.Friends"]" Lead="@L["Friends.Lead"]" />

<form class="toolbar" @onsubmit="Add" novalidate>
    <div class="field">
        <label for="friend-handle">@L["Friends.AddLabel"]</label>
        <input id="friend-handle" class="input" maxlength="32" autocomplete="off" @bind="handle" @bind:event="oninput" aria-describedby="friend-message" />
    </div>
    <button type="submit" class="btn">@L["Friends.Send"]</button>
    <p id="friend-message" class="@(messageIsError ? "error" : "muted") message" role="status">@message</p>
</form>

<section aria-labelledby="friends-title">
    <h2 id="friends-title" class="section-title">@L["Friends.List"] <span class="muted">(@friends.Count)</span></h2>
    @if (friends.Count == 0)
    {
        <p class="empty">@L["Friends.NoFriends"]</p>
    }
    else
    {
        <div class="grid">
            @foreach (var f in friends.OrderBy(x => x.Activity == FriendActivity.Offline).ThenBy(x => x.Handle))
            {
                var online = f.Activity != FriendActivity.Offline;
                <article class="card person">
                    <Avatar Handle="@f.Handle" />
                    <div class="who">
                        <strong>@f.Handle</strong>
                        <span class="muted">
                            <span class="dot @(online ? "online" : "offline")" aria-hidden="true"></span>
                            <span class="visually-hidden">@(online ? L["Common.Online"] : L["Common.Offline"])</span>
                            @Activity(f)
                        </span>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="section" aria-labelledby="incoming-title">
    <h2 id="incoming-title" class="section-title">@L["Friends.Incoming"] <span class="muted">(@incoming.Count)</span></h2>
    @if (incoming.Count == 0)
    {
        <p class="empty">@L["Friends.NoIncoming"]</p>
    }
    else
    {
        <div class="grid wide">
            @foreach (var h in incoming.ToList())
            {
                <article class="card person">
                    <Avatar Handle="@h" />
                    <strong class="who">@h</strong>
                    <button type="button" class="btn btn-sm" aria-label="@L["Friends.AcceptFrom", h]" @onclick="() => Accept(h)">@L["Friends.Accept"]</button>
                    <button type="button" class="btn btn-secondary btn-sm" aria-label="@L["Friends.DeclineFrom", h]" @onclick="() => incoming.Remove(h)">@L["Friends.Decline"]</button>
                </article>
            }
        </div>
    }
</section>

<section class="section" aria-labelledby="outgoing-title">
    <h2 id="outgoing-title" class="section-title">@L["Friends.Outgoing"] <span class="muted">(@outgoing.Count)</span></h2>
    @if (outgoing.Count == 0)
    {
        <p class="empty">@L["Friends.NoOutgoing"]</p>
    }
    else
    {
        <div class="grid wide">
            @foreach (var h in outgoing.ToList())
            {
                <article class="card person">
                    <Avatar Handle="@h" />
                    <strong class="who">@h</strong>
                    <button type="button" class="btn btn-secondary btn-sm" aria-label="@L["Friends.CancelTo", h]" @onclick="() => outgoing.Remove(h)">@L["Common.Cancel"]</button>
                </article>
            }
        </div>
    }
</section>

@code {
    readonly List<FriendInfo> friends = [.. SampleData.Friends];
    readonly List<string> incoming = [.. SampleData.IncomingRequests];
    readonly List<string> outgoing = [.. SampleData.OutgoingRequests];
    string handle = "";
    string? message;
    bool messageIsError;

    string Activity(FriendInfo f) => f.Activity switch
    {
        FriendActivity.InHunt => L["Friends.InHunt", f.Reserve ?? ""],
        FriendActivity.InLauncher => L["Friends.InLauncher"],
        _ => f.LastSeenDays switch
        {
            0 => L["Friends.SeenToday"],
            1 => L["Friends.SeenYesterday"],
            var d => L["Friends.SeenDaysAgo", d],
        },
    };

    void Accept(string h)
    {
        incoming.Remove(h);
        friends.Add(new(h, FriendActivity.Offline));
    }

    void Add()
    {
        var h = handle.Trim();
        // handles are letters, digits and underscores only
        if (h.Length is 0 or > 32 || !h.All(c => char.IsAsciiLetterOrDigit(c) || c == '_')) { Say(L["Friends.Invalid"], true); return; }
        if (friends.Any(f => f.Handle.Equals(h, StringComparison.OrdinalIgnoreCase)) || incoming.Contains(h, StringComparer.OrdinalIgnoreCase) || outgoing.Contains(h, StringComparer.OrdinalIgnoreCase))
        {
            Say(L["Friends.Duplicate", h], true);
            return;
        }
        outgoing.Add(h);
        handle = "";
        Say(L["Friends.Sent", h], false);
    }

    void Say(string text, bool isError) => (message, messageIsError) = (text, isError);
}
