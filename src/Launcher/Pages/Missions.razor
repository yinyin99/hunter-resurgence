@page "/missions"

<PageHeader Title="@L["Nav.Missions"]" Lead="@L["Missions.Lead"]" />

<section aria-labelledby="daily-title">
    <h2 id="daily-title" class="section-title">@L["Missions.Daily"]</h2>
    @if (SampleData.DailyMissions.Count == 0)
    {
        <p class="empty">@L["Missions.NoneDaily"]</p>
    }
    else
    {
        <div class="grid wide">
            @foreach (var m in SampleData.DailyMissions)
            {
                <article class="card stack">
                    <div class="row between">
                        <h3>@m.Title</h3>
                        @Status(m.Progress >= m.Goal, m.Title)
                    </div>
                    <p class="muted">@m.Description</p>
                    @Bar(m.Title, m.Progress, m.Goal)
                    @Reward(m.Credits, m.Item)
                    @Claim(m.Progress >= m.Goal, m.Title)
                </article>
            }
        </div>
    }
</section>

<section class="section" aria-labelledby="chains-title">
    <h2 id="chains-title" class="section-title">@L["Missions.Chains"]</h2>
    @if (SampleData.MissionChains.Count == 0)
    {
        <p class="empty">@L["Missions.NoneChains"]</p>
    }
    else
    {
        <div class="stack">
            @foreach (var c in SampleData.MissionChains)
            {
                var done = c.Current >= c.Steps.Count;
                <article class="card stack">
                    <div class="row between">
                        <h3>@c.Title</h3>
                        @Status(done, c.Title)
                    </div>
                    <p class="muted">@c.Description</p>
                    <ol class="stepper">
                        @for (var i = 0; i < c.Steps.Count; i++)
                        {
                            <li class="step @(i < c.Current ? "done" : i == c.Current ? "current" : null)" aria-current="@(i == c.Current ? "step" : null)">@c.Steps[i]</li>
                        }
                    </ol>
                    @Bar(c.Title, c.Current, c.Steps.Count)
                    @Reward(c.Credits, c.Item)
                    @Claim(done, c.Title)
                </article>
            }
        </div>
    }
</section>

@code {
    readonly HashSet<string> claimed =
        [.. SampleData.DailyMissions.Where(m => m.Claimed).Select(m => m.Title), .. SampleData.MissionChains.Where(c => c.Claimed).Select(c => c.Title)];

    RenderFragment Status(bool done, string title) => @<text>
        @if (claimed.Contains(title)) { <span class="badge">@L["Missions.Claimed"]</span> }
        else if (done) { <span class="badge ok">@L["Missions.Completed"]</span> }
    </text>;

    RenderFragment Bar(string title, int value, int max) => @<div class="row">
        <div class="progress @(value >= max ? "done" : null) bar" role="progressbar" aria-label="@title" aria-valuemin="0" aria-valuemax="@max" aria-valuenow="@value">
            <div class="progress-bar" style="width:@(100 * Math.Min(value, max) / max)%"></div>
        </div>
        <span class="muted mono">@value / @max</span>
    </div>;

    RenderFragment Reward(int credits, string? item) => @<p class="reward">
        <span class="muted">@L["Missions.Reward"]</span>
        <strong>@L["Launcher.Credits", credits]</strong>
        @if (item is not null) { <text> + <strong>@item</strong></text> }
    </p>;

    RenderFragment Claim(bool done, string title) => @<text>
        @if (done && !claimed.Contains(title))
        {
            <div><button type="button" class="btn btn-sm" @onclick="() => claimed.Add(title)">@L["Missions.Claim"]</button></div>
        }
    </text>;
}
