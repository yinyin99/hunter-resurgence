@page "/settings/game"
@using Resurgence.Launcher.Components
@inject LauncherEnv Env

<PageHeader Title="@L["Nav.GameSettings"]" Lead="@L["GameSettings.Lead"]" />

@if (running)
{
    <p role="alert"><span class="badge warn">@L["GameSettings.ClientRunning"]</span></p>
}

<div class="tabs" role="tablist" aria-label="@L["GameSettings.Tabs"]">
    @for (var i = 0; i < TabNames.Length; i++)
    {
        var t = i;
        <button type="button" role="tab" id="gs-tab-@t" class="tab @(tab == t ? "active" : "")"
                aria-selected="@(tab == t ? "true" : "false")" aria-controls="gs-panel"
                @onclick="() => tab = t">@L[$"GameSettings.Tab.{TabNames[t]}"]</button>
    }
</div>

<div id="gs-panel" role="tabpanel" aria-labelledby="gs-tab-@tab">
    @if (tab == 0 && gfx is null)
    {
        <p class="empty">@ProblemText(gfxProblem)</p>
    }
    else if (tab != 0 && opt is null)
    {
        <p class="empty">@ProblemText(optProblem)</p>
    }
    else if (tab == 0)
    {
        <SettingsSelect Label="@L["GameSettings.Preset"]" Hint="@L["GameSettings.Preset.Hint"]"
                        Options="@(PresetIndex == Custom ? Opts(PresetNames) : Opts(PresetNames[..Custom]))"
                        Value="@PresetIndex" ValueChanged="SetPreset" />
        <SettingsSwitch Label="@L["GameSettings.Fullscreen"]" @bind-Value="gfx!.Fullscreen" />
        <SettingsSwitch Label="@L["GameSettings.Vsync"]" @bind-Value="gfx!.Vsync" />
        <SettingsSelect Label="@L["GameSettings.Resolution"]" Options="@(resolutions.Select(r => L["GameSettings.ResolutionFormat", r.W, r.H, r.Hz].Value).ToList())"
                        Value="@ResolutionIndex" ValueChanged="SetResolution" />
        <SettingsSelect Label="@L["GameSettings.Scene"]" Hint="@L["GameSettings.Scene.Hint"]" Options="@Opts(Levels4)" @bind-Value="gfx!.Scene" />
        <SettingsSelect Label="@L["GameSettings.Texture"]" Hint="@L["GameSettings.Texture.Hint"]" Options="@Opts(Levels3)" @bind-Value="gfx!.Texture" />
        <SettingsSelect Label="@L["GameSettings.Shadow"]" Options="@Opts(Levels4)" @bind-Value="gfx!.Shadow" />
        <SettingsSelect Label="@L["GameSettings.Msaa"]" Options="@Opts(Msaa)" @bind-Value="gfx!.Msaa" />
        <SettingsSelect Label="@L["GameSettings.Aniso"]" Options="@Opts(Aniso)" @bind-Value="gfx!.Aniso" />
        @if (opt?.Has(ScopeKey) == true)
        {
            <SettingsSelect Label="@L["GameSettings.Scope"]" Options="@Opts(Scope)" Value="@opt!.Get(ScopeKey)" ValueChanged="SetScope" />
        }
    }
    else if (tab == 1)
    {
        @Slider("MasterVolume", "GameSettings.MasterVolume")
    }
    else if (tab == 2)
    {
        @Toggle("InvertedMouse", "GameSettings.InvertMouse")
        @Slider("LookSpeed", "GameSettings.LookSpeed")
        @Slider("AimSpeed", "GameSettings.AimSpeed")
        @Slider("BinocularSpeed", "GameSettings.BinocularSpeed")
        @Toggle("UseGamepad", "GameSettings.Gamepad")
    }
    else
    {
        @Slider("Gamma", "GameSettings.Gamma")
        @Toggle("ShowPlayerNames", "GameSettings.PlayerNames")
        @Toggle("ShowStatusBar", "GameSettings.StatusBar")
        @Toggle("ShowPlayerSpotting", "GameSettings.PlayerSpotting")
        @Toggle("ShowAnimalSpotting", "GameSettings.AnimalSpotting")
        @Toggle("ShowChat", "GameSettings.Chat")
        @Toggle("ShowMapPopups", "GameSettings.MapPopups")
        @Toggle("ContextualHelp", "GameSettings.ContextHelp")
        @Toggle("AutoReload", "GameSettings.AutoReload")
        @Toggle("ShowGlassesShader", "GameSettings.GlassesShader")
    }
</div>

<div class="actions row">
    <button type="button" class="btn" disabled="@(gfx is null && opt is null)" @onclick="Save">@L["Common.Save"]</button>
    <button type="button" class="btn btn-secondary" @onclick="Undo">@L["GameSettings.Reset"]</button>
    <span class="muted" role="status">@message</span>
</div>

@code {
    private static readonly string[] TabNames = ["Graphics", "Audio", "Controls", "Interface"];
    // option names; display text is the key GameSettings.Opt.{name}
    private static readonly string[] PresetNames = ["Low", "Medium", "High", "Ultra", "Custom"];
    private static readonly string[] Levels3 = ["Low", "Medium", "High"];
    private static readonly string[] Levels4 = ["Low", "Medium", "High", "VeryHigh"];
    private static readonly string[] Msaa = ["Off", "X2", "X4", "X8"];
    private static readonly string[] Aniso = ["Default", "Off", "X2", "X4", "X8", "X16"];
    private static readonly string[] Scope = ["High", "Low"];

    // presets set only: scene, texture, shadow, msaa, aniso, vsync (never resolution or fullscreen)
    private static readonly int[][] Presets =
    [
        [0, 0, 0, 0, 1, 0], // Low
        [1, 1, 1, 1, 3, 1], // Medium
        [2, 2, 2, 2, 4, 1], // High
        [3, 2, 3, 3, 5, 1], // Ultra
    ];
    private const int Custom = 4;

    private GraphicsSettings? gfx, gfxSaved;
    private OptionsSettings? opt, optSaved;
    private FileProblem gfxProblem, optProblem;
    private List<(int W, int H, int Hz)> resolutions = [];
    private const string ScopeKey = "ScopeQuality";
    private int tab;
    private bool running;
    private string? message;

    private string? GfxPath => Env.Settings.GraphicsFile is { } f ? Path.Combine(GameFiles.AppData, f) : null;
    private string? OptPath => Env.Settings.OptionsFile is { } f && Env.Settings.OptionsKeyPrefix is not null ? Path.Combine(GameFiles.AppData, f) : null;

    protected override void OnInitialized() => Load();

    private void Load()
    {
        (gfx, gfxProblem) = GfxPath is { } gp ? GameFiles.ReadGraphics(gp) : (null, FileProblem.NotConfigured);
        (opt, optProblem) = OptPath is { } op ? GameFiles.ReadOptions(op, Env.Settings.OptionsKeyPrefix!) : (null, FileProblem.NotConfigured);
        gfxSaved = gfx is null ? null : gfx with { };
        optSaved = opt?.Clone();
        resolutions = [.. GameFiles.DisplayModes()];
        if (gfx is not null && !resolutions.Contains((gfx.Width, gfx.Height, gfx.Hz)))
        {
            resolutions.Add((gfx.Width, gfx.Height, gfx.Hz));
            resolutions.Sort();
        }
        running = GameFiles.ClientRunning(Env.Settings.ClientExe);
    }

    private LocalizedString ProblemText(FileProblem p) => L[p switch
    {
        FileProblem.NotConfigured => "GameSettings.NotConfigured",
        FileProblem.BadFormat => "GameSettings.BadFormat",
        _ => "GameSettings.Missing",
    }];

    private RenderFragment Slider(string key, string label)
    {
        var o = opt!;
        return o.Has(key) ? @<SettingsSlider Label="@L[label]" Value="@o.Get(key)" ValueChanged="v => o.Set(key, v)" /> : @<text></text>;
    }

    private RenderFragment Toggle(string key, string label)
    {
        var o = opt!;
        return o.Has(key) ? @<SettingsSwitch Label="@L[label]" Value="@(o.Get(key) != 0)" ValueChanged="v => o.Set(key, v ? 1 : 0)" /> : @<text></text>;
    }

    private string[] Opts(string[] names) => names.Select(n => L[$"GameSettings.Opt.{n}"].Value).ToArray();

    private int[] Quality => [gfx!.Scene, gfx.Texture, gfx.Shadow, gfx.Msaa, gfx.Aniso, gfx.Vsync ? 1 : 0];

    // the preset is derived: any edit that no longer matches a preset reads as Custom
    private int PresetIndex
    {
        get
        {
            var i = Array.FindIndex(Presets, p => p.SequenceEqual(Quality));
            return i < 0 ? Custom : i;
        }
    }

    private void SetPreset(int i)
    {
        if (i >= Custom) return;
        var p = Presets[i];
        (gfx!.Scene, gfx.Texture, gfx.Shadow, gfx.Msaa, gfx.Aniso, gfx.Vsync) = (p[0], p[1], p[2], p[3], p[4], p[5] == 1);
    }

    private void SetScope(int v) => opt!.Set(ScopeKey, v);

    private int ResolutionIndex => resolutions.IndexOf((gfx!.Width, gfx.Height, gfx.Hz));

    private void SetResolution(int i) => (gfx!.Width, gfx.Height, gfx.Hz) = resolutions[i];

    private void Say(string key, params object[] args) => message = L[key, args];

    private void Save()
    {
        // the client reads the files once at start and rewrites them itself: never touch them while it runs
        running = GameFiles.ClientRunning(Env.Settings.ClientExe);
        if (running) { Say("GameSettings.ClientRunning"); return; }
        try
        {
            var wrote = false;
            if (gfx is not null && GfxPath is { } gp && gfx != gfxSaved)
            {
                GameFiles.WriteGraphics(gp, gfx);
                gfxSaved = gfx with { };
                wrote = true;
            }
            if (opt is not null && OptPath is { } op && !opt.SameAs(optSaved!))
            {
                GameFiles.WriteOptions(op, Env.Settings.OptionsKeyPrefix!, opt);
                optSaved = opt.Clone();
                wrote = true;
            }
            Say(wrote ? "GameSettings.Saved" : "GameSettings.NothingToSave");
        }
        catch (InvalidDataException) { Say("GameSettings.BadFormat"); }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException) { Say("GameSettings.SaveFailed", e.Message); }
    }

    // back to what the files hold now
    private void Undo()
    {
        message = null;
        Load();
    }
}
