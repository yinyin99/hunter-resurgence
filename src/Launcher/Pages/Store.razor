@page "/store"
@inject LauncherState State

<PageHeader Title="@L["Nav.Store"]" Lead="@L["Store.Lead"]" />

<p class="row">
    <span class="muted">@L["Store.Balance"]</span>
    <strong class="balance">@L["Launcher.Credits", State.Wallet]</strong>
</p>

<div class="tabs" role="group" aria-label="@L["Store.Categories"]">
    @foreach (var c in SampleData.StoreCategories)
    {
        var id = c;
        <button type="button" class="tab @(category == id ? "active" : null)" aria-pressed="@(category == id ? "true" : "false")" @onclick="() => category = id">@L[$"Store.Cat.{id}"]</button>
    }
</div>

<p class="visually-hidden" role="status">@bought</p>

@if (!items.Any())
{
    <p class="empty">@L["Store.NoItems"]</p>
}
else
{
    <div class="grid">
        @foreach (var item in items)
        {
            var owned = State.OwnedItems.Contains(item.Name);
            var affordable = item.Price <= State.Wallet;
            <article class="card item">
                <div class="art" aria-hidden="true">@item.Name[0]</div>
                <div class="row">
                    <h3>@item.Name</h3>
                    @if (owned) { <span class="badge ok">@L["Store.Owned"]</span> }
                </div>
                <p class="muted">@item.Description</p>
                <div class="row buy">
                    <strong class="price">@L["Launcher.Credits", item.Price]</strong>
                    <span class="spacer"></span>
                    @if (!owned && !affordable) { <span class="hint">@L["Store.CannotAfford"]</span> }
                    <button type="button" class="btn btn-sm" disabled="@(owned || !affordable)" @onclick="() => pending = item">@L["Store.Buy"]</button>
                </div>
            </article>
        }
    </div>
}

<Dialog Open="pending is not null" Title="@L["Store.ConfirmTitle"]" OnClose="() => pending = null">
    <ChildContent>
    @if (pending is { } p)
    {
        <dl class="summary">
            <dt>@L["Store.Item"]</dt><dd>@p.Name</dd>
            <dt>@L["Store.Price"]</dt><dd class="mono">@L["Launcher.Credits", p.Price]</dd>
            <dt>@L["Store.BalanceAfter"]</dt><dd class="mono">@L["Launcher.Credits", State.Wallet - p.Price]</dd>
        </dl>
    }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => pending = null">@L["Common.Cancel"]</button>
        <button type="button" class="btn" @onclick="Confirm">@L["Common.Confirm"]</button>
    </Footer>
</Dialog>

@code {
    string category = SampleData.StoreCategories[0];
    StoreItem? pending;
    string? bought;

    IEnumerable<StoreItem> items => SampleData.StoreItems.Where(i => i.Category == category);

    void Confirm()
    {
        if (pending is null) return;
        State.Buy(pending);
        bought = L["Store.Bought", pending.Name];
        pending = null;
    }
}
