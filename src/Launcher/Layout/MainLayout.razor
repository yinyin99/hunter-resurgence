@inherits LayoutComponentBase
@using Resurgence.Launcher.Components

<CascadingValue Name="Me" Value="@SampleData.Me.Handle">
    <Shell Handle="@SampleData.Me.Handle">
        <Top>
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">@L["Nav.Play"]</NavLink>
            <NavLink class="nav-link" href="/store">@L["Nav.Store"]</NavLink>
            <NavLink class="nav-link" href="/missions">@L["Nav.Missions"]</NavLink>
            <NavLink class="nav-link" href="/friends">@L["Nav.Friends"]</NavLink>
        </Top>
        <Bottom>
            <NavLink class="nav-link" href="/restore">@L["Nav.Restore"]</NavLink>
            <NavLink class="nav-link" href="/settings/game">@L["Nav.GameSettings"]</NavLink>
            <NavLink class="nav-link" href="/settings/app">@L["Nav.AppSettings"]</NavLink>
        </Bottom>
        <StatusBar><StatusStrip /></StatusBar>
        <ChildContent>@Body</ChildContent>
    </Shell>
</CascadingValue>
