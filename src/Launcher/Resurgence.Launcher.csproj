<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the versioned TFM adds the Windows SDK projection that the WebView2 WPF control loads at startup -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <!-- must not collide with any exe of the game -->
    <AssemblyName>resurgence-launcher</AssemblyName>
    <RootNamespace>Resurgence.Launcher</RootNamespace>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
    <Version>0.0.0-dev</Version>
    <!-- our own Main (Program.cs) runs Velopack's hooks before WPF starts -->
    <StartupObject>Resurgence.Launcher.Program</StartupObject>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- also set by the publish profile; here too so a build and a publish restore the same packages (the single-file setting adds the ILLink tasks) -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ui\Resurgence.Ui.csproj" />
    <ProjectReference Include="..\Restore\Resurgence.Restore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- the WPF SDK drops System.IO from the implicit usings -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- the player kit's forwarder is a Kestrel server inside the launcher -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- placeholders only; build output only; a real settings.json is never committed (git-ignored) -->
    <None Include="settings.example.json" Link="settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Resurgence.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF writes the UI thread's culture back after every dispatcher operation, which pins the culture of the start;
         without that, a language chosen later (the process default culture) shows after the page reloads -->
    <RuntimeHostConfigurationOption Include="Switch.MS.Internal.DoNotUseCulturePreservingDispatcherOperations" Value="true" />
  </ItemGroup>

</Project>
