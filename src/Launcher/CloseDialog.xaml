<Window x:Class="Resurgence.Launcher.CloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#444" Foreground="#EEE"
        FontFamily="Roboto, Segoe UI" FontSize="16" FocusManager.FocusedElement="{Binding ElementName=No}">
    <Window.Resources>
        <!-- the launcher's buttons (theme.css .btn): 4 px corners, a light veil on hover, half faded when disabled -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" x:Name="Bd">
                                <Grid>
                                    <Border x:Name="Veil" Background="White" Opacity="0" CornerRadius="3" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.12" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#BBB" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel>
        <TextBlock x:Name="Question" Padding="20,30" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" />
        <Border BorderBrush="#4E4C50" BorderThickness="0,2,0,0" Background="#444" Padding="14,12,20,11">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Yes" Style="{StaticResource Btn}" Background="#2A2A2A" IsEnabled="False" Click="OnYes" />
                <Button x:Name="No" Style="{StaticResource Btn}" Background="#F9370D" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
