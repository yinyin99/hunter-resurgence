<Project Sdk="Microsoft.NET.Sdk">

  <!-- stand-in for the server's "import backup" verb: remove when the server project exists -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>restore</AssemblyName>
    <RootNamespace>Resurgence.Restore.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resurgence.Restore.csproj" />
  </ItemGroup>

</Project>
