@page "/sign-in"

<PageTitle>@L["Nav.SignIn"] - @L["App.Name"]</PageTitle>

@* UI only: the posted values are never stored or sent anywhere. *@
<div class="card stack signin">
    <h1>@L["SignIn.Title"]</h1>
    <ol class="stepper">
        <li class="step @(step == 1 ? "current" : "done")">@L["SignIn.StepEmail"]</li>
        <li class="step @(step == 2 ? "current" : step == 3 ? "done" : null)">@L["SignIn.StepCode"]</li>
    </ol>

    @if (step == 1)
    {
        <form method="post" @formname="signin-email" @onsubmit="SendCode" class="stack">
            <AntiforgeryToken />
            <p class="muted">@L["SignIn.EmailLead"]</p>
            <div class="field">
                <label for="email">@L["SignIn.Email"]</label>
                <input id="email" name="Email" type="email" class="input" autocomplete="email" value="@Email" aria-invalid="@(error is null ? null : "true")" />
            </div>
            @if (error is not null) { <p class="error" role="alert">@error</p> }
            <button type="submit" class="btn">@L["SignIn.SendCode"]</button>
        </form>
    }
    else if (step == 2)
    {
        <form method="post" @formname="signin-code" @onsubmit="Verify" class="stack">
            <AntiforgeryToken />
            <input type="hidden" name="CodeEmail" value="@CodeEmail" />
            <p class="muted">@L["SignIn.CodeSent", CodeEmail!.Trim()]</p>
            <div class="field">
                <label for="code">@L["SignIn.Code"]</label>
                <input id="code" name="Code" class="input mono" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" aria-invalid="@(error is null ? null : "true")" />
            </div>
            @if (error is not null) { <p class="error" role="alert">@error</p> }
            <button type="submit" class="btn">@L["Nav.SignIn"]</button>
            <a href="/sign-in">@L["SignIn.UseAnotherEmail"]</a>
        </form>
    }
    else
    {
        <p role="status">@L["SignIn.Web.Notice"]</p>
    }

    <p class="hint">@L["SignIn.SteamNote"]</p>
</div>

@code {
    [SupplyParameterFromForm(FormName = "signin-email")] public string? Email { get; set; }
    [SupplyParameterFromForm(FormName = "signin-code")] public string? CodeEmail { get; set; }
    [SupplyParameterFromForm(FormName = "signin-code")] public string? Code { get; set; }

    int step = 1;
    LocalizedString? error;

    // a posted form must exist when the page first renders, so the code form is already there when a code is posted
    protected override void OnInitialized()
    {
        if (CodeEmail is not null) step = 2;
    }

    void SendCode()
    {
        if (Email is not null && Email.Trim().Contains('@')) { step = 2; CodeEmail = Email; }
        else error = L["SignIn.EmailInvalid"];
    }

    void Verify()
    {
        if (Code is not null && Code.Length == 6 && Code.All(char.IsAsciiDigit)) step = 3;
        else error = L["SignIn.CodeInvalid"];
    }
}
