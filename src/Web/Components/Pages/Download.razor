@page "/download"

<PageHeader Title="@L["Nav.Download"]" Lead="@L["Download.Lead"]" />

<section class="card stack">
    <h2>@L["Download.CardName"]</h2>
    <p class="muted">@L["Download.Platform"]</p>
    <p>@L["Download.Requires"]</p>
    <div class="row">
        <button type="button" class="btn btn-lg" disabled>@L["Download.NotReleased"]</button>
    </div>
</section>

<section class="section">
    <h2>@L["Download.Steam.Title"]</h2>
    <ol class="steps">
        <li>@L["Download.Steam.Install"]</li>
        <li>@L["Download.Steam.Properties"]</li>
        <li>
            @L["Download.Steam.Paste"]
            <pre><code>"C:\path\to\resurgence-launcher.exe" %command%</code></pre>
        </li>
        <li>@L["Download.Steam.Play"]</li>
    </ol>
    <p class="muted">@L["Download.Steam.Untouched"]</p>
</section>

<section class="card stack">
    <h2>@L["Download.Backup.Title"]</h2>
    <p>@L["Download.Backup.Text"]</p>
    <p><a class="btn btn-secondary" href="https://github.com/yinyin99/hunter-resurgence/releases/latest" rel="noopener">@L["Download.Backup.Link"]</a></p>
</section>
