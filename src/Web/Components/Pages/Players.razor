@page "/players"

<PageHeader Title="@L["Nav.Players"]" Lead="@L["Players.Lead"]" />

<form method="get" class="toolbar">
    <div class="field">
        <label for="q">@L["Players.SearchLabel"]</label>
        <input id="q" name="q" class="input" value="@Q" autocomplete="off" />
    </div>
    <button type="submit" class="btn">@L["Players.Search"]</button>
</form>

@if (string.IsNullOrWhiteSpace(Q))
{
    <p class="empty">@L["Players.Prompt"]</p>
}
else if (results.Count == 0)
{
    <p class="empty">@L["Players.NoMatch", Q.Trim()]</p>
}
else
{
    <p class="muted" role="status">@L["Players.Found", results.Count]</p>
    <ul class="grid wide results">
        @foreach (var p in results)
        {
            <li class="card">
                <a class="person" href="/players/@p.Handle">
                    <Avatar Handle="@p.Handle" />
                    <span class="who">
                        <strong>@p.Handle</strong>
                        <span class="muted">@L["Players.MemberSince", p.MemberSince.ToString("y")] &middot; @L[p.Trophies == 1 ? "Players.TrophyCount.One" : "Players.TrophyCount", p.Trophies]</span>
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    IReadOnlyList<PlayerProfile> results = [];

    protected override void OnParametersSet() =>
        results = string.IsNullOrWhiteSpace(Q)
            ? []
            : SampleData.Players.Where(p => p.Handle.Contains(Q.Trim(), StringComparison.OrdinalIgnoreCase)).OrderBy(p => p.Handle).ToList();
}
