@page "/"

<PageTitle>@L["App.Name"]</PageTitle>

<section class="hero">
    <p class="mark">Hunter <span>Resurgence</span></p>
    <h1>@L["Home.Pitch"]</h1>
    <div class="row">
        <a class="btn btn-lg" href="/download">@L["Home.Cta"]</a>
        <form method="get" action="/players" class="find row">
            <label for="hero-q" class="visually-hidden">@L["Players.SearchLabel"]</label>
            <input id="hero-q" name="q" class="input" placeholder="@L["Players.SearchLabel"]" autocomplete="off" />
            <button type="submit" class="btn btn-secondary">@L["Home.FindPlayer"]</button>
        </form>
    </div>
</section>

<div class="two-col">
    <section>
        <h2 class="section-title"><span>@L["Home.TopHunters"]</span><a href="/leaderboards">@L["Players.ViewAll"]</a></h2>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th scope="col">@L["Leaderboards.Rank"]</th>
                        <th scope="col">@L["Leaderboards.Hunter"]</th>
                        <th scope="col" class="num">@L["Leaderboards.Score"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < top.Count; i++)
                    {
                        <tr class="top-@(i + 1)">
                            <td class="rank mono">@(i + 1)</td>
                            <td><a href="/players/@top[i].Handle">@top[i].Handle</a></td>
                            <td class="num mono">@top[i].Score.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section>
        <h2 class="section-title"><span>@L["Home.Servers"]</span><span class="muted">@L["Home.ServersOnline", servers.Count(s => s.Status != ServerStatus.Offline), servers.Count]</span></h2>
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th scope="col">@L["Home.ServerName"]</th>
                        <th scope="col">@L["Home.ServerRegion"]</th>
                        <th scope="col">@L["Home.ServerStatus"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in servers)
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td class="muted">@s.Region</td>
                            <td><ServerStatusLabel Status="s.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<section class="section">
    <h2 class="section-title"><span>@L["Home.LatestNews"]</span></h2>
    <div class="grid wide">
        @foreach (var n in SampleData.News.Take(3))
        {
            <article class="card">
                <p class="muted date">@n.Date.ToString("d MMMM yyyy")</p>
                <h3>@n.Title</h3>
                <p>@n.Excerpt</p>
            </article>
        }
    </div>
</section>

@code {
    readonly IReadOnlyList<LeaderboardRow> top = SampleData.Leaderboard(null, null, SampleData.Seasons[0]).Take(5).ToList();
    readonly IReadOnlyList<ServerInfo> servers = SampleData.Servers;
}
