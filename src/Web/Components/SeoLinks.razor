@implements IDisposable
@inject NavigationManager Nav
@* one URL per page and language, and its other languages (docs/website.md#search-engines); none once a page says it does not exist
   (a profile's Nav.NotFound renders the not-found page in place), nor on the not-found page itself *@
@if (!notFound && !Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').Equals("not-found", StringComparison.OrdinalIgnoreCase))
{
    var uri = new Uri(Nav.Uri);
    <HeadContent>
        <link rel="canonical" href="@Seo.Url(uri, Languages.Match(System.Globalization.CultureInfo.CurrentUICulture.Name)?.Code ?? "en")" />
        @foreach (var l in Languages.All) { <link rel="alternate" hreflang="@l.Code" href="@Seo.Url(uri, l.Code)" /> }
        <link rel="alternate" hreflang="x-default" href="@Seo.Url(uri, "en")" />
    </HeadContent>
}

@code {
    bool notFound;

    /// <summary>The page shown: a new one renders the links again after an in-app navigation.</summary>
    [Parameter] public RouteData? Route { get; set; }

    protected override void OnInitialized() { Nav.OnNotFound += NotFound; Nav.LocationChanged += Moved; }
    void NotFound(object? sender, NotFoundEventArgs e) { notFound = true; _ = InvokeAsync(StateHasChanged); }
    void Moved(object? sender, LocationChangedEventArgs e) => notFound = false;
    public void Dispose() { Nav.OnNotFound -= NotFound; Nav.LocationChanged -= Moved; }
}
