@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject HostMode Mode
@inject IConfiguration Config
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["Resurgence.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Resurgence.Ui/theme.css"]" />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="48x48" />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="icon" href="@Assets["favicon-32.png"]" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes Launcher="Mode.Launcher" Dev="Mode.Dev" Mock="@Mode.Mock" Cookie="@cookie" Host="@host" @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] HttpContext? Http { get; set; }
    string? cookie, host;

    /// <summary>With SERVER_URL the request's session cookie and host go to the circuit as Routes parameters (the page marker is protected, the browser cannot read it): HttpContext is not reliable once the circuit runs.</summary>
    protected override void OnInitialized()
    {
        if (Http is not null && Config["SERVER_URL"] is { Length: > 0 }) (cookie, host) = (Http.Request.Cookies[ServerSessionApi.Cookie], Http.Request.Host.Value);
    }
}
