@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject HostMode Mode
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["Resurgence.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Resurgence.Ui/theme.css"]" />
    <link rel="icon" href="@Assets["favicon.ico"]" sizes="48x48" />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="icon" href="@Assets["favicon-32.png"]" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes Launcher="Mode.Launcher" Dev="Mode.Dev" Mock="@Mode.Mock" @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
