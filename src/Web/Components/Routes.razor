@inject HostMode Mode

<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(Strings).Assembly }"
        NotFoundPage="typeof(Resurgence.Ui.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Resurgence.Ui.Layouts.ShellLayout)" />
    </Found>
</Router>

@code {
    /// <summary>The launcher flag decided by the request (development ?mode=) reaches the interactive circuit as a parameter.</summary>
    [Parameter] public bool Launcher { get; set; }
    [Parameter] public bool Dev { get; set; }

    protected override void OnParametersSet() => (Mode.Launcher, Mode.Dev) = (Launcher, Dev);
}
