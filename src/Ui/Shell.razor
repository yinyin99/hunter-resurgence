<div class="shell">
    <aside class="sidebar">
        <a class="wordmark" href="/">Hunter <span>Resurgence</span></a>
        <nav aria-label="@L["Nav.Main"]">
            <div class="nav-section">@Top</div>
            @if (!string.IsNullOrEmpty(Handle))
            {
                <div class="nav-section">
                    <NavLink class="nav-link" href="@($"/players/{Handle}")" Match="NavLinkMatch.All">@L["Nav.Profile"]</NavLink>
                    <NavLink class="nav-link" href="@($"/players/{Handle}/trophies")">@L["Nav.Trophies"]</NavLink>
                    <NavLink class="nav-link" href="@($"/players/{Handle}/hunts")">@L["Nav.Hunts"]</NavLink>
                    <NavLink class="nav-link" href="/leaderboards">@L["Nav.Leaderboards"]</NavLink>
                </div>
            }
            <div class="nav-section">@Bottom</div>
        </nav>
    </aside>
    <div class="main-col">
        @StatusBar
        <main class="content">@ChildContent</main>
    </div>
</div>

@code {
    /// <summary>Signed-in handle. When set, the shared Profile, Trophies, Hunt history and Leaderboards links appear; the website passes none and lists its own links in Top.</summary>
    [Parameter] public string? Handle { get; set; }
    /// <summary>Host-specific links above the shared ones.</summary>
    [Parameter] public RenderFragment? Top { get; set; }
    /// <summary>Host-specific links below the shared ones.</summary>
    [Parameter] public RenderFragment? Bottom { get; set; }
    /// <summary>Optional strip above the page content (launcher: player, wallet, server).</summary>
    [Parameter] public RenderFragment? StatusBar { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
