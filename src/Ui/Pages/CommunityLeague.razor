@page "/community-league"
@page "/community_league"
@inject ICompetitionsService Service
@inject ModalService Modal

<PageTitle>@L["Comp.Tab.League"]</PageTitle>

<div class="page-min">
<Tabs Items="main" Active="/community-league" />
<h2 class="page-title">@L["League.Title"]</h2>
<div class="intro">
    <p>@L["League.P1"]</p>
    <p>@L["League.P2"]</p>
    <p>@L["League.P3"]</p>
    <p>@L["League.P4"]</p>
    <p>@L["League.P5"]</p>
    <p>@L["League.P6"]</p>
</div>

<h4 class="enrolled">@L["Comp.Enrolled"] (@enrolled.Count)</h4>
<CompetitionTable Enrolled="enrolled" OnLeave="Leave" Details="/community-league/" />
@if (enrolled.Count == 0) { <p class="notice">@L["League.NotEnrolled"]</p> }

<CompetitionTable Rows="rows" Details="/community-league/" OnJoin="Join" OnLeave="Leave" />
@foreach (var (title, board) in boards)
{
    <h4 class="part">@L[title]</h4>
    <table class="board tbl">
        <thead><tr><th>@L["Board.Rank"]</th><th>@L["Board.Hunter"]</th><th>@L["League.Points"]</th></tr></thead>
        <tbody>@foreach (var r in board) { <tr><td>@r.Rank</td><td><a href="/profile/@r.Handle">@r.Handle</a></td><td>@r.Value</td></tr> }</tbody>
    </table>
}
</div>

@code {
    IReadOnlyList<Enrolled> enrolled = [];
    IReadOnlyList<Competition> rows = [];
    IReadOnlyList<(string, IReadOnlyList<Ranked>)> boards = [];
    IReadOnlyList<(string, string)> main = [];

    protected override async Task OnInitializedAsync()
    {
        main = [(L["Comp.Tab.Competitions"], "/competitions"), (L["Comp.Tab.League"], "/community-league")];
        boards = [("League.Monthly", await Service.LeagueBoardAsync(false)), ("League.Season", await Service.LeagueBoardAsync(true))];
        await Load();
    }

    async Task Load()
    {
        enrolled = await Service.LeagueEnrolledAsync();
        rows = await Service.LeagueAsync();
    }

    // the lists are read again after the change
    async Task Join(int id) => await Change(await Service.JoinAsync(id));

    async Task Leave(int id) => await Change(await Service.LeaveAsync(id));

    async Task Change(Result r)
    {
        if (!r.Ok) Modal.Alert(L[r.Error ?? "Comp.Failed"]);
        else await Load();
    }
}
