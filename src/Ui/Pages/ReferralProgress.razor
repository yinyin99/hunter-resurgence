@page "/referral"
@page "/join/{Code}"
@inject IReferralService Service
@inject ISessionService Sessions
@inject NavigationManager Nav

<PageTitle>@L["Referral.Title"]</PageTitle>

@* /referral: three summary cards (the player's code and invitation link, the qualified recruits, the Discord links), the form for a friend's code, the recruits' progress and the reward levels as ladders.
   /join/<code> is the invitation link: signed in it is this page with the code filled in, signed out it goes to the sign-in (the server brings the player back to this address) *@
<div class="page-min wide-main">
    <h2 class="page-title">@L["Referral.Title"]</h2>
    @if (!loaded) { }
    else if (signedOut)
    {
        @if (Code is not null) { <p class="note">@L["Referral.JoinSignIn", Code]</p> }
        <SignInRequired />
    }
    else if (data is null)
    {
        <p class="error" role="alert">@L["Referral.LoadFailed"]</p>
        <button type="button" class="btn btn-inverse" @onclick="Load">@L["Board.Retry"]</button>
    }
    else
    {
        var nextTier = data.Tiers.FirstOrDefault(t => !t.Reached);
        var nextMilestone = data.Discord.Milestones.FirstOrDefault(t => !t.Reached);
        var tierNote = nextTier is not null ? L["Referral.NextAt", nextTier.Recruits].Value : data.Tiers.Length > 0 ? L["Referral.TierAll"].Value : null;
        var discordNote = nextMilestone is not null ? L["Referral.NextAt", nextMilestone.Recruits].Value : data.Discord.Milestones.Length > 0 ? L["Referral.DiscordAll"].Value : null;
        <div class="cards">
            <section class="panel card share">
                <ReferralCopy Id="referral-code" Label="@L["Referral.Code"].Value" Value="@data.Code" />
                <ReferralCopy Value="@data.Link" Text="@L["Referral.CopyLink"].Value" />
                <p class="note">@L["Referral.Share"]</p>
            </section>
            <section class="panel card stat">
                <p class="label">@L["Referral.TierHead"]</p>
                <p class="big">@data.QualifiedCount</p>
                @if (nextTier is not null) { <ReferralBar Percent="ReferralBar.Of(data.CountedCount, nextTier.Recruits)" Label="@L["Referral.TierHead"].Value" Text="@tierNote" /> }
                @if (tierNote is not null) { <p class="note">@tierNote</p> }
            </section>
            <section class="panel card stat">
                <p class="label">@L["Referral.DiscordHead"]</p>
                <p class="big">@data.Discord.LinkedCount</p>
                @if (nextMilestone is not null) { <ReferralBar Percent="ReferralBar.Of(data.Discord.LinkedCount, nextMilestone.Recruits)" Label="@L["Referral.DiscordHead"].Value" Text="@discordNote" /> }
                @if (discordNote is not null) { <p class="note">@discordNote</p> }
            </section>
        </div>

        @if (Code is not null && !data.CanEnter) { <p class="note" role="status">@L["Referral.JoinClosed", Code]</p> }
        <section class="enter-box"><ReferralEnter Data="data" Prefill="@Code" Entered="Reload" /></section>

        <h3>@L["Referral.Recruits"]</h3>
        <p class="note">@L["Referral.Qualification", Fmt.Num(data.Qualification.Hours, "0.##"), data.Qualification.Score]</p>
        @if (data.Recruits.Length == 0)
        {
            <p class="note">@L["Referral.NoRecruits"]</p>
        }
        else
        {
            @if (data.Recruits.Any(r => !r.Qualified))
            {
                @Recruits(data.Recruits.Where(r => !r.Qualified))
            }
            @if (data.Recruits.Any(r => r.Qualified))
            {
                <h4>@L["Referral.Qualified"] <span class="count">@data.Recruits.Count(r => r.Qualified)</span></h4>
                @Recruits(data.Recruits.Where(r => r.Qualified))
            }
        }

        @if (data.Tiers.Length > 0)
        {
            <h3>@L["Referral.Rewards"]</h3>
            @Ladder(data.Tiers, L["Referral.TierHead"])
        }

        @if (data.Discord.Milestones.Length > 0)
        {
            <h3>@L["Referral.Discord"]</h3>
            @Ladder(data.Discord.Milestones, L["Referral.DiscordHead"])
        }
    }
</div>

@code {
    /// <summary>The code of the invitation link, <c>/join/&lt;code&gt;</c>.</summary>
    [Parameter] public string? Code { get; set; }

    Referral? data;
    bool loaded, signedOut;

    protected override async Task OnInitializedAsync()
    {
        if (await Sessions.CurrentAsync() is null)
        {
            signedOut = loaded = true;
            // the community server signs in with a page load and comes back to this address, which is then the page with the code filled in
            if (Code is not null && Sessions.SignInUrl("/join/" + Uri.EscapeDataString(Code)) is { } url) Nav.NavigateTo(url, forceLoad: true);
            return;
        }
        await Load();
    }

    async Task Load()
    {
        data = await Service.GetAsync();
        loaded = true;
    }

    async Task Reload() => data = await Service.GetAsync() ?? data;

    /// <summary>The recruits as compact rows: who, one bar for the two goals (their mean: a recruit qualifies when both are met) and the two numbers under it.</summary>
    RenderFragment Recruits(IEnumerable<ReferralRecruit> recruits) => @<ol class="recruits">
        @foreach (var r in recruits)
        {
            var q = data!.Qualification;
            var played = L["Referral.OfHours", Fmt.Num(r.Hours, "0.##"), Fmt.Num(q.Hours, "0.##")].Value;
            var gained = L["Referral.OfScore", r.Score, q.Score].Value;
            var percent = (ReferralBar.Of(r.Hours, q.Hours) + ReferralBar.Of(r.Score, q.Score)) / 2;
            var text = $"{L["Referral.Played"]}: {played}; {L["Referral.Gained"]}: {gained}";
            <li class="@(r.Qualified ? "qualified" : null)">
                <div class="who">
                    <a href="/profile/@r.Handle">@r.Handle</a>
                    @if (r.Qualified)
                    {
                        <span class="tag done">@L["Referral.Qualified"]</span>
                        @if (r.QualifiedAt is { } at) { <span class="when">@Fmt.Purchase(DateTimeOffset.FromUnixTimeSeconds(at).UtcDateTime)</span> }
                    }
                    @if (r.DiscordLinked) { <span class="tag">@L["Referral.DiscordLinked"]</span> }
                </div>
                <div class="progress">
                    <ReferralBar Percent="percent" Done="r.Qualified" Label="@r.Handle" Text="@text" />
                    <p class="nums">
                        <span>@L["Referral.Played"] <b>@played</b></span>
                        <span>@L["Referral.Gained"] <b>@gained</b></span>
                    </p>
                </div>
            </li>
        }
    </ol>;

    /// <summary>Reward levels as a ladder: one step per level (reached ticked, the next one marked), the reward under it; (reward to be announced) while none is set.</summary>
    RenderFragment Ladder(ReferralTier[] tiers, string head) => @<div class="ladder-box">
            <p class="note">@head</p>
            <ol class="ladder">
                @foreach (var t in tiers)
                {
                    <li class="@(t.Reached ? "reached" : t == tiers.First(x => !x.Reached) ? "next" : null)">
                        <span class="step"><b>@t.Recruits</b>
                            @if (t.Reached) { <span class="ok" role="img" aria-label="@L["Referral.Reached"]">✓</span> }
                            else if (t == tiers.First(x => !x.Reached)) { <span class="tag">@L["Referral.Next"]</span> }
                        </span>
                        @if (t.Reward is { Any: true }) { <span class="reward">@L.Reward(t.Reward)</span> }
                        else { <span class="reward tba">(@L["Referral.Tba"])</span> }
                    </li>
                }
            </ol>
        </div>;
}
