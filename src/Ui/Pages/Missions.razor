@page "/missions"
@page "/missions/group/{Group:int}"
@inject IMissionsService Service
@inject ModalService Modal
@inject IJSRuntime JS

<PageTitle>@L["Mis.Regular"]</PageTitle>

<div class="page-min">
<Tabs Items="tabs" Active="/missions" HelpHref="/help/day-mission" />
@if (data is not null)
{
    <button type="button" class="btn btn-primary all" @onclick="ActivateAll">@L["Mis.ActivateAll"]</button>
    <label class="check"><input class="tick" type="checkbox" id="auto-activate" checked="@data.Auto" @onchange='e => Automatic("auto", e)' /> @L["Mis.Auto"]</label>
    <label class="check"><input class="tick" type="checkbox" id="activate-only-favourite" checked="@data.OnlyFavourite" @onchange='e => Automatic("onlyfavourite", e)' /> @L["Mis.OnlyFavourite"]</label>
    <p class="line">@L["Mis.ResetDesc"] <a href="/store/item/221">@L["Mis.GoToStore"]</a></p>
    <p class="line">@L["Mis.Completion", data.Completed, data.Total, data.PacksDone, data.PacksTotal]</p>

    <section class="box filters">
        <h4>@L["Mis.Filters"]</h4>
        <form @onsubmit="Apply" @onsubmit:preventDefault>
            <div class="grid">
                <label>@L["Mis.FilterIn"]<select class="field-sel" id="block_id" value="@filterIn" @onchange="BlockChanged"><option value="all">@L["Mis.All"]</option><option value="favourite">@L["Mis.Favourite"]</option><option value="active">@L["Mis.Active"]</option><option value="packs">@L["Mis.Packs"]</option><option value="available">@L["Mis.Available"]</option></select></label>
                <label>@L["Mis.Reserves"]<MultiSelect Options="reserves" Selected="reserveSel" /></label>
                <label>@L["Mis.Species"]<MultiSelect Options="species" Selected="speciesSel" Label="s => L.Term(s)" /></label>
                <label>@L["Mis.Weapons"]<MultiSelect Options="weapons" Selected="weaponSel" /></label>
            </div>
            <label class="hide"><input class="tick" type="checkbox" id="hide-completed" @bind="hideCompleted" /> @L["Mis.HideCompleted"]</label>
            <label class="search">@L["Mis.Search"]<input class="field-light" type="text" id="mission-search" @bind="search" @bind:event="oninput" /></label>
            <button type="submit" class="btn btn-primary">@L["Mis.Filter"]</button>
        </form>
    </section>

    @if (Show("favourite"))
    {
        <section class="box">
            <h4>@L["Mis.Favourite"] <span class="caret"></span><label class="aside"><input class="tick" type="checkbox" id="mission_favourite_hide" checked="@data.HideCompletedFavourite" @onchange="HideFavourite" /> @L["Mis.HideCompleted"]</label></h4>
            @if (favourites.Count == 0) { <p class="notice">@L["Mis.NoFavourites"]</p> }
            else { @Packs(favourites) }
        </section>
    }
    @if (Show("active"))
    {
        <section class="box">
            <h4 @onclick="() => closed ^= 1">@L["Mis.Active"] (@active.Count) <span class="caret"></span></h4>
            @if (active.Count == 0) { <p class="notice">@L["Mis.NoActive"]</p> }
            else if ((closed & 1) == 0) { @Rows(active) }
        </section>
    }
    @if (Show("available"))
    {
        <section class="box">
            <h4 @onclick="() => closed ^= 2">@L["Mis.Available"] (@available.Count) <span class="caret"></span></h4>
            @if (available.Count == 0) { <p class="notice">@L["Mis.NoAvailable"]</p> }
            else if ((closed & 2) == 0) { @Rows(available) }
        </section>
    }
    @if (Show("packs"))
    {
        <section class="box">
            <h4 @onclick="() => closed ^= 4">@L["Mis.Packs"] <span class="caret"></span></h4>
            @if ((closed & 4) == 0) { @Packs(packs) }
        </section>
    }
}
else { <div class="skeleton skeleton-page"></div> }
</div>

@code {
    RegularMissions? data;
    IReadOnlyList<(string, string)> tabs = [];
    IReadOnlyList<string> reserves = [], species = [], weapons = [];
    readonly HashSet<string> reserveSel = [], speciesSel = [], weaponSel = [], open = [];
    string filterIn = "all", search = "";
    // the filter is applied by the Filter button: these are the values it applied
    string appliedIn = "all", applied = "";
    bool hideCompleted, appliedHide;
    int closed;
    IReadOnlyList<Mission> active = [], available = [];
    IReadOnlyList<MissionPack> packs = [], favourites = [];

    [Parameter] public int? Group { get; set; }

    // the old deep link /missions/group/<id> opens that pack and scrolls to it, once the page has its data
    bool scrollPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollPending || data is null || Group is not { } id) return;
        scrollPending = false;
        await using var shell = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Resurgence.Ui/shell.js");
        await shell.InvokeVoidAsync("scrollToPack", id);
    }

    protected override async Task OnInitializedAsync()
    {
        tabs = [(L["Mis.Daily"], "/missions/daily"), (L["Mis.Regular"], "/missions")];
        data = await Service.RegularAsync();
        Options();
        Apply();
        if (Group is { } g) { open.Add("pack:" + g); scrollPending = true; }
    }

    bool Show(string box) => appliedIn == "all" || appliedIn == box;

    // the options of the three filters are those of the lists the chosen block shows; changing the block clears the choices and filters at once, as the old page
    void BlockChanged(ChangeEventArgs e)
    {
        filterIn = e.Value?.ToString() ?? "all";
        reserveSel.Clear();
        speciesSel.Clear();
        weaponSel.Clear();
        Options();
        Apply();
    }

    void Options()
    {
        var ms = data!.Missions.Where(m => m.State == "active" && Block("active") || m.State == "available" && Block("available"))
            .Concat(data.Packs.Where(p => p.Favourite && Block("favourite") || Block("packs")).SelectMany(p => p.Missions)).ToList();
        (reserves, species, weapons) = (ms.Select(m => m.Reserve).Distinct().Order().ToList(), ms.Select(m => m.Species).Distinct().OrderBy(s => L.Term(s), StringComparer.CurrentCulture).ToList(), ms.Select(m => m.Weapon).Distinct().Order().ToList());
    }

    bool Block(string box) => filterIn == "all" || filterIn == box;

    bool Chosen(Mission m) => (reserveSel.Count == 0 || reserveSel.Contains(m.Reserve)) && (speciesSel.Count == 0 || speciesSel.Contains(m.Species)) && (weaponSel.Count == 0 || weaponSel.Contains(m.Weapon));

    static bool Has(string text, string find) => text.Contains(find, StringComparison.OrdinalIgnoreCase);

    bool Found(Mission m) => applied.Length == 0 || Has(m.Name, applied) || Has(m.Description, applied) || m.Objectives.Any(o => Has(o, applied));

    // client-side, as in the old page: the Filter button narrows the lists; both the missions and the packs (and their favourites) answer to reserve, species, weapon, hide completed and search
    void Apply()
    {
        (appliedIn, applied, appliedHide) = (filterIn, search.Trim(), hideCompleted);
        var ms = data!.Missions.Where(m => Chosen(m) && Found(m) && !(appliedHide && m.State == "completed")).OrderBy(m => m.Name, StringComparer.Ordinal).ToList();
        active = ms.Where(m => m.State == "active").ToList();
        available = ms.Where(m => m.State == "available").ToList();
        // a pack stays when one of its missions is chosen and, with a search text, when its title, description or one of its missions is found
        bool Pack(MissionPack p) => p.Missions.Any(Chosen) && (applied.Length == 0 || Has(p.Name, applied) || Has(p.Description, applied) || p.Missions.Any(Found));
        packs = data.Packs.Where(Pack).OrderBy(p => p.Name, StringComparer.Ordinal).ToList();
        favourites = packs.Where(p => p.Favourite && !(data.HideCompletedFavourite && p.Done == p.Total)).ToList();
    }

    async Task HideFavourite(ChangeEventArgs e)
    {
        await Service.SetHideCompletedFavouriteAsync((bool)e.Value!);
        data = await Service.RegularAsync();
        Apply();
    }

    RenderFragment Rows(IReadOnlyList<Mission> list) => @<ul class="rows">
        @foreach (var m in list)
        {
            <li class="@(open.Contains(m.Name) ? "open" : "")">
                <button type="button" class="row hover-tint" aria-expanded="@(open.Contains(m.Name) ? "true" : "false")" @onclick="() => Toggle(m.Name)"><span class="tri"></span>@m.Name<Icon Name="@(m.State == "active" ? "lock" : "unlock")" /></button>
                @if (open.Contains(m.Name))
                {
                    <div class="more">
                        <h5>@L["Mis.Rewards"]</h5><p>@m.Reward</p>
                        <h5>@L["Mis.Description"]</h5><p>@m.Description</p>
                        <h5>@L["Mis.Objectives"]</h5><ol>@foreach (var o in m.Objectives) { <li>@o</li> }</ol>
                        @if (m.State == "available") { <button type="button" class="btn btn-primary" @onclick="() => Activate(m.Id)">@L["Mis.Activate"]</button> }
                    </div>
                }
            </li>
        }
    </ul>;

    RenderFragment Packs(IEnumerable<MissionPack> list) => @<ul class="rows packs">
        @foreach (var p in list)
        {
            var key = "pack:" + p.Id;
            <li class="@(open.Contains(key) ? "open" : "")" data-pack="@p.Id">
                <div class="packline">
                    <button type="button" class="row pack hover-tint" aria-expanded="@(open.Contains(key) ? "true" : "false")" @onclick="() => Toggle(key)"><span class="tri"></span><span class="name">@p.Name<small>@L["Mis.Progress"] @p.Done / @p.Total</small></span></button>
                    <button type="button" class="star" title="@L["Mis.FavouriteTip"]" aria-pressed="@(p.Favourite ? "true" : "false")" @onclick="() => Favourite(p)"><Icon Name="@(p.Favourite ? "star" : "star-regular")" /></button>
                </div>
                @if (open.Contains(key))
                {
                    <div class="more">
                        <p>@p.Description</p>
                        @Rows(p.Missions)
                    </div>
                }
            </li>
        }
    </ul>;

    void Toggle(string name) { if (!open.Remove(name)) open.Add(name); }

    async Task Activate(int id) => await Done(await Service.ActivateAsync(id));

    async Task ActivateAll() => await Done(await Service.ActivateAsync(0));

    async Task Done(Result r)
    {
        Modal.Alert(r.Ok ? L["Mis.ActivationDone"] + " " + L["Mis.Enjoy"] : L["Mis.Failed"]);
        data = await Service.RegularAsync();
        Options();
        Apply();
    }

    async Task Favourite(MissionPack p)
    {
        await Service.SetFavouriteAsync(p.Id, !p.Favourite);
        data = await Service.RegularAsync();
        Options();
        Apply();
    }

    async Task Automatic(string setting, ChangeEventArgs e)
    {
        await Service.SetAutomaticAsync(setting, (bool)e.Value!);
        data = await Service.RegularAsync();
    }
}
