@page "/settings"
@inject IAccountService Service
@inject ISessionService Sessions

<PageTitle>@L["Set.Title"]</PageTitle>

@* the avatar is the only account setting the community server has (docs/website.md#sign-in); the others could be built later and show disabled *@
<div class="page-min">
    <h2 class="page-title">@(L["Set.Title"].Value.ToUpper(System.Globalization.CultureInfo.CurrentCulture))</h2>
    <div class="cols">
        <nav class="menu">
            <h3>@handle</h3>
            <ul>
                @foreach (var (key, label) in tabs)
                {
                    @if (key == "avatar")
                    {
                        <li class="on"><a href="/settings">@L[label]</a></li>
                    }
                    else
                    {
                        <li class="off" aria-disabled="true" title="@L["Settings.ComingLater"]"><span>@L[label]</span><span class="sr"> (@L["Settings.ComingLater"])</span></li>
                    }
                }
            </ul>
        </nav>
        <section class="panel">
            <h4 class="bar">@L["Set.AvatarTitle"]</h4>
            <div class="pane">
                <p class="info">@L["Set.AvatarInfo"]</p>
                <h5>@L["Set.AvatarCurrent"]</h5>
                <div class="cur"><AssetSlot Name="@(account?.Avatar ?? Avatars.Default)" Width="150" Height="150" /></div>
                <h5>@L["Set.AvatarSelect"]</h5>
                <div class="avatars">
                    @foreach (var a in avatars.Where(a => !a.Locked))
                    {
                        <button type="button" class="pick @(a.Id == account?.Avatar ? "on" : "")" title="@a.Name" @onclick="() => Pick(a.Id)"><AssetSlot Name="@a.Id" Width="60" Height="60" /></button>
                    }
                </div>
                <h5>@L["Set.AvatarUnlockable"]</h5>
                <div class="avatars">
                    @foreach (var a in avatars.Where(a => a.Locked))
                    {
                        <a class="pick locked" href="/store/item/@a.Item" title="@L["Set.AvatarLocked"]"><AssetSlot Name="@a.Id" Width="60" Height="60" /><Icon Name="lock" /><span>@a.Name</span></a>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    static readonly (string Key, string Label)[] tabs =
    [
        ("email", "Set.TabEmail"), ("avatar", "Set.TabAvatar"), ("language", "Set.TabLocale"), ("purchases", "Wal.History"), ("bans", "Set.TabBans"),
        ("steam", "Set.TabSteam"), ("profile", "Set.TabProfile"),
    ];

    Account? account;
    IReadOnlyList<AvatarChoice> avatars = [];
    string handle = "";

    protected override async Task OnInitializedAsync()
    {
        handle = (await Sessions.CurrentAsync())?.Handle ?? "";
        (account, avatars) = (await Service.AccountAsync(), await Service.AvatarsAsync());
    }

    async Task Pick(string id)
    {
        await Service.SetAvatarAsync(id);
        account = await Service.AccountAsync();
    }
}
