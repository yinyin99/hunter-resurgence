@page "/game-management"
@page "/game-management/{Tab}"
@inject IGameManagementService Service

<PageTitle>@L["Settings.GameManagement"]</PageTitle>

<div class="page-min">
    <nav class="tabs">
        <a href="/game-management/trophy-lodge" class="@(Tab == "trophy-lodge" ? "on" : "")">@L["GM.Lodge"]</a>
        <a href="/game-management/bait-sites" class="@(Tab == "bait-sites" ? "on" : "")">@L["GM.Bait"]</a>
    </nav>
    <div class="screen">
        @if (Tab == "trophy-lodge")
        {
            <div class="card lodge">
                <h4>@L["GM.LodgeTitle"]</h4>
                @if (lodges.Count == 0) { <p>@L["GM.NoLodges"]</p> }
                @foreach (var l in lodges) { <p>@l.Name</p> }
            </div>
        }
        else if (Tab == "bait-sites")
        {
            <div class="card bait">
                <div class="head"><h4>@L["GM.BaitTitle"]</h4><label>@L["GM.Fill"] <input id="fill" type="number" min="0" @bind="fill" /></label></div>
                @foreach (var g in sites.GroupBy(s => s.Group))
                {
                    <h5>@g.Key</h5>
                    @foreach (var s in g)
                    {
                        <div class="site">
                            <AssetSlot Name="bait-barrel" Width="80" Height="100" />
                            <div class="where"><b>@s.Name</b><span>x: @s.X</span><span>y: @s.Y</span></div>
                            <div class="meter">
                                <span>@L["GM.BaitCol"]</span><div class="bar"><i style="width:@(s.Max == 0 ? 0 : 100 * s.Bait / s.Max)%"></i><b>@s.Bait/@s.Max</b></div>
                                <span>@L["GM.Status"]</span><div class="state @(s.Active ? "" : "off")">@(s.Active ? L["GM.Active"] : "")</div>
                                <button type="button" class="refill" @onclick="() => Refill(s)">@L["GM.Refill"]</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="card home"><h4>@L["GM.Home"]</h4><p>@L["GM.Choose"]</p></div>
        }
    </div>
</div>

@code {
    IReadOnlyList<ManagedItem> lodges = [];
    List<BaitSite> sites = [];
    int fill = 50;

    [Parameter] public string? Tab { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Tab == "trophy-lodge") lodges = await Service.TrophyLodgeAsync();
        else if (Tab == "bait-sites") sites = [.. await Service.BaitSitesAsync()];
    }

    // refilling is fake in the mock: the bar fills up to the number in the box
    async Task Refill(BaitSite s)
    {
        var to = Math.Clamp(fill, 0, s.Max);
        if (!(await Service.RefillAsync(s.Id, to)).Ok) return;
        sites[sites.IndexOf(s)] = s with { Bait = to };
    }
}
