@page "/players/{Handle}/trophies"
@using Resurgence.Ui.Players

@if (player is null)
{
    <NotFoundNotice />
}
else
{
    <PlayerHeader Player="player" Tab="trophies" />

    <form method="get" class="toolbar">
        <div class="field">
            <label for="species">@L["Trophies.Species"]</label>
            <select id="species" name="species" class="input">
                <option value="">@L["Common.All"]</option>
                @foreach (var s in SampleData.SpeciesNames)
                {
                    <option value="@s" selected="@(s == Species)">@s</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="sort">@L["Trophies.Sort"]</label>
            <select id="sort" name="sort" class="input">
                <option value="score" selected="@(Sort != "date")">@L["Trophies.Sort.Score"]</option>
                <option value="date" selected="@(Sort == "date")">@L["Trophies.Sort.Date"]</option>
            </select>
        </div>
        <button type="submit" class="btn">@L["Common.Apply"]</button>
    </form>

    @if (shown.Count == 0)
    {
        <p class="empty">@L["Trophies.None"]</p>
    }
    else
    {
        <div class="grid">
            @foreach (var t in shown)
            {
                <TrophyCard Trophy="t" />
            }
        </div>
    }
}

@code {
    [Parameter] public string Handle { get; set; } = "";
    [SupplyParameterFromQuery(Name = "species")] public string? Species { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }

    PlayerProfile? player;
    IReadOnlyList<Trophy> shown = [];

    protected override void OnParametersSet()
    {
        player = SampleData.FindPlayer(Handle);
        if (player is null) return;
        var all = SampleData.TrophiesOf(player.Handle).Where(t => string.IsNullOrEmpty(Species) || t.Species == Species);
        shown = (Sort == "date" ? all.OrderByDescending(t => t.Date).ThenByDescending(t => t.Score) : all.OrderByDescending(t => t.Score)).ToList();
    }
}
