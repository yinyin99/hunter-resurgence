@page "/messages"
@page "/messages/{Handle}"
@page "/new-message"
@page "/new-message/{Handle}"
@implements IDisposable
@inject IMessagesService Service
@inject IFriendsService Friends
@inject ISessionService Sessions
@inject NavigationManager Nav
@inject ModalService Modal
@inject HostMode Mode

<PageTitle>@L["Msg.Title"]</PageTitle>

<div class="page-min">
    <h2 class="page-title">@(L["Msg.Title"].Value.ToUpper(System.Globalization.CultureInfo.CurrentCulture))</h2>
    <label class="check"><input class="tick" type="checkbox" id="receive-private-messages" checked="@onlyFriends" disabled="@savingOnly" @onchange="OnlyFriends" /> @L["Msg.OnlyFriends"]</label>
    <a class="btn btn-primary new" href="/new-message">@L["Msg.New"]</a>
    <div class="cols">
        <aside>
            <h4>@L["Msg.Conversations"]</h4>
            @if (conversations.Count == 0) { <p class="empty">@L["Msg.Empty"]</p> }
            <ul>
                @foreach (var c in conversations)
                {
                    <li class="@(c.Handle == current ? "on" : "")">
                        <a class="hover-tint" href="/messages/@c.Handle"><AssetSlot Name="avatar-default" Width="40" Height="40" Class="av" /><span class="who">@c.Handle</span><span class="last">@c.Last</span>@if (c.Unread) { <i class="dot"></i> }</a>
                    </li>
                }
            </ul>
        </aside>
        <section>
            @if (composing) { <h3>@L["Msg.New"]</h3> } else { <h4>@current</h4> }
            @if (composing)
            {
                <input id="message-recipient" class="field-light to" list="friends" placeholder="@L["Msg.To"]" @bind="recipient" @bind:event="oninput" />
                <datalist id="friends">@foreach (var f in friends) { <option value="@f.Handle"></option> }</datalist>
            }
            <textarea class="field-light" id="message" placeholder="@L["Msg.Text"]" maxlength="2048" @bind="text" @bind:event="oninput"></textarea>
            <button id="sendMessage" type="button" class="send" disabled="@(!canSend || sending)" @onclick="Send">@L["Msg.Send"]</button>
            <span class="count">@text.Length / 1024</span>
            @if (!composing)
            {
                <div class="thread">
                    @foreach (var m in thread)
                    {
                        <div class="@(m.Mine ? "me" : "you")">
                            <a href="/profile/@(m.Mine ? me : current)" class="h">@(m.Mine ? me : current)</a>
                            <div class="body"><AssetSlot Name="avatar-default" Width="60" Height="60" Class="av" /><div class="msg"><p>@m.Text</p><small>@L["Msg.Sent", Fmt.Ago(L, m.Ago)]</small></div></div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    readonly CancellationTokenSource stop = new();
    IReadOnlyList<Conversation> conversations = [];
    IReadOnlyList<Friend> friends = [];
    IReadOnlyList<Message> thread = [];
    string text = "", recipient = "", me = "", current = "";
    bool onlyFriends, savingOnly, sending;

    [Parameter] public string? Handle { get; set; }
    bool composing => Nav.Uri.Contains("/new-message");
    bool canSend => text.Trim().Length is > 0 and <= 1024 && (!composing || recipient.Trim().Length > 0);

    protected override async Task OnInitializedAsync()
    {
        (conversations, me) = (await Service.ConversationsAsync(), (await Sessions.CurrentAsync())?.Handle ?? "");
        friends = await Friends.FriendsAsync();
        _ = Poll();
    }

    protected override async Task OnParametersSetAsync()
    {
        (text, recipient, onlyFriends) = ("", Handle ?? "", await Service.OnlyFriendsAsync());
        current = composing ? "" : conversations.FirstOrDefault(c => string.Equals(c.Handle, Handle, StringComparison.OrdinalIgnoreCase))?.Handle ?? Handle ?? conversations.FirstOrDefault()?.Handle ?? "";
        await OpenThread();
    }

    // opening a thread reads it: the unread dot of the conversation goes (the status bar follows with its next read)
    async Task OpenThread()
    {
        thread = current.Length > 0 ? await Service.ThreadAsync(current) : [];
        if (conversations.FirstOrDefault(c => c.Handle == current)?.Unread != true) return;
        await Service.MarkReadAsync(current);
        conversations = await Service.ConversationsAsync();
    }

    // like the old page, which read the conversations again whenever the status bar learned of a new message
    async Task Poll()
    {
        using var timer = new PeriodicTimer(Mode.PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
                await InvokeAsync(async () =>
                {
                    conversations = await Service.ConversationsAsync();
                    await OpenThread();
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException) { }
    }

    async Task OnlyFriends(ChangeEventArgs e)
    {
        (onlyFriends, savingOnly) = ((bool)e.Value!, true);
        await Service.SetOnlyFriendsAsync(onlyFriends);
        savingOnly = false;
    }

    // at most one send a second; a failure opens the alert dialog; a message to someone new shows up in the conversations
    async Task Send()
    {
        if (sending) return;
        sending = true;
        try
        {
            var to = composing ? recipient.Trim() : current;
            var r = await Service.SendAsync(to, text.Trim());
            if (!r.Ok) { Modal.Alert(L[r.Error ?? "Msg.Failed"]); return; }
            var known = conversations.Any(c => string.Equals(c.Handle, to, StringComparison.OrdinalIgnoreCase));
            conversations = await Service.ConversationsAsync();
            text = "";
            if (!composing) thread = await Service.ThreadAsync(current);
            else if (known) Nav.NavigateTo("/messages/" + to);
        }
        finally
        {
            await Task.Delay(1000);
            sending = false;
        }
    }

    public void Dispose() => stop.Cancel();
}
