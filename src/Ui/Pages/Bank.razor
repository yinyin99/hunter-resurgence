@page "/bank"
@page "/bank/{Tab}"
@page "/bank/success/{Ref}"
@implements IDisposable
@inject ModalService Modal

@* the bank is a modal over the news page, as in the old app *@
<Feed />

@code {
    Type? shown;

    /// <summary>ems, memberships (also for any other value), help, or offerwall.</summary>
    [Parameter] public string? Tab { get; set; }
    /// <summary>Set after a payment: the thanks dialog instead of the bank.</summary>
    [Parameter] public string? Ref { get; set; }
    /// <summary>?show_help=1 opens the help tab.</summary>
    [SupplyParameterFromQuery(Name = "show_help")] public int? ShowHelp { get; set; }

    protected override void OnParametersSet()
    {
        if (Ref is not null) { shown = typeof(PurchaseDoneModal); Modal.Show<PurchaseDoneModal>(); }
        else if (Tab == "offerwall") { shown = typeof(OfferwallModal); Modal.Show<OfferwallModal>(); }
        else { shown = typeof(BankModal); Modal.Show<BankModal>(new Dictionary<string, object?> { ["Tab"] = ShowHelp == 1 ? "help" : Tab is "ems" or "help" ? Tab : "memberships" }); }
    }

    public void Dispose()
    {
        if (Modal.Type == shown) Modal.Close();
    }
}
