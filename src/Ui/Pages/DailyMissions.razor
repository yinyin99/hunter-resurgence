@page "/missions/daily"
@inject IMissionsService Service
@implements IDisposable
@inject ModalService Modal

<PageTitle>@L["Mis.Daily"]</PageTitle>

<div class="page-min">
<Tabs Items="tabs" Active="/missions/daily" HelpHref="/help/day-mission" />
@if (d is not null)
{
    <div class="calendar">
        @foreach (var day in d.Days)
        {
            var n = day.Number;
            @* only today's mission is opened: the server gives no other day's, and the other cards are not buttons *@
            <button type="button" class="card @(n == d.Today ? "active hover-tint" : "") @(day.Stars > 1 ? "big" : "")" disabled="@(n != d.Today)" aria-disabled="@(n != d.Today ? "true" : null)" aria-pressed="@(n == d.Today ? "true" : null)">
                <h6>@Label(n)</h6>
                <div class="body">
                    <AssetSlot Name="@($"paw-badge-{(day.Stars switch { 1 => "easy", 2 => "medium", _ => "hard" })}")" Width="100" Height="111" Class="badge" />
                    <div class="stars">@day.Stars</div>
                    <div class="gms">@day.Gms gm$</div>
                </div>
            </button>
        }
    </div>
    if (d.Today >= 1 && d.Today <= d.Missions.Count && d.Missions[d.Today - 1].Title.Length > 0)  // a day without a mission shows only its card
    {
    var m = d.Missions[d.Today - 1];
    var frozen = m.Frozen;
    <section class="detail">
        @if (frozen) { <span class="ribbon">@L["Mis.Inactive"]</span> }
        else if (m.Done) { <span class="ribbon">@L["Mis.Completed"]</span> }
        <h2>@m.Title</h2>
        <div class="who">@if (m.Giver is not null) { <AssetSlot Name="@($"mission-giver-{m.Giver}")" Width="150" Height="150" /> }<div><h3>@L["Mis.Description"]</h3><p>@m.Description</p></div></div>
        @if (m.Species is not null) { <AssetSlot Name="@AssetImages.Key($"mission-species-{m.Species}-{(m.Female ? "f" : "m")}")" Width="250" Height="360" Class="pic" /> }  @* the original's card: the species picture by the mission's gender *@
        <h3>@L["Mis.Objectives"]</h3>
        <ol>@foreach (var o in m.Objectives) { <li><span class="box"></span> @o</li> }</ol>
        <h3>@L["Mis.Reserves"]</h3>
        <p class="indent">@m.Reserve</p>
        <h3>@L["Mis.Rewards"]</h3>
        <ul>@foreach (var r in m.Rewards) { <li>@r</li> }</ul>
        @if (frozen)
        {
            @if (d.Broken) { <p class="broken">@L["Mis.Broken"]</p> }
            <p class="broken">@L["Mis.BrokenNote"]</p>
            <div class="actions">
                <button type="button" class="btn btn-primary" id="activate-dm" @onclick="Activate">@L["Mis.Activate"]</button>
                @if (d.Resume is { } item)
                {
                    @if (item.Owned > 0) { <button type="button" class="btn btn-primary" id="bottom-block-resume-streak" @onclick="() => Resume(item)">@L["Mis.Use"]</button> }
                    else { <a class="btn btn-primary" id="buy-resume-streak" href="/store/item/@item.Id">@L["Mis.Buy"]</a> }
                }
            </div>
        }
        else
        {
            <p class="timer">@L[left > 0 ? "Mis.EndsIn" : "Mis.Ended"] <b>@Fmt.Elapsed(L, Math.Max(left, 0))</b></p>
        }
    </section>
    }
}
else { <div class="skeleton skeleton-page"></div> }
</div>

@code {
    DailyCalendar? d;
    IReadOnlyList<(string, string)> tabs = [];
    int left;
    PeriodicTimer? timer;

    protected override async Task OnInitializedAsync()
    {
        tabs = [(L["Mis.Daily"], "/missions/daily"), (L["Mis.Regular"], "/missions")];
        await Read();
    }

    async Task Read()
    {
        d = await Service.DailyAsync();
        left = d.EndsIn;
    }

    // the day counts down once a second and the page is read again at 0, as the old page reloads
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        timer = new(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
        {
            if (--left <= 0) await Read();
            StateHasChanged();
        }
    }

    public void Dispose() => timer?.Dispose();

    string Label(int day) => L["Mis.Day", day] + (day == d!.Today ? $" ({L["Mis.Today"]})" : day == d.Today + 1 ? $" ({L["Mis.Tomorrow"]})" : "");

    async Task Activate()
    {
        var r = await Service.ActivateAsync(-1);
        Modal.Alert(r.Ok ? L["Mis.ActivationDone"] + " " + L["Mis.Enjoy"] : L["Mis.Failed"]);
        await Read();
    }

    void Resume(ResumeItem item)
    {
        Func<Task<Result>> activate = Service.ResumeStreakAsync;
        Func<Task> done = Read;
        Modal.Show<ConfirmActivateModal>(new Dictionary<string, object?> { ["Item"] = item, ["Activate"] = activate, ["Done"] = done });
    }
}
