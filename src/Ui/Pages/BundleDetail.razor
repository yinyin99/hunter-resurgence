@page "/store/bundle/{Id:int}"
@inject IStoreService Service
@inject ISessionService Sessions
@inject ModalService Modal
@inject HostMode Mode

<PageTitle>@(bundle?.Name ?? L["Menu.Store"])</PageTitle>

<StoreFrame Active="bundles">
    @if (bundle is not null)
    {
        <article class="item">
            @if (bundle.OnSale && !variantB) { <Ribbon Text="@L.SaleTag(bundle.Sale)" /> } else if (!bundle.OnSale) { <Ribbon Text="@L["Store.BundleTag"]" Class="blue" /> }
            <AssetSlot Name="@Mode.BundleSlot(bundle.Id)" Width="190" Height="207" Class="pic" />
            <div class="buy">
                @if (!signedIn) { <button class="btn btn-tall btn-primary" disabled>@L["Store.Login"]</button> }
                else if (!bundle.Buyable) { <button class="btn btn-tall" disabled title="@(Mode.Live ? L["Store.NotBuyable"] : L["Store.MaxOwn"])">@L["Store.Buy"]</button> }
                else { <button id="buy-bundle" class="btn btn-tall btn-primary" @onclick="Buy">@L["Store.Buy"]</button> }
                @if (variantB && bundle.OnSale) { <SaleCardB Big Percent="SaleCardB.BundlePct(bundle)" Prices="SaleCardB.BundlePrices(bundle)" Sale="bundle.Sale" /> }
                else if (variantC && bundle.OnSale) { <SaleCardC Big Prices="SaleCardB.BundlePrices(bundle)" /> }
                else if (bundle.StruckPrice > 0) { <b class="sale">@bundle.Price em$</b> <s>@bundle.StruckPrice em$</s> } else { <b>@bundle.Price em$</b> }
            </div>
            @if (bundle.Sale is { } sale && !variantB) { <p class="ends">@L.SaleEnds(sale)</p> }
            <h1>@bundle.Name</h1>
            <p class="text">@bundle.Description</p>
            @if (!bundle.Buyable && !Mode.Live) { <p class="own">@L["Store.MaxOwn"]</p> }
            @if (bundle.OwnedItems > 0 && bundle.OwnedItems == bundle.OfItems) { <p class="own">@L["Store.BundleAllOwned"]</p> }
            else if (bundle.OwnedItems > 0) { <p class="own">@(bundle.WasPrice > bundle.Price ? L["Store.BundleOwn", bundle.OwnedItems, bundle.OfItems, bundle.Price, bundle.WasPrice] : L["Store.BundleOwnCount", bundle.OwnedItems, bundle.OfItems])</p> }
            <table class="tbl">
                <thead><tr><th>@L["Store.Included"]</th>@if (!Mode.Live) { <th class="own">@L["Store.Own"]</th><th>@L["Store.OwnLimit"]</th> }<th>@L["Store.Value"]</th></tr></thead>
                <tbody>
                    @* a line of the same item twice is one line with the counts added *@
                    @foreach (var g in bundle.Lines.GroupBy(l => l.ItemId))
                    {
                        var l = g.First();
                        <tr><td><AssetSlot Name="@Mode.ItemSlot(l.ItemId)" Width="30" Height="30" Class="thumb" /> @g.Sum(x => x.Count)x <a href="/store/item/@l.ItemId">@l.Name</a>@if (l.Variant.Length > 0) { <text> (@l.Variant)</text> }</td>@if (!Mode.Live) { <td class="own">@l.Owned</td><td>@(l.OwnLimit > 0 ? l.OwnLimit : L["Store.Unlimited"])</td> }<td>@g.Sum(x => x.Value) em$</td></tr>
                    }
                </tbody>
            </table>
            <p class="total">@L["Store.BundlePrice"] <b>@bundle.Price em$</b></p>
            @if (bundle.OwnedItems == 0) { <p class="total save">@L["Store.YouSave"] <b>@(bundle.Lines.Sum(l => l.Value) - bundle.Price) em$</b></p> }
        </article>
    }
    else if (loaded) { <p class="text">@L["Store.None"]</p> }
    else { <div class="skeleton skeleton-page"></div> }
</StoreFrame>

@code {
    StoreBundle? bundle;
    bool loaded, signedIn;

    // PROTOTYPE (sale card variant B), not production: ?salecard=b shows the other sale presentation
    [SupplyParameterFromQuery(Name = "salecard")] public string? SaleCard { get; set; }
    bool variantB => SaleCard == "b";
    bool variantC => SaleCard == "c";

    [Parameter] public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        signedIn = await Sessions.CurrentAsync() is not null;
        await Load();
        loaded = true;
    }

    async Task Load() => bundle = await Service.BundleAsync(Id);

    void Buy() => Modal.Show<BuyModal>(new Dictionary<string, object?>
    {
        ["Id"] = bundle!.Id, ["Name"] = bundle.Name, ["Ems"] = bundle.Price, ["Bundle"] = true, ["Lines"] = bundle.Lines,
        ["Bought"] = EventCallback.Factory.Create(this, Load),
    });
}
