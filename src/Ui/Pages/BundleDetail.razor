@page "/store/bundle/{Id:int}"
@inject IStoreService Service
@inject ISessionService Sessions
@inject ModalService Modal

<PageTitle>@L["Menu.Store"]</PageTitle>

<StoreFrame Active="bundles">
    @if (bundle is not null)
    {
        <article class="item">
            <Ribbon Text="@L["Store.BundleTag"]" Class="blue" />
            <AssetSlot Name="store-bundle-large" Width="190" Height="207" Class="pic" />
            <div class="buy">
                @if (!signedIn) { <button class="btn btn-tall btn-primary" disabled>@L["Store.Login"]</button> }
                else if (!bundle.Buyable) { <button class="btn btn-tall" disabled title="@L["Store.MaxOwn"]">@L["Store.Buy"]</button> }
                else { <button id="buy-bundle" class="btn btn-tall btn-primary" @onclick="Buy">@L["Store.Buy"]</button> }
                <b>@bundle.Price em$</b>
            </div>
            <h1>@bundle.Name</h1>
            <p class="text">@bundle.Description</p>
            @if (!bundle.Buyable) { <p class="own">@L["Store.MaxOwn"]</p> }
            <table class="tbl">
                <thead><tr><th>@L["Store.Included"]</th><th class="own">@L["Store.Own"]</th><th>@L["Store.OwnLimit"]</th><th>@L["Store.Value"]</th></tr></thead>
                <tbody>
                    @* a line of the same item twice is one line with the counts added *@
                    @foreach (var g in bundle.Lines.GroupBy(l => l.ItemId))
                    {
                        var l = g.First();
                        <tr><td><AssetSlot Name="store-thumb" Width="30" Height="30" Class="thumb" /> @g.Sum(x => x.Count)x <a href="/store/item/@l.ItemId">@l.Name</a>@if (l.Variant.Length > 0) { <text> (@l.Variant)</text> }</td><td class="own">@l.Owned</td><td>@(l.OwnLimit > 0 ? l.OwnLimit : L["Store.Unlimited"])</td><td>@g.Sum(x => x.Value) em$</td></tr>
                    }
                </tbody>
            </table>
            <p class="total">@L["Store.BundlePrice"] <b>@bundle.Price em$</b></p>
            <p class="total save">@L["Store.YouSave"] <b>@(bundle.Lines.Sum(l => l.Value) - bundle.Price) em$</b></p>
        </article>
    }
    else if (loaded) { <p class="text">@L["Store.None"]</p> }
    else { <div class="skeleton skeleton-page"></div> }
</StoreFrame>

@code {
    StoreBundle? bundle;
    bool loaded, signedIn;

    [Parameter] public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        signedIn = await Sessions.CurrentAsync() is not null;
        await Load();
        loaded = true;
    }

    async Task Load() => bundle = await Service.BundleAsync(Id);

    void Buy() => Modal.Show<BuyModal>(new Dictionary<string, object?>
    {
        ["Id"] = bundle!.Id, ["Name"] = bundle.Name, ["Ems"] = bundle.Price, ["Bundle"] = true, ["Lines"] = bundle.Lines,
        ["Bought"] = EventCallback.Factory.Create(this, Load),
    });
}
