@page "/inventory"
@inject IInventoryService Service
@inject IStoreService Store
@inject HostMode Mode
@inject ModalService Modal

<PageTitle>@L["Inv.Title"]</PageTitle>

<div class="page-min">
    <h2 class="page-title">@(L["Inv.Title"].Value.ToUpper(System.Globalization.CultureInfo.CurrentCulture))</h2>
    @if (!loaded) { <div class="skeleton wait"></div> }
    else if (groups.Count == 0) { <p class="none">@L["Inv.None"]</p> }
    @foreach (var g in groups)
    {
        <section class="group">
            <h3>@(g.First().CategoryName is { Length: > 0 } title ? title : L["Inv.Other"].Value)</h3>
            <div class="grid">
                @foreach (var i in g)
                {
                    <article class="card">
                        <AssetSlot Name="@Mode.ItemSlot(i.Id)" Width="150" Height="110" Class="pic" />
                        <span class="name">@i.Name</span>
                        <span class="variant">@i.Variant</span>
                        @if (i.Units is { } units) { <p class="units">@L["Inv.Units", units]</p> }
                        @if (i.Equipped) { <p class="equipped">@L["Inv.Equipped"]</p> }
                        @if (i.Sell is { } offer) { <button class="btn btn-inverse sell" @onclick="() => Sell(i, offer)">@L["Inv.Sell"] (@offer.Refund @Currency(offer))</button> }
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    IReadOnlyList<IGrouping<string, InventoryItem>> groups = [];
    bool loaded;

    static string Currency(SellOffer offer) => offer.Currency == "em" ? "em$" : "gm$";

    // read again on every open, so an item just bought shows; the groups follow the store's sub-categories, an item of none last
    protected override async Task OnInitializedAsync()
    {
        await Load();
        loaded = true;
    }

    async Task Load()
    {
        var items = await Service.ItemsAsync();
        var order = (await Store.CategoriesAsync()).SelectMany(c => c.Children).Select(c => c.Key).ToList();
        groups = [.. items.GroupBy(i => i.Category).OrderBy(g => order.IndexOf(g.Key) is var n && n >= 0 ? n : int.MaxValue)];
    }

    // the server decides what can be sold (docs/server.md#selling-back): the button shows the refund it offers, the confirmation asks once, the list is read again after the answer
    async Task Sell(InventoryItem item, SellOffer offer)
    {
        if (!await Modal.Confirm(L["Inv.SellConfirm", item.Name, offer.Refund, Currency(offer)])) return;
        if (await Service.SellAsync(item.Guid) is { Ok: false } failed) Modal.Alert(L[failed.Error ?? "Inv.SellFailed"]);
        await Load();
    }
}
