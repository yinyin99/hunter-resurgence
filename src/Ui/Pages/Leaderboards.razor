@page "/leaderboards"
@page "/leaderboards/{*Path}"
@inject ILeaderboardsService Service
@inject ISessionService Sessions
@inject NavigationManager Nav
@inject HostMode Mode

<PageTitle>@L["Board.Title"]</PageTitle>

<div class="page-min">
<h2 class="page-title">@L["Board.Title"]</h2>
<Tabs Kind="strip" Items="tabs" Active="@active" />

@if (failed)
{
    <p class="norank" role="alert">@L["Board.LoadFailed"]</p>
    <button type="button" class="btn btn-inverse" @onclick="OnParametersSetAsync">@L["Board.Retry"]</button>
}
else if (loaded)
{
    switch (kind)
    {
        case "hunterscore":
            <section class="panel head"><h4>@L["Board.AllTime"]</h4></section>
            <div class="mine"><span class="rank-label">@L["Board.YourRank"]</span></div>
            @if (mine is not null) { <table class="board me"><tbody><RankRow R="mine" Kind="hunterscore" /></tbody></table> }
            <table class="board">
                <thead><tr><th>@L["Board.Rank"]</th><th></th><th class="hunter">@L["Board.Hunter"]</th><th>@L["Board.ScoreColumn"]</th></tr></thead>
                <tbody>@foreach (var r in rows) { <RankRow R="r" Kind="hunterscore" /> }</tbody>
            </table>
            <Paginator Page="page" Pages="pages" Href='n => "/leaderboards/hunterscore/" + n' />
            break;
        case "halloffame":
            <section class="panel head hall">
                <h4>@L["Board.Past"]</h4>
                @if (ended.Count > 0) { @SeasonSelect(ended) }
            </section>
            @if (hall.Count == 0) { <p class="norank">@L["Board.NoHall"]</p> }
            <div class="tiles four">
                @foreach (var h in hall)
                {
                    <section class="tile panel hof">
                        <h4>@L.Term(h.Species)</h4>
                        <AssetSlot Name="@($"species-{h.Species}")" Width="135" Height="135" />
                        @HallSide("Board.Score", "score", h.Score)
                        @HallSide("Board.Range", "range", h.Range)
                    </section>
                }
            </div>
            break;
        case "lanebandit" or "bustthrough":
            <section class="panel head info">
                <h4>@L[kind == "lanebandit" ? "Board.TopLane" : "Board.TopBust"]</h4>
                @* the store link names the mock's item; the live store's ids are the original's *@
                <p>@L[kind == "lanebandit" ? "Board.LaneInfo" : "Board.BustInfo"] @if (kind == "lanebandit" && !Mode.Live) { <a href="/store/item/66">@L["Board.GetLane"] <Icon Name="chevron-right" /></a> }</p>
            </section>
            @if (mine is not null || !Mode.Live)
            {
                <div class="mine"><span class="rank-label">@L["Board.YourRank"]</span></div>
                @if (mine is null) { <p class="norank">@L["Board.NoRank"]</p> }
                else { <table class="board me"><tbody><RankRow R="mine" Kind="@kind" /></tbody></table> }
            }
            <table class="board"><tbody>@foreach (var r in rows) { <RankRow R="r" Kind="@kind" /> }</tbody></table>
            <Paginator Page="page" Pages="pages" Href="@(n => "/leaderboards/" + kind + "/" + n)" />
            break;
        default:
            @if (id is null)
            {
                <section class="panel head hall">
                    <h4>@(season == 0 ? L[kind == "range" ? "Board.TopRangesAll" : "Board.TopScoresAll"] : L[kind == "range" ? "Board.TopRanges" : "Board.TopScores", season])</h4>
                    @SeasonSelect(all)
                </section>
                @if (boards.Count == 0) { <p class="norank">@L["Board.Empty"]</p> }
                <div class="tiles two">
                    @foreach (var b in boards)
                    {
                        <section class="tile panel">
                            <h4>@L.Term(b.Name)</h4>
                            <table class="board small"><tbody>@foreach (var r in b.Top) { <RankRow R="r" Kind="@kind" Small="true" /> }</tbody></table>
                            <a class="btn btn-inverse full" href="@($"/leaderboards/{kind.Replace("-", "/")}/{b.Id}{Q(season)}")">@L["Board.Full"] <Icon Name="chevron-right" /></a>
                        </section>
                    }
                </div>
            }
            else
            {
                <section class="panel head species">
                    <AssetSlot Name="@($"species-{speciesName}")" Width="118" Height="118" />
                    <h3>@L.Term(speciesName)</h3>
                    @SeasonSelect(all)
                </section>
                @if (mine is not null || !Mode.Live)
                {
                    <div class="mine"><span class="rank-label">@L["Board.YourRank"]</span></div>
                    @if (mine is null) { <p class="norank">@L["Board.NoRank"]</p> }
                    else { <table class="board me"><tbody><RankRow R="mine" Kind="@kind" /></tbody></table> }
                }
                @if (rows.Count == 0) { <p class="norank">@L["Board.Empty"]</p> }
                else
                {
                    <table class="board">
                        <thead><tr><th>@L["Board.Rank"]</th><th></th><th class="hunter">@L["Board.Hunter"]</th><th>@L[kind == "range" ? "Board.Range" : "Board.Score"]</th><th>@L["Stat.Weapon"]</th><th>@L["Stat.TimeOfHarvest"]</th></tr></thead>
                        <tbody>@foreach (var r in rows) { <RankRow R="r" Kind="@kind" /> }</tbody>
                    </table>
                }
                <Paginator Page="page" Pages="pages" Href="@(n => "/leaderboards/" + kind.Replace("-", "/") + "/" + id + "/" + n + Q(season))" />
            }
            break;
    }
}
else
{
    <div class="skeleton wait"></div>
    <div class="tiles two">@for (var i = 0; i < 4; i++) { <div class="skeleton wait-tile"></div> }</div>
}
</div>

@code {
    IReadOnlyList<(string Label, string Href)> tabs = [];
    IReadOnlyList<Board> boards = [];
    IReadOnlyList<Ranked> rows = [];
    IReadOnlyList<HallEntry> hall = [];
    /// <summary>The seasons the selector offers: 0, all time, and every season; <see cref="ended"/> the ended ones, the hall of fame's.</summary>
    IReadOnlyList<int> all = [], ended = [];
    Ranked? mine;
    string kind = "score", active = "", speciesName = "";
    int? id;
    int page = 1, pages = 1, season, current;
    /// <summary>The board is read: <see cref="loaded"/>, or <see cref="failed"/> when the server did not answer (the empty text is for a board it answered as empty).</summary>
    bool loaded, failed;

    /// <summary>What follows /leaderboards/: the board (score, range, hunterscore, halloffame, lanebandit, bustthrough, antlers/single, antlers/double), then a species or antler id, then a page.</summary>
    [Parameter] public string? Path { get; set; }

    /// <summary>The season of a species board or the hall of fame: 0 is all time; missing is the current season (the hall's: the last ended one).</summary>
    [SupplyParameterFromQuery(Name = "season")] public int? SeasonQuery { get; set; }

    protected override void OnInitialized()
    {
        tabs =
        [
            (L["Board.Score"], "/leaderboards/score"), (L["Board.Range"], "/leaderboards/range"), (L["Board.HunterScore"], "/leaderboards/hunterscore"), (L["Board.HallOfFame"], "/leaderboards/halloffame"),
            (L["Board.LaneBandit"], "/leaderboards/lanebandit"), (L["Board.BustThrough"], "/leaderboards/bustthrough"), (L["Board.Single"], "/leaderboards/antlers/single"), (L["Board.Double"], "/leaderboards/antlers/double"),
        ];
        // the community server has no antler boards: the live site offers the boards it has
        if (Mode.Live) tabs = [.. tabs.Where(t => ServerLeaderboardsService.Kinds.Contains(t.Href["/leaderboards/".Length..]))];
    }

    protected override async Task OnParametersSetAsync()
    {
        (loaded, failed) = (false, false);
        var p = (Path ?? "score").Split('/', StringSplitOptions.RemoveEmptyEntries);
        var numbers = p.SkipWhile(s => !int.TryParse(s, out _)).Select(int.Parse).ToArray();
        kind = p[0] == "antlers" ? "antlers-" + (p.Length > 1 ? p[1] : "single") : p[0];
        if (Mode.Live && !ServerLeaderboardsService.Kinds.Contains(kind))
        {
            Nav.NavigateTo("/leaderboards/score", replace: true);
            return;
        }
        active = tabs.FirstOrDefault(t => t.Href == "/leaderboards/" + kind.Replace("-", "/")).Href ?? tabs[0].Href;
        try
        {
            var (now, seasons) = await Service.SeasonsAsync();
            current = now;
            all = [0, .. seasons.Select(s => s.No).OrderBy(n => n)];
            ended = [.. seasons.Where(s => s.End is not null).Select(s => s.No).OrderBy(n => n)];
            season = SeasonQuery ?? (kind == "halloffame" ? ended.LastOrDefault() : now);
            (id, page, mine, boards, rows) = (null, 1, null, [], []);
            switch (kind)
            {
                case "halloffame":
                    hall = [.. (await Service.HallAsync(season)).OrderBy(h => L.Term(h.Species), StringComparer.CurrentCultureIgnoreCase)];
                    break;
                case "hunterscore" or "lanebandit" or "bustthrough":
                    page = numbers.Length > 0 ? numbers[0] : 1;
                    (rows, page, pages) = Unpack(await Service.RowsAsync(kind, 0, page, 0));
                    mine = await Service.MyRankAsync(kind, 0, 0);
                    break;
                default:
                    boards = [.. (await Service.BoardsAsync(kind, season)).OrderBy(b => L.Term(b.Name), StringComparer.CurrentCultureIgnoreCase)];
                    if (numbers.Length > 0)
                    {
                        (id, page) = (numbers[0], numbers.Length > 1 ? numbers[1] : 1);
                        (rows, page, pages) = Unpack(await Service.RowsAsync(kind, id.Value, page, season));
                        mine = await Service.MyRankAsync(kind, id.Value, season);
                        // a species nobody ranks in this season is not in its overview: its name is the all-time one
                        speciesName = (boards.FirstOrDefault(b => b.Id == id) ?? (season == 0 ? null : (await Service.BoardsAsync(kind, 0)).FirstOrDefault(b => b.Id == id)))?.Name ?? "";
                    }
                    break;
            }
            loaded = true;
        }
        catch (BoardUnavailableException) { failed = true; }
    }

    static (IReadOnlyList<Ranked>, int, int) Unpack(Page<Ranked> p) => (p.Rows, p.Number, p.Pages);

    /// <summary>The query of a season's address: none for the current season.</summary>
    string Q(int n) => n == current ? "" : "?season=" + n;

    // season 1 and 2 say where their harvests come from
    string SeasonLabel(int n) => n switch { 0 => L["Board.SeasonAll"], 1 => L["Board.Season1"], 2 => L["Board.Season2"], _ => L["Board.SeasonN", n] };

    RenderFragment SeasonSelect(IReadOnlyList<int> nos) => @<select class="field-light" id="leaderboard-season-selector" aria-label="@L["Board.Season"]" @onchange="PickSeason">
        @foreach (var n in nos) { <option value="@n" selected="@(n == season)">@SeasonLabel(n)</option> }
    </select>;

    // a species of the hall of fame may have only one of the two winners
    RenderFragment HallSide(string heading, string board, Ranked? r) => @<text>
        <h6>@L[heading]</h6>
        @if (r is null) { <span class="v">–</span> }
        else
        {
            <AssetSlot Name="@r.Avatar" Width="160" Height="160" />
            <a href="/profile/@r.Handle">@r.Handle</a>
            @if (r.Sheet > 0) { <a href="/profile/@r.Handle/score/@r.Sheet" class="v">@Fmt.Board(board, r.Value)</a> }
            else { <span class="v">@Fmt.Board(board, r.Value)</span> }
        }
    </text>;

    void PickSeason(ChangeEventArgs e)
    {
        var n = int.Parse((string)e.Value!);
        Nav.NavigateTo("/leaderboards/" + (kind == "halloffame" ? "halloffame?season=" + n : kind.Replace("-", "/") + (id is { } i ? "/" + i : "") + Q(n)));
    }
}
