@page "/leaderboards"
@page "/leaderboards/{*Path}"
@inject ILeaderboardsService Service
@inject ISessionService Sessions
@inject NavigationManager Nav

<PageTitle>@L["Board.Title"]</PageTitle>

<div class="page-min">
<h2 class="page-title">@L["Board.Title"]</h2>
<Tabs Kind="strip" Items="tabs" Active="@active" />

@if (loaded)
{
    switch (kind)
    {
        case "hunterscore":
            <section class="panel head"><h4>@L["Board.AllTime"]</h4></section>
            <div class="mine"><span class="rank-label">@L["Board.YourRank"]</span></div>
            @if (mine is not null) { <table class="board me"><tbody><RankRow R="mine" Kind="hunterscore" /></tbody></table> }
            <table class="board">
                <thead><tr><th>@L["Board.Rank"]</th><th></th><th class="hunter">@L["Board.Hunter"]</th><th>@L["Board.ScoreColumn"]</th></tr></thead>
                <tbody>@foreach (var r in rows) { <RankRow R="r" Kind="hunterscore" /> }</tbody>
            </table>
            <Paginator Page="page" Pages="pages" Href='n => "/leaderboards/hunterscore/" + n' />
            break;
        case "halloffame":
            <section class="panel head hall">
                <h4>@L["Board.Past"]</h4>
                <select id="leaderboard-season-selector" @onchange="PickSeason">
                    @for (var n = 1; n < current; n++) { <option value="@n" selected="@(n == season)">@L["Board.SeasonN", n]</option> }
                </select>
            </section>
            <div class="tiles four">
                @foreach (var h in hall)
                {
                    <section class="tile panel hof">
                        <h4>@L.Term(h.Species)</h4>
                        <AssetSlot Name="species" Width="135" Height="135" />
                        <h6>@L["Board.Score"]</h6>
                        @if (h.Score.Handle.Length > 0)
                        {
                            <AssetSlot Name="avatar-default" Width="160" Height="160" />
                            <a href="/profile/@h.Score.Handle">@h.Score.Handle</a>
                            <a href="/profile/@h.Score.Handle/score/@h.Score.Sheet" class="v">@Fmt.Board("score", h.Score.Value)</a>
                        }
                        else { <span class="v">@Fmt.Board("score", h.Score.Value)</span> }
                        <h6>@L["Board.Range"]</h6>
                        @if (h.Range.Handle.Length > 0)
                        {
                            <AssetSlot Name="avatar-default" Width="160" Height="160" />
                            <a href="/profile/@h.Range.Handle">@h.Range.Handle</a>
                            <a href="/profile/@h.Range.Handle/score/@h.Range.Sheet" class="v">@Fmt.Board("range", h.Range.Value)</a>
                        }
                        else { <span class="v">@Fmt.Board("range", h.Range.Value)</span> }
                    </section>
                }
            </div>
            break;
        case "lanebandit" or "bustthrough":
            <section class="panel head info">
                <h4>@L[kind == "lanebandit" ? "Board.TopLane" : "Board.TopBust"]</h4>
                <p>@L[kind == "lanebandit" ? "Board.LaneInfo" : "Board.BustInfo"] @if (kind == "lanebandit") { <a href="/store/item/66">@L["Board.GetLane"] <Icon Name="chevron-right" /></a> }</p>
            </section>
            <div class="mine"><span class="rank-label">@L["Board.YourRank"]</span></div>
            <p class="norank">@L["Board.NoRank"]</p>
            <table class="board"><tbody>@foreach (var r in rows) { <RankRow R="r" Kind="@kind" /> }</tbody></table>
            <Paginator Page="page" Pages="pages" Href="@(n => "/leaderboards/" + kind + "/" + n)" />
            break;
        default:
            @if (id == 0)
            {
                <section class="panel head"><h4>@L[kind == "range" ? "Board.TopRanges" : "Board.TopScores", season]</h4></section>
                <div class="tiles two">
                    @foreach (var b in boards)
                    {
                        <section class="tile panel">
                            <h4>@L.Term(b.Name)</h4>
                            <table class="board small"><tbody>@foreach (var r in b.Top) { <RankRow R="r" Kind="@kind" Small="true" /> }</tbody></table>
                            <a class="btn btn-inverse full" href="/leaderboards/@(kind.Replace("-", "/"))/@b.Id">@L["Board.Full"] <Icon Name="chevron-right" /></a>
                        </section>
                    }
                </div>
            }
            else
            {
                <section class="panel head species">
                    <AssetSlot Name="species" Width="118" Height="118" />
                    <h3>@L.Term(boards.FirstOrDefault(b => b.Id == id)?.Name ?? "")</h3>
                </section>
                <div class="mine"><span class="rank-label">@L["Board.YourRank"]</span></div>
                @if (mine is null) { <p class="norank">@L["Board.NoRank"]</p> }
                else { <table class="board me"><tbody><RankRow R="mine" Kind="@kind" /></tbody></table> }
                <table class="board"><tbody>@foreach (var r in rows) { <RankRow R="r" Kind="@kind" /> }</tbody></table>
                <Paginator Page="page" Pages="pages" Href="@(n => "/leaderboards/" + kind.Replace("-", "/") + "/" + id + "/" + n)" />
            }
            break;
    }
}
else
{
    <div class="skeleton wait"></div>
    <div class="tiles two">@for (var i = 0; i < 4; i++) { <div class="skeleton wait-tile"></div> }</div>
}
</div>

@code {
    IReadOnlyList<(string Label, string Href)> tabs = [];
    IReadOnlyList<Board> boards = [];
    IReadOnlyList<Ranked> rows = [];
    IReadOnlyList<HallEntry> hall = [];
    Ranked? mine;
    string kind = "score", active = "";
    int id, page = 1, pages = 1, season, current;
    bool loaded;

    /// <summary>What follows /leaderboards/: the board (score, range, hunterscore, halloffame, lanebandit, bustthrough, antlers/single, antlers/double), then a species or antler id, then a page (a season for the hall of fame).</summary>
    [Parameter] public string? Path { get; set; }

    protected override void OnInitialized()
    {
        tabs =
        [
            (L["Board.Score"], "/leaderboards/score"), (L["Board.Range"], "/leaderboards/range"), (L["Board.HunterScore"], "/leaderboards/hunterscore"), (L["Board.HallOfFame"], "/leaderboards/halloffame"),
            (L["Board.LaneBandit"], "/leaderboards/lanebandit"), (L["Board.BustThrough"], "/leaderboards/bustthrough"), (L["Board.Single"], "/leaderboards/antlers/single"), (L["Board.Double"], "/leaderboards/antlers/double"),
        ];
    }

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        var p = (Path ?? "score").Split('/', StringSplitOptions.RemoveEmptyEntries);
        var numbers = p.SkipWhile(s => !int.TryParse(s, out _)).Select(int.Parse).ToArray();
        kind = p[0] == "antlers" ? "antlers-" + (p.Length > 1 ? p[1] : "single") : p[0];
        active = tabs.FirstOrDefault(t => t.Href == "/leaderboards/" + kind.Replace("-", "/")).Href ?? tabs[0].Href;
        season = current = await Service.SeasonAsync();
        (id, page, mine, boards, rows) = (0, 1, null, [], []);
        switch (kind)
        {
            case "halloffame":
                var past = numbers.Length > 0 ? numbers[0] : season - 1;
                hall = await Service.HallAsync(past);
                this.season = past;
                break;
            case "hunterscore" or "lanebandit" or "bustthrough":
                page = numbers.Length > 0 ? numbers[0] : 1;
                (rows, page, pages) = Unpack(await Service.RowsAsync(kind, 0, page));
                mine = await Service.MyRankAsync(kind, 0);
                break;
            default:
                boards = await Service.BoardsAsync(kind);
                if (numbers.Length > 0)
                {
                    (id, page) = (numbers[0], numbers.Length > 1 ? numbers[1] : 1);
                    (rows, page, pages) = Unpack(await Service.RowsAsync(kind, id, page));
                    mine = await Service.MyRankAsync(kind, id);
                }
                break;
        }
        loaded = true;
    }

    static (IReadOnlyList<Ranked>, int, int) Unpack(Page<Ranked> p) => (p.Rows, p.Number, p.Pages);

    void PickSeason(ChangeEventArgs e) => Nav.NavigateTo("/leaderboards/halloffame/" + e.Value);
}
