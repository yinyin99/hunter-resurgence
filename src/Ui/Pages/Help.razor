@page "/help"
@page "/help/{Tab}"
@page "/help/tutorials/{Section:int}"
@inject IHelpService Service
@inject Branding Brand
@inject HostMode Mode
@inject ModalService Modal

<PageTitle>@L["Menu.Help"]</PageTitle>

<div class="page-min">
    <h2 class="page-title">@L["Menu.Help"]</h2>
    <Tabs Kind="strip" Items="tabs" Active="@("/help" + (tab == "support" ? "" : "/" + tab))" />
    <div class="panel @(tab == "tutorials" ? "bare" : "")">
        @switch (tab)
        {
            case "support":
                <h3>@L["Help.Tabs.Support"]</h3>
                <p>@L["Help.Support.Intro"]</p>
                <p>@L["Help.Support.Ticket"]</p>
                <ul class="links">
                    <li><ExternalLink Key="support">@L["Help.Support.LinkSupport"]</ExternalLink></li>
                    <li><ExternalLink Key="forum">@L["Help.Support.LinkForum"]</ExternalLink></li>
                    <li>@L.Frag("Help.Support.Wiki", Ext("wiki", L["Help.Support.LinkWiki"]), Ext("wiki_de", L["Help.Lang.German"]), Ext("wiki_fr", L["Help.Lang.French"]), Ext("wiki_es", L["Help.Lang.Spanish"]))</li>
                    <li><ExternalLink Key="support_connections">@L["Help.Support.Connections"]</ExternalLink></li>
                </ul>
                <a class="banner" href="/help/tutorials"><AssetSlot Name="help-banner" Width="940" Height="245" /><b>@L["Help.Support.NewTo"]</b><span>@L["Help.Support.Videos"]</span></a>
                break;
            case "guides":
                <h3>@L["Help.Guides.Title"]</h3>
                <p>@L["Help.Guides.Text"]</p>
                <h4>@L["Help.Tabs.Guides"]</h4>
                <ul class="links">@foreach (var (g, i) in guides.Select((g, i) => (g, i + 1))) { <li><ExternalLink Key="@("guide_" + i)">@g.Title</ExternalLink></li> }</ul>
                break;
            case "day-mission":
                <DayMissionHelp />
                break;
            case "tutorials":
                <Tabs Kind="pills" Items="pills" Active="@("/help/tutorials/" + section)" />
                @if (current is not null)
                {
                    <div class="hero">
                        <AssetSlot Name="help-hero" Width="940" Height="250" />
                        <h1>@current.Title</h1>
                        <p>@if (current.Id == 1) { @L.Html("Help.Tut.Intro", Mode.Launcher ? "<a href=\"/tutorials\">" : "", Mode.Launcher ? "</a>" : "") } else { @G(current.Description) }</p>
                    </div>
                    <ul class="videos">
                        @foreach (var v in current.Videos)
                        {
                            <li>
                                @if (Mode.Launcher) { <ExternalLink Key="@("video_" + v.Id)" Class="vt">@v.Title</ExternalLink> }
                                else { <a href="#" class="vt" @onclick='() => Modal.Show<VideoModal>(new Dictionary<string, object?> { ["Title"] = v.Title })' @onclick:preventDefault>@v.Title</a> }
                                <span>@L.Frag("Help.Tut.By", Author(v.Author))</span>
                            </li>
                        }
                    </ul>
                }
                break;
            case "community":
                <h3>@L["Help.Community.Title"]</h3>
                <p>@L["Help.Community.Text"]</p>
                <ul class="where">@foreach (var (c, i) in communities.Select((c, i) => (c, i + 1))) { <li>@c.Country: <ExternalLink Key="@("community_" + i)">@c.Name</ExternalLink></li> }</ul>
                break;
        }
    </div>
</div>

@code {
    IReadOnlyList<(string, string)> tabs = [], pills = [];
    IReadOnlyList<Guide> guides = [];
    IReadOnlyList<TutorialSection> sections = [];
    IReadOnlyList<Community> communities = [];
    TutorialSection? current;

    [Parameter] public string? Tab { get; set; }
    [Parameter] public int? Section { get; set; }
    string tab => Section is not null ? "tutorials" : Tab is "guides" or "day-mission" or "tutorials" or "community" ? Tab! : "support";
    int section => Section ?? 1;

    RenderFragment Ext(string key, string text) => @<ExternalLink Key="@key">@text</ExternalLink>;
    RenderFragment Author(string name) => @<b>@name</b>;

    string G(string text) => Brand.Expand(text);

    protected override async Task OnInitializedAsync()
    {
        tabs = [(L["Help.Tabs.Support"], "/help"), (L["Mis.Daily"], "/help/day-mission"), (L["Help.Tabs.Guides"], "/help/guides"), (L["Help.Tabs.Video"], "/help/tutorials"), (L["Help.Tabs.Community"], "/help/community")];
        (guides, sections, communities) = (await Service.GuidesAsync(), await Service.TutorialsAsync(), await Service.CommunitiesAsync());
        pills = sections.Select(s => (s.Title, "/help/tutorials/" + s.Id)).ToList();
    }

    protected override void OnParametersSet() => current = sections.FirstOrDefault(s => s.Id == section);
}
