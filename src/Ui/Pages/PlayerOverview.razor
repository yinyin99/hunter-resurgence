@page "/players/{Handle}"
@using Resurgence.Ui.Players

@if (player is null)
{
    <NotFoundNotice />
}
else
{
    <PlayerHeader Player="player" Tab="overview" />

    <div class="tiles">
        <div class="tile"><span class="value mono">@player.Hunts</span><span class="caption">@L["Players.Stat.Hunts"]</span></div>
        <div class="tile"><span class="value mono">@player.Kills</span><span class="caption">@L["Players.Stat.Kills"]</span></div>
        <div class="tile"><span class="value mono">@player.Trophies</span><span class="caption">@L["Players.Stat.Trophies"]</span></div>
        <div class="tile"><span class="value mono">@L["Players.Km", player.DistanceKm]</span><span class="caption">@L["Players.Stat.Distance"]</span></div>
        <div class="tile"><span class="value mono">@player.BestScore</span><span class="caption">@L["Players.Stat.BestScore"]</span></div>
    </div>

    <h2 class="section section-title">
        <span>@L["Players.RecentTrophies"]</span>
        <a href="/players/@player.Handle/trophies">@L["Players.ViewAll"]</a>
    </h2>
    @if (trophies.Count == 0)
    {
        <p class="empty">@L["Trophies.None"]</p>
    }
    else
    {
        <div class="grid">
            @foreach (var t in trophies)
            {
                <TrophyCard Trophy="t" Compact="true" />
            }
        </div>
    }

    <h2 class="section section-title">
        <span>@L["Players.RecentHunts"]</span>
        <a href="/players/@player.Handle/hunts">@L["Players.ViewAll"]</a>
    </h2>
    @if (hunts.Count == 0)
    {
        <p class="empty">@L["Hunts.None"]</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th scope="col">@L["Hunts.Date"]</th>
                        <th scope="col">@L["Hunts.Reserve"]</th>
                        <th scope="col" class="num">@L["Hunts.Kills"]</th>
                        <th scope="col" class="num">@L["Hunts.BestScore"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in hunts)
                    {
                        <tr>
                            <td><a href="/hunts/@h.Id">@h.Date.ToString("d")</a></td>
                            <td>@h.Reserve</td>
                            <td class="num mono">@h.Kills.Count</td>
                            <td class="num mono">@h.BestScore</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public string Handle { get; set; } = "";

    PlayerProfile? player;
    IReadOnlyList<Trophy> trophies = [];
    IReadOnlyList<HuntRecord> hunts = [];

    protected override void OnParametersSet()
    {
        player = SampleData.FindPlayer(Handle);
        if (player is null) return;
        trophies = SampleData.TrophiesOf(player.Handle).OrderByDescending(t => t.Date).ThenByDescending(t => t.Score).Take(3).ToList();
        hunts = SampleData.HuntsOf(player.Handle).Take(5).ToList();
    }
}
