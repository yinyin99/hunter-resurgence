@page "/"
@page "/feed"
@inject ISessionService Sessions
@inject ModalService Modal
@inject Branding Brand
@inject INewsFeedService NewsFeed

<PageTitle>@L["Landing.Heading"]</PageTitle>

@* for search engines and screen readers; the hero's logo is the visible title *@
<h1 class="visually-hidden">@L["Landing.Heading"]</h1>

@if (signedIn == false)
{
    <section class="hero">
        <AssetSlot Name="bg-hero" Width="980" Height="550" />
        <AssetSlot Name="logo-hero" Width="485" Height="120" Class="hero-logo" />
        @* a friend's invitation (?ref=<handle>) and the trailer link: texts hard-coded in English in the old page; the trailer is shown when settings.json has link_trailer *@
        @if (!string.IsNullOrWhiteSpace(Ref))
        {
            <p class="referrer">@Brand.Expand($"You have been invited by your friend {Ref} to play {{game}}!")<br />@Ref sends you 200 em$ and three special items to help you get started in the most realistic hunting game online!</p>
        }
        <a href="/download" class="hero-button" data-launch="hunter-resurgence://open">@L["Landing.Play"] <Icon Name="chevron-right" /> <Icon Name="chevron-right" /></a>
        @if (Brand.Link("trailer") is not null) { <button type="button" class="trailer" @onclick="Trailer">Watch the trailer</button> }
        @* not over a friend's invitation, which has the room under the logo *@
        @if (string.IsNullOrWhiteSpace(Ref)) { <OnlineNow Place="1" /> }
    </section>
}
@if (posts.Count > 0)
{
    <h2 class="latest @(signedIn == false ? "after-hero" : "")">@L["Feed.LatestNews"]</h2>
    <FeedCarousel Posts="posts" />
}
<div class="columns">
    <div class="news">
        <h3>@L["Feed.News"]</h3>
        @foreach (var post in posts)
        {
            <article id="@post.Anchor">
                <h4>@Brand.Expand(post.Title)</h4>
                <p class="when">@Fmt.DateTime(post.Published.UtcDateTime)</p>
                <NewsBody Text="@Brand.Expand(post.Body)" />
                @* a link of the project's own (link:<key>) is the one settings.json holds, plain text without it; any other is an https address *@
                @if (post.Link is { } link && post.LinkText is { } linkText)
                {
                    <p class="excerpt">
                        @if (link.StartsWith(BrandLink, StringComparison.Ordinal)) { <ExternalLink Key="@link[BrandLink.Length..]">@linkText</ExternalLink> }
                        else if (link.StartsWith("https://", StringComparison.Ordinal)) { <a href="@link" target="_blank" rel="noopener">@linkText</a> }
                    </p>
                }
            </article>
        }
    </div>
    <div class="side">
        <DiscordLinkCard />
        <DiscordWidget />
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ref")] public string? Ref { get; set; }

    const string BrandLink = "link:";

    bool? signedIn;
    IReadOnlyList<NewsPost> posts = [];

    protected override async Task OnInitializedAsync()
    {
        signedIn = await Sessions.CurrentAsync() is not null;
        posts = await NewsFeed.PostsAsync(System.Globalization.CultureInfo.CurrentUICulture.Name);
    }

    void Trailer() => Modal.Show<VideoModal>(new Dictionary<string, object?> { ["Title"] = "Watch the trailer" });
}
