@page "/signin/problem"
@layout SignInLayout
@inject ISignInService SignIn

<PageTitle>@L["SignInPage.Problem.Title"]</PageTitle>

<SignInProblem Reason="@Reason" Why="@why" />

@code {
    [SupplyParameterFromQuery] public string? Reason { get; set; }
    string? why;

    /// <summary>A banned player's reason comes from this browser's sign-in (the server keeps it there), never from the URL: a link someone else made shows none.</summary>
    protected override async Task OnInitializedAsync()
    {
        if (Reason == "banned" && await SignIn.PendingAsync() is { Step: "banned" } step) why = step.Reason;
    }
}
