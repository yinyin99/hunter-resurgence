@page "/profile/{Handle}"
@page "/profile/{Handle}/{Tab}"
@page "/profile/{Handle}/{Tab}/{Sub}"
@page "/profile/{Handle}/{Tab}/{Sub}/{Arg:int}"
@inject IProfileService Service
@inject ISessionService Session
@inject IAccountService Account
@inject IFriendsService Friends
@inject HostMode Mode
@inject NavigationManager Nav

<PageTitle>@L["Prof.Title", Handle]@if (tabs.FirstOrDefault(t => t.Key == marked).Label is { } label) { <text> - @L[label]</text> }</PageTitle>

<div class="page-min">
@if (profile is not null)
{
    <header class="head">
        @* the header picture: on the live site the one the player chose (none without one); on the mock the one of the settings: none, the most recent kill or a picture *@
        @if (banner is not null) { <AssetSlot Name="@banner" Width="940" Height="200" Class="banner" /> }
        <div class="polaroid"><AssetSlot Name="polaroid-back" Width="239" Height="288" /><AssetSlot Name="@avatar" Width="171" Height="171" Class="avatar" /><AssetSlot Name="polaroid-front" Width="239" Height="288" Class="front" /></div>
        <h1>@profile.Handle</h1>
        @if (signedIn && !profile.Own && !profile.Friend)
        {
            <button type="button" class="btn btn-primary request" disabled="@profile.RequestPending" @onclick="Request">
                @if (profile.RequestPending) { <Icon Name="check" /> @L["Prof.RequestPending"] } else { @L["Prof.Request"] }
            </button>
        }
        <p class="sub">
            @if (profile.Membership.Length > 0) { <span data-tip="@L["Prof.TipMembership", profile.Handle]">@profile.Membership</span> }
            <span data-tip="@L["Prof.TipScore", profile.Handle]"><Icon Name="paw" /> @profile.HunterScore</span>
            <a href="/leaderboards/hunterscore" data-tip="@L["Prof.TipRank", profile.Handle]"><Icon Name="asterisk" /> @L["Prof.Rank", profile.Rank]</a>
            @if (profile.Online) { <span class="online" data-tip="@L["Prof.TipOnline", profile.Handle]"><i></i>@L["Prof.Online"]</span> }
        </p>
    </header>
    @if (tab is not null)
    {
    <div class="body">
        <ul class="tabs">
            @foreach (var (key, label, icon) in tabs.Where(t => Shown(t.Key)))
            {
                <li class="@(key == marked ? "on" : "")"><a href="/profile/@profile.Handle/@key"><Icon Name="@icon" /> @L[label]</a></li>
            }
        </ul>
        @switch (tab)
        {
            case "ranks": <RanksTab Handle="@profile.Handle" Sub="@Sub" />; break;
            case "achievements": <AchievementsTab Handle="@profile.Handle" Sub="@Sub" />; break;
            case "skills": <SkillsTab Handle="@profile.Handle" Sub="@Sub" />; break;
            case "gallery": <GalleryTab Handle="@profile.Handle" Own="@profile.Own" Sub="@Sub" />; break;
            case "trophies": <TrophiesTab Handle="@profile.Handle" Sub="@Sub" />; break;
            case "dogs": <DogsTab Handle="@profile.Handle" />; break;
            case "friends": <FriendsTab Handle="@profile.Handle" Own="@profile.Own" Sub="@Sub" />; break;
            case "expedition": <ExpeditionTab Handle="@profile.Handle" Id="@id" />; break;
            case "score" or "antler": <SheetTab Handle="@profile.Handle" Kind="@Tab" Id="@id" />; break;
            case "statistics": <StatisticsTab Handle="@profile.Handle" Sub="@Sub" Arg="@Arg" />; break;
        }
    </div>
    }
}
</div>

@code {
    static readonly (string Key, string Label, string Icon)[] tabs =
    [
        ("ranks", "Prof.TabRanks", "bars"), ("achievements", "Prof.TabAchievements", "bookmark"), ("skills", "Prof.TabSkills", "star"), ("statistics", "Prof.TabStats", "chart-simple"),
        ("gallery", "Prof.TabGallery", "camera"), ("trophies", "Prof.TabTrophies", "trophy"), ("dogs", "Prof.TabDogs", "dog"), ("friends", "Prof.TabFriends", "user"),
    ];

    Profile? profile;
    bool signedIn;
    string header = "recent", avatar = Avatars.Default;
    string? banner;

    [Parameter] public string Handle { get; set; } = "";
    [Parameter] public string? Tab { get; set; }
    [Parameter] public string? Sub { get; set; }
    [Parameter] public int? Arg { get; set; }
    /// <summary>Does the profile show this tab: every tab on the mock, on the live site only those with a server source (Profile.Tabs).</summary>
    bool Shown(string key) => profile?.Tabs?.Contains(key) ?? true;
    /// <summary>The tab asked for when the profile shows it, else its first tab; null when it shows none (the header only).</summary>
    string? tab => (tabs.Any(t => t.Key == Tab) || Tab is "expedition" or "score" or "antler") && Shown(Tab!) ? Tab : tabs.Select(t => t.Key).FirstOrDefault(Shown);
    /// <summary>The tab shown as open: an expedition belongs to Statistics, a scoring sheet to none.</summary>
    string? marked => tab is "score" or "antler" ? null : tab == "expedition" ? "statistics" : tab;
    long id => long.TryParse(Sub, out var n) ? n : 0;

    protected override async Task OnParametersSetAsync()
    {
        profile = await Service.ProfileAsync(Handle);
        if (profile is null) { Nav.NotFound(); return; }  // an unknown handle: "Page not found", HTTP 404
        signedIn = await Session.CurrentAsync() is not null;
        // the header picture and the avatar of the signed-in player come from the account (another hunter's are not known here); a player of the server has their own avatar
        if (profile is { Own: true, Tabs: null }) (header, avatar) = ((await Account.HeadersAsync()).Selected, (await Account.AccountAsync()).Avatar);
        else (header, avatar) = ("recent", profile.Avatar ?? Avatars.Default);
        banner = Mode.Live ? (profile.Background is { } background ? "profile-bg-" + background : null) : header == "none" ? null : header == "recent" ? "profile-banner" : header;
    }

    // the request goes to the friends service; the profile then says it is pending, also when the page is opened again
    async Task Request()
    {
        await Friends.SendRequestAsync(profile!.Handle);
        profile = await Service.ProfileAsync(Handle);
    }
}
