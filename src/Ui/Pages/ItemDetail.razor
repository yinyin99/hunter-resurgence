@page "/store/item/{Id:int}"
@inject IStoreService Service
@inject ISessionService Sessions
@inject ModalService Modal
@inject HostMode Mode

<PageTitle>@(item?.Name ?? L["Menu.Store"])</PageTitle>

<StoreFrame Active="@(item?.Category ?? "all")">
    @if (item is not null)
    {
        <article class="item panel">
            @if (banner is { } b) { <Ribbon Text="@(b == "sale" ? L.SaleTag(item) : L["Store.Banner." + b])" Class="@(b == "sale" ? null : b)" /> }
            <AssetSlot Name="@Mode.ItemSlot(item.Id)" Width="270" Height="197" Class="pic" />
            <div class="buy">
                @* signed out the old page shows only the button *@
                @if (signedIn)
                {
                    @if (item.Gms > 0) { <span class="gms @(item.WasGms is null ? "" : "sale")">@(item.Ems > 0 ? L["Store.Or"] + " " : "")@item.Gms gm$</span> @if (item.WasGms is { } wasGms) { <s>@wasGms gm$</s> } }
                    @* an item sold for gm$ alone has no em$ price to show *@
                    @if (item.Ems > 0 || item.Gms <= 0)
                    {
                        <b class="@(item.WasEms is null ? "" : "sale")">@item.Ems em$</b>
                        @if (item.WasEms is { } was) { <s>@was em$</s> }
                    }
                }
                @if (!signedIn) { <button class="btn btn-tall btn-primary" disabled>@L["Store.Login"]</button> }
                else if (!item.Buyable || item.DisabledByServices || item.LimitReached) { <button class="btn btn-tall" disabled>@L["Store.NotBuyable"]</button> }
                else { <button id="buy-item" class="btn btn-tall btn-primary" @onclick="Buy">@L["Store.Buy"]</button> }
            </div>
            @if (signedIn && item.Sale is { } sale) { <p class="ends">@L.SaleEnds(sale)</p> }
            <h1>@item.Name</h1>
            <h3>@item.Variant</h3>
            @if (item.Capacity > 0 || item.Contents is not null)
            {
                <div class="data">
                    @if (item.Capacity > 0) { <p>@L["Store.Capacity"] @item.Capacity</p> }
                    @if (item.Contents is { } contents) { <p>@L["Store.Contains"] @Units(contents)</p> }
                </div>
            }
            <OwnedLine Owned="item.Owned" Counted="item.Counted" Expires="item.Expires" DaysLeft="item.DaysLeft" Unlimited="item.Unlimited" Fuel="item.Fuel" Full />
            @if (!Mode.Live)
            {
                @if (!item.Buyable || item.DisabledByServices) { <p class="own">@L["Store.CantBuy"]</p> }
                else if (item.LimitReached) { <p class="own">@L["Store.AlreadyOwn"]</p> }
            }
            <p class="text">@item.Description</p>
            <div class="cols">
                @if (item.Fits is { Count: > 0 } fits)
                {
                    <section class="fits">
                        @foreach (var f in fits)
                        {
                            <h4>@Title(f)</h4>
                            @foreach (var x in f.Items)
                            {
                                <a class="fit" href="/store/item/@x.Id">
                                    <AssetSlot Name="@Mode.ItemSlot(x.Id)" Width="260" Height="70" Class="thumb" />
                                    <span>@x.Name@if (x.Variant.Length > 0) { <text> (@x.Variant)</text> }</span>
                                </a>
                            }
                        }
                    </section>
                }
                @if (item.Ethics is { } ethics)
                {
                    <section class="ethics">
                        <h4>@L["Store.Ethical"]</h4>
                        <table class="tbl tbl-c">
                            <thead><tr><th></th>@foreach (var c in ethics.Columns) { <th><AssetSlot Name="@Mode.ItemSlot(c.Id)" Width="46" Height="34" Class="thumb" /><span class="nm">@c.Name@if (c.Variant.Length > 0) { <text> (@c.Variant)</text> }</span></th> }</tr></thead>
                            <tbody>
                                @foreach (var (name, r) in ethics.Rows.Select(r => (L.Term("species", r.Id, r.Species), r)).OrderBy(x => x.Item1, StringComparer.CurrentCultureIgnoreCase))
                                {
                                    <tr>
                                        <td>@name</td>
                                        @foreach (var (c, ok) in ethics.Columns.Zip(r.Permitted))
                                        {
                                            <td class="@(ok ? "yes" : "no")" title="@L[ok ? "Store.Ethical.Yes" : "Store.Ethical.No", c.Name, name]"><Icon Name="@(ok ? "check" : "xmark")" /></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                }
            </div>
        </article>
    }
    else if (loaded) { <p class="text">@L["Store.None"]</p> }
    else { <div class="skeleton wait"></div> }
</StoreFrame>

@code {
    StoreItem? item;
    bool loaded, signedIn;

    // the corner banner: premium, then sale, then limited, new or community
    string? banner => item is null ? null : item.Banner == "premium" ? "premium" : item.OnSale ? "sale" : item.Banner;

    // the texts of the store's own categories, as StoreFrame has them; an unknown one keeps the catalogue's title
    string Title(ItemFit f) => L["Store.Cat." + f.Key] is { ResourceNotFound: false } s ? s.Value : f.Title;

    // "10 cartridges" in the player's language by the catalogue's unit word; a word with no text stays as the catalogue gives it
    string Units(StoreContents c) => L["Store.Unit." + c.Unit, c.Count] is { ResourceNotFound: false } s ? s.Value : $"{c.Count} {c.Unit}";

    [Parameter] public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        signedIn = await Sessions.CurrentAsync() is not null;
        Service.RefreshOwned();
        await Load();
        loaded = true;
    }

    async Task Load() => item = await Service.ItemAsync(Id);

    void Buy() => Modal.Show<BuyModal>(new Dictionary<string, object?>
    {
        ["Id"] = item!.Id, ["Name"] = item.Name, ["Ems"] = item.Ems, ["Gms"] = item.Gms, ["Owned"] = item.Owned, ["DaysLeft"] = item.DaysLeft, ["Counted"] = item.Counted, ["Expires"] = item.Expires, ["Multi"] = item.MultiBuy,
        ["Bought"] = EventCallback.Factory.Create(this, Load),
    });
}
