@page "/store"
@page "/store/{Key}"
@inject IStoreService Service
@inject ISessionService Sessions
@inject ModalService Modal
@inject HostMode Mode
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@L["Menu.Store"]</PageTitle>

<StoreFrame Active="@key">
    <input id="store-category-search" type="text" placeholder="@L["Store.Search"]" @bind="search" @bind:event="oninput" @bind:after="Reload" />
    @if (rows.Count == 0 && bundles.Count == 0) { <p class="none">@L["Store.None"]</p> }
    <div class="grid">
        @foreach (var i in rows)
        {
            <div class="card panel hover-tint">
                @if (i.OnSale) { <Ribbon Text="@L.SaleTag(i.Sale)" /> }
                <a href="/store/item/@i.Id" title="@L["Store.ClickMore"]"><AssetSlot Name="@Mode.ItemSlot(i.Id)" Width="150" Height="110" Class="pic" /></a>
                <a href="/store/item/@i.Id" class="name">@i.Name</a>
                <span class="variant">@i.Variant</span>
                @if (i.Sale is { } sale) { <p class="ends">@L.SaleEnds(sale)</p> }
                <p class="price">
                    @* an item sold for gm$ alone (the server's catalogue) has no em$ price to show *@
                    @if (i.Ems <= 0 && i.Gms > 0) { if (i.WasGms is { } onlyWas) { <b class="sale">@i.Gms gm$</b> <s>@onlyWas gm$</s> } else { <b>@i.Gms gm$</b> } }
                    else
                    {
                        @if (i.WasEms is { } was) { <b class="sale">@i.Ems em$</b> <s>@was em$</s> } else { <b>@i.Ems em$</b> }
                        @if (i.Gms > 0 && i.WasGms is { } wasGms) { <span>@L["Store.Or"] <b class="sale">@i.Gms gm$</b> <s>@wasGms gm$</s></span> }
                        else if (i.Gms > 0) { <span>@L["Store.Or"] @i.Gms gm$</span> }
                    }
                </p>
                <OwnedLine Owned="i.Owned" Counted="i.Counted" Expires="i.Expires" DaysLeft="i.DaysLeft" Unlimited="i.Unlimited" Fuel="i.Fuel" />
                @if (!signedIn) { <button class="btn" disabled>@L["Store.Login"]</button> }
                else if (!i.Buyable || i.DisabledByServices || i.LimitReached) { <button class="btn" disabled>@L["Store.NotBuyable"]</button> }
                else { <button class="btn btn-primary" @onclick="() => Buy(i)">@L["Store.Buy"]</button> }
            </div>
        }
        @foreach (var b in bundles)
        {
            <div class="card panel hover-tint">
                @if (b.OnSale) { <Ribbon Text="@L.SaleTag(b.Sale)" /> } else { <Ribbon Text="@L["Store.BundleTag"]" Class="blue" /> }
                <a href="/store/bundle/@b.Id" title="@L["Store.ClickMore"]"><AssetSlot Name="@Mode.BundleSlot(b.Id)" Width="150" Height="110" Class="pic" /></a>
                <a href="/store/bundle/@b.Id" class="name">@b.Name</a>
                @if (b.Sale is { } bundleSale) { <p class="ends">@L.SaleEnds(bundleSale)</p> }
                <p class="price">@if (b.StruckPrice > 0) { <b class="sale">@b.Price em$</b> <s>@b.StruckPrice em$</s> } else { <b>@b.Price em$</b> }</p>
                @if (b.OwnedItems > 0 && b.OwnedItems == b.OfItems) { <p class="own">@L["Store.BundleAllOwned"]</p> }
                else if (b.OwnedItems > 0) { <p class="own">@(b.WasPrice > b.Price ? L["Store.BundleOwn", b.OwnedItems, b.OfItems, b.Price, b.WasPrice] : L["Store.BundleOwnCount", b.OwnedItems, b.OfItems])</p> }
                @* a button like BUY on the item cards (same font, centred, upper case); the picture and name stay links *@
                <button class="btn btn-primary" @onclick='() => Nav.NavigateTo($"/store/bundle/{b.Id}")'>@L["Store.Details"].Value.ToUpper(System.Globalization.CultureInfo.CurrentCulture)</button>
            </div>
        }
    </div>
    <Paginator Page="page" Pages="pages" Href='n => "/store/" + key + "?page=" + n' />
</StoreFrame>

@code {
    IReadOnlyList<StoreItem> rows = [];
    IReadOnlyList<StoreBundle> bundles = [];
    string search = "";
    int page = 1, pages = 1;
    bool signedIn, rendered;

    [Parameter] public string? Key { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageNo { get; set; }
    string key => Key ?? "all";

    protected override async Task OnParametersSetAsync()
    {
        signedIn = await Sessions.CurrentAsync() is not null;
        Service.RefreshOwned();
        // no sale: the old store goes to its bundles instead
        if (key == "sales" && !await Service.HasSalesAsync()) { Nav.NavigateTo("/store/bundles", replace: true); return; }
        page = PageNo ?? 1;
        await Load();
        // a new page or category starts at the top, as in the old store
        if (rendered) await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    protected override void OnAfterRender(bool firstRender) => rendered = true;

    async Task Reload() { page = 1; await Load(); }

    async Task Load()
    {
        // the bundles come after the items of "all" (so on its last page), are the whole of "bundles", and those on sale are in "sales"
        var words = search.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var found = key is "all" or "bundles" or "sales" ? (await Service.BundlesAsync()).Where(b => (key != "sales" || b.OnSale) && words.All(w => b.Name.Contains(w, StringComparison.OrdinalIgnoreCase))).ToList() : [];
        if (key == "bundles") { (rows, bundles, pages) = ([], found, 1); return; }
        var p = await Service.ItemsAsync(key, search, page);
        (rows, page, pages) = (p.Rows, p.Number, p.Pages);
        bundles = page == pages ? found : [];
    }

    void Buy(StoreItem i) => Modal.Show<BuyModal>(new Dictionary<string, object?>
    {
        ["Id"] = i.Id, ["Name"] = i.Name, ["Ems"] = i.Ems, ["Gms"] = i.Gms, ["Owned"] = i.Owned, ["DaysLeft"] = i.DaysLeft, ["Counted"] = i.Counted, ["Expires"] = i.Expires, ["Multi"] = i.MultiBuy,
        ["Bought"] = EventCallback.Factory.Create(this, Load),
    });
}
