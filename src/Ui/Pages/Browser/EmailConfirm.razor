@page "/email/verify"
@page "/email/confirm"
@page "/email/change"
@layout BrowserLayout
@inject HostMode Mode
@inject ISignupService Signup
@inject NavigationManager Nav

<PageTitle>@L["App.Name"]</PageTitle>

@* the confirmation call of the old page is held open; the mock answers after a wait, and there is no failure text (as the old) *@
<BrowserNotice Text="@L[done ? "Browser.EmailDone" : "Browser.EmailProgress"]" />

@code {
    bool done;

    // the link of the e-mail: ?code= (all three), ?uuid= and ?src= (a new account)
    [SupplyParameterFromQuery] public string? Code { get; set; }
    [SupplyParameterFromQuery] public string? Uuid { get; set; }
    [SupplyParameterFromQuery] public string? Src { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // dev hook ?mock=browser:hold keeps the progress state (for the comparison)
        if (!firstRender || Mode.Mock == "browser:hold") return;
        await Task.Delay(3000);
        // no failure text, as the old page: a call that fails leaves the notice in progress
        var kind = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('/').Last();
        if (!(await Signup.ConfirmEmailAsync(kind, Code, Uuid, Src)).Ok) return;
        done = true;
        StateHasChanged();
    }
}
