@page "/your-data"

<PageTitle>@L["Data.Title"]</PageTitle>

<div class="page-min">
    <h2 class="page-title">@L["Data.Title"].Value.ToUpper(System.Globalization.CultureInfo.CurrentCulture)</h2>
    <section class="panel box">
        <p>@L["Data.Intro"]</p>
        <h3>@L["Data.Stored.Title"]</h3>
        <ul>
            <li>@L["Data.Stored.Steam"]</li>
            <li>@L["Data.Stored.Handle"]</li>
            <li>@L["Data.Stored.Game"]</li>
            <li>@L["Data.Stored.Zip"]</li>
            <li>@L["Data.Stored.Sessions"]</li>
        </ul>
        <h3>@L["Data.Never.Title"]</h3>
        <p>@L["Data.Never.Text"]</p>
        <h3>@L["Data.Delete.Title"]</h3>
        <p>@L["Data.Delete.Text"]</p>
        <p>@L["Data.Operator"]</p>
        <h3>@L["Data.Reports.Title"]</h3>
        <p>@L["Data.Reports.Launcher"]</p>
        <p>@L["Data.Reports.Game"]</p>
        <h3>@L["Data.Who.Title"]</h3>
        <p>@L["Data.Who.Text"]</p>
        <h3>@L["Data.Why.Title"]</h3>
        <p>@L["Data.Why.Text"]</p>
        <h3>@L["Data.Keep.Title"]</h3>
        <ul>
            <li>@L["Data.Keep.Account"]</li>
            <li>@L["Data.Keep.Copies"]</li>
            <li>@L["Data.Keep.Logs"]</li>
        </ul>
        <h3>@L["Data.Others.Title"]</h3>
        <ul>
            <li>@L["Data.Others.Host"]</li>
            <li>@L["Data.Others.Cloudflare"]</li>
            <li>@L["Data.Others.Discord"]</li>
            <li>@L["Data.Others.Multi"]</li>
        </ul>
        <h3>@L["Data.Rights.Title"]</h3>
        <p>@L["Data.Rights.Text"]</p>
    </section>
</div>
