@page "/download"

<PageTitle>@L["Menu.Downloads"]</PageTitle>

@{ var support = L["Download.Trouble.Step5", "|"].Value.Split('|'); }

<div class="page-min">
    <h2 class="page-title">@L["Download.Title"].Value.ToUpper(System.Globalization.CultureInfo.CurrentCulture)</h2>
    <section class="box panel">
        <h3>@L["Download.Multi.Title"]</h3>
        <p><b>@L["Download.Req.SupportedOs"]</b> @L["Download.Req.OsMulti"] <b>@L["Download.Req.Cpu"]</b> @L["Download.Req.CpuMulti"]<br />
            <b>@L["Download.Req.Memory"]</b> @L["Download.Req.MemoryValue"]<br />
            <b>@L["Download.Req.Graphics"]</b> @L["Download.Req.GraphicsMulti"]<br />
            <b>@L["Download.Req.Resolution"]</b> @L["Download.Req.ResolutionValue"]<br />
            <b>@L["Download.Req.Internet"]</b> @L["Download.Req.InternetClient"]<br />
            <b>@L["Download.Req.Host"]</b> @L["Download.Req.HostValue"]<br />
            <b>@L["Download.Req.HostFps"]</b> @L.Html("Download.Req.HostFpsText", "<b>", "</b>") <ExternalLink Key="fps_tool">@L["Download.Req.FpsTool"]</ExternalLink><br />
            <b>@L["Download.Req.Os"]</b> @L["Download.Req.OsAll"]</p>
        <h3>@L["Download.Single.Title"]</h3>
        <p><b>@L["Download.Req.SupportedOs"]</b> @L["Download.Req.OsAll"]<br />
            <b>@L["Download.Req.Cpu"]</b> @L["Download.Req.CpuSingle"]<br />
            <b>@L["Download.Req.Memory"]</b> @L["Download.Req.MemoryValue"]<br />
            <b>@L["Download.Req.Graphics"]</b> @L["Download.Req.GraphicsSingle"]<br />
            <b>@L["Download.Req.Resolution"]</b> @L["Download.Req.ResolutionValue"]<br />
            <b>@L["Download.Req.Internet"]</b> @L["Alert.Yes"]</p>
        <p class="plain">@L["Download.Size"]</p>
        <ExternalLink Key="steam_store" Class="btn btn-primary btn-large get">@L["Download.Click"] <Icon Name="download" /></ExternalLink>
    </section>
    <section class="box panel"><h3>@L["Download.Step", 2]</h3><p class="plain">@L["Download.Step2.Text"]</p></section>
    <section class="box panel"><h3>@L["Download.Step", 3]</h3><p class="plain">@L.Html("Download.Step3.Text", "<a href=\"/dashboard\">" + System.Net.WebUtility.HtmlEncode(L["Menu.HuntNow"].Value) + "</a>")</p></section>
    <section class="box panel">
        <h3>@L["Download.Trouble.Title"]</h3>
        <p class="plain">@L["Download.Trouble.Intro"]</p>
        <ul>
            <li>@L["Download.Trouble.Step1"]</li>
            <li>@L["Download.Trouble.Step2"] <b>@L["Download.Trouble.Path"]</b></li>
            <li>@L["Download.Trouble.Step3"]</li>
            <li>@L["Download.Trouble.Step4"]</li>
            <li>@support[0]<ExternalLink Key="support_request">@support[1]</ExternalLink>@support[2]</li>
        </ul>
        <ExternalLink Key="health_utility">@L["Download.Trouble.Utility"]</ExternalLink>
    </section>
</div>

