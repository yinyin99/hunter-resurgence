@implements IDisposable
@inject Branding Brand

@{ var cur = Posts[index]; }

<div class="carousel">
    <div class="slide">
        <NewsPicture Picture="@cur.Picture" Width="805" Height="380" Class="image" />
        <span class="date">@Fmt.MonthDay(cur.Published.UtcDateTime)</span>
        <div class="caption">
            <h2>@Brand.Expand(cur.Title)</h2>
            <p>
                @NewsMarkdown.Lead(Brand.Expand(cur.Body)) @(" ")
                <a href="#@cur.Anchor">@L["News.ReadIt"]</a>
                <Icon Name="chevron-right" />
            </p>
        </div>
    </div>
    <div class="thumbs">
        @for (var i = 0; i < Posts.Count; i++)
        {
            var n = i;
            var title = Brand.Expand(Posts[i].Title);
            <button type="button" class="thumb" aria-label="@title" @onclick="() => Select(n)"><NewsPicture Picture="@Posts[i].Picture" Width="175" Height="95" /></button>
        }
    </div>
</div>

@code {
    /// <summary>One slide per post, in the feed's order; at least one.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<NewsPost> Posts { get; set; } = [];

    int index;
    PeriodicTimer? timer;

    /// <summary>The slides change every 18 seconds, as in the old feed.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = Run();
    }

    async Task Run()
    {
        var t = timer = new(TimeSpan.FromSeconds(18));
        while (await t.WaitForNextTickAsync())
        {
            index = (index + 1) % Posts.Count;
            await InvokeAsync(StateHasChanged);
        }
    }

    // a click on another slide's preview shows it and starts the 18 seconds again
    void Select(int n)
    {
        if (n == index) return;
        index = n;
        timer?.Dispose();
        _ = Run();
    }

    public void Dispose() => timer?.Dispose();
}
