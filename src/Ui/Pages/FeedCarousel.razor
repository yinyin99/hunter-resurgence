@implements IDisposable

@{ var cur = slides[index]; }

<div class="carousel">
    <div class="slide">
        <AssetSlot Name="@cur.Picture" Width="805" Height="380" Class="image" />
        <span class="date">@Fmt.MonthDay(cur.When)</span>
        <div class="caption">
            <h2>@L[$"News.{cur.Id}.Title"]</h2>
            <p>
                @L[$"News.{cur.Id}.Lead"] @(" ")
                <a href="#@cur.Anchor">@L["News.ReadIt"]</a>
                <Icon Name="chevron-right" />
            </p>
        </div>
    </div>
    <div class="thumbs">
        @for (var i = 0; i < slides.Count; i++)
        {
            var n = i;
            var title = L[$"News.{slides[i].Id}.Title"].Value;
            <button type="button" class="thumb" aria-label="@title" @onclick="() => Select(n)"><AssetSlot Name="@slides[i].Picture" Width="175" Height="95" /></button>
        }
    </div>
</div>

@code {
    // one slide per post, in the feed's order
    static readonly IReadOnlyList<NewsPost> slides = NewsPosts.All;
    int index;
    PeriodicTimer? timer;

    /// <summary>The slides change every 18 seconds, as in the old feed.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = Run();
    }

    async Task Run()
    {
        var t = timer = new(TimeSpan.FromSeconds(18));
        while (await t.WaitForNextTickAsync())
        {
            index = (index + 1) % slides.Count;
            await InvokeAsync(StateHasChanged);
        }
    }

    // a click on another slide's preview shows it and starts the 18 seconds again
    void Select(int n)
    {
        if (n == index) return;
        index = n;
        timer?.Dispose();
        _ = Run();
    }

    public void Dispose() => timer?.Dispose();
}
