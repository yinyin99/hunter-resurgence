@page "/tutorials"
@inject IServersService Service
@inject ModalService Modal
@inject IGameSettingsService GameSettings
@inject Branding Brand
@inject ISeasonalEventsService Events

<PageTitle>@L["Menu.Tutorials"]</PageTitle>

<div class="tutorials">
<p class="intro">@L["Tut.Intro"]</p>
<EventSwitch @bind-State="seasonal" Reserves="reservesList" />
<div class="cards">
    @foreach (var t in tutorials)
    {
        <section>
            <h4>@t.Title</h4>
            <p>@Brand.Expand(t.Description)</p>
            <p class="where">@L["Tut.Location", reserves.GetValueOrDefault(t.Reserve, "")]</p>
            <button class="btn btn-primary btn-large btn-block" @onclick="() => Start(t)">@L["Tut.Start"]</button>
        </section>
    }
</div>
</div>

@code {
    IReadOnlyList<Tutorial> tutorials = [];
    Dictionary<int, string> reserves = [];
    IReadOnlyList<Reserve> reservesList = [];
    SeasonalEvents seasonal = new(true, null, []);

    protected override async Task OnInitializedAsync()
    {
        reservesList = await Service.ReservesAsync();
        reserves = reservesList.ToDictionary(r => r.Id, r => r.Name);
        seasonal = await Events.GetAsync();
        tutorials = await Service.TutorialsAsync();
    }

    async Task Start(Tutorial t)
    {
        if (!await Modal.SetUpFirst(GameSettings)) return;
        var r = await Service.StartTutorialAsync(t.Id);
        if (!r.Ok) Modal.Alert(L[r.Error ?? "Launch.Failed"]);
    }
}
