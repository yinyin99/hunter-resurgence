@page "/players/{Handle}/hunts"
@using Resurgence.Ui.Players

@if (player is null)
{
    <NotFoundNotice />
}
else
{
    <PlayerHeader Player="player" Tab="hunts" />

    @if (hunts.Count == 0)
    {
        <p class="empty">@L["Hunts.None"]</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        <th scope="col">@L["Hunts.Date"]</th>
                        <th scope="col">@L["Hunts.Reserve"]</th>
                        <th scope="col" class="num">@L["Hunts.Duration"]</th>
                        <th scope="col" class="num">@L["Hunts.Kills"]</th>
                        <th scope="col" class="num">@L["Hunts.BestScore"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in hunts)
                    {
                        <tr>
                            <td><a href="/hunts/@h.Id">@h.Date.ToString("d")</a></td>
                            <td>@h.Reserve</td>
                            <td class="num mono">@L["Hunts.Minutes", h.DurationMin]</td>
                            <td class="num mono">@h.Kills.Count</td>
                            <td class="num mono">@h.BestScore</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public string Handle { get; set; } = "";

    PlayerProfile? player;
    IReadOnlyList<HuntRecord> hunts = [];

    protected override void OnParametersSet()
    {
        player = SampleData.FindPlayer(Handle);
        hunts = player is null ? [] : SampleData.HuntsOf(player.Handle);
    }
}
