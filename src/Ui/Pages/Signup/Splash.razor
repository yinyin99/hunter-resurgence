@page "/splash"
@layout SignupLayout
@inject NavigationManager Nav
@inject HostMode Mode
@inject ModalService Modal
@inject IKitService Kit
@inject ICleanupService Cleanup
@inject ISteamOptionService SteamOption
@inject Branding Brand

<PageTitle>@L["Splash.Loading"]</PageTitle>

<div class="su-splash">
    <div class="logo @(Error is null ? "" : "error")"><AssetSlot Name="logo-splash" Width="483" Height="65" /></div>
    @if (Error is not null) { <div class="message"><h1>@L["Splash.Error"]</h1><div>@Brand.Expand(Error)</div></div> }
</div>

@code {
    /// <summary>The launcher tells why it cannot go on as "code: message" (a missing game, no Steam); the splash then stays.</summary>
    [SupplyParameterFromQuery] public string? Error { get; set; }

    // the old launcher shows a local splash before the signup page loads; here it is the first paint of the start (mock start:hold keeps it for the comparison)
    // On the way the player kit starts: its setup dialog opens over the next page when this PC still needs setup, and after it the one for Steam's Play button. After an install an "older setup found" dialog comes first.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Error is not null) return;
        await Modal.OfferCleanupAsync(Cleanup, Kit, SteamOption);
        if (Mode.Mock != "start:hold") Nav.NavigateTo("/signup/start", replace: true);
    }
}
