@page "/signup/page4"
@layout SignupLayout
@inherits PatchWatcher
@inject ISignupService Signup
@inject IServersService Servers
@inject ModalService Modal
@inject NavigationManager Nav

<PageTitle>@L[confirmed ? "Signup.P4.ConfirmedTitle" : "Signup.P4.Title"]</PageTitle>

<SignupCard Title="@L[confirmed ? "Signup.P4.ConfirmedTitle" : "Signup.P4.Title"]" Art="signup-bg-5" Class="@("p4 " + (confirmed ? "confirmed" : ""))">
    <div class="su-gift"><AssetSlot Name="gift-frame" Width="561" Height="288" /><AssetSlot Name="gift-membership" Width="441" Height="149" Class="item" /></div>
    <Paper X="621" Y="202">@(confirmed ? L["Signup.P4.Confirmed"] : L["Signup.P4.Text", email])</Paper>
    <div class="su-row">
        @if (!confirmed)
        {
            <button type="button" class="su-btn medium" @onclick="Change">@L["Signup.P4.Change"]</button>
            <button type="button" class="su-btn medium" @onclick="Resend">@L["Signup.P4.Resend"]</button>
        }
        <button type="button" class="su-btn large" disabled="@(!ready)" @onclick="Launch">@L["Signup.P4.Launch"]</button>
        @if (!confirmed)
        {
            <button type="button" class="su-btn medium su-cog" aria-label="@L["Signup.P4.Settings"]" @onclick="Settings"><Icon Name="gear" /></button>
        }
    </div>
</SignupCard>

@code {
    readonly CancellationTokenSource polling = new();
    string email = "";
    bool confirmed;

    // like the hunt of page5 the tutorial starts once the game is installed and patched
    bool ready => Status.State is PatchState.Ready or PatchState.Done;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        (email, confirmed) = (await Signup.EmailAsync(), await Signup.EmailConfirmedAsync());
        if (!confirmed) _ = Poll();
    }

    /// <summary>The confirmation is looked up after a second and then every five seconds.</summary>
    async Task Poll()
    {
        try
        {
            await Task.Delay(1000, polling.Token);
            while (!confirmed)
            {
                confirmed = await Signup.EmailConfirmedAsync();
                await InvokeAsync(StateHasChanged);
                if (!confirmed) await Task.Delay(5000, polling.Token);
            }
        }
        catch (OperationCanceledException) { }
    }

    void Change() => Modal.Show<ChangeEmailDialog>(new Dictionary<string, object?> { [nameof(ChangeEmailDialog.Changed)] = EventCallback.Factory.Create<string>(this, e => email = e) }, "none");

    async Task Resend()
    {
        if ((await Signup.ResendEmailAsync()).Ok) Modal.Show<MessageDialog>(backdrop: "none");
    }

    void Settings() => Modal.Show<TutorialDialog>(backdrop: "none");

    async Task Launch()
    {
        await Servers.StartTutorialAsync(1);
        Nav.NavigateTo("/signup/page5");
    }

    public override void Dispose()
    {
        polling.Cancel();
        base.Dispose();
    }
}
