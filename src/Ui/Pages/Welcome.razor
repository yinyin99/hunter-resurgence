@page "/welcome"
@inject ISessionService Sessions
@inject IAccountService Account

<PageTitle>@L["Welcome.Title"]</PageTitle>

<div class="page-min">
    <h2 class="page-title">@(L["Welcome.Title"].Value.ToUpper(System.Globalization.CultureInfo.CurrentCulture))</h2>
    <div class="who">
        <AssetSlot Name="@avatar" Width="80" Height="80" />
        <h2>@L.Frag("Welcome.Congrats", Profile())</h2>
    </div>
    <p class="text">@L["Welcome.Intro"]</p>
    <h4>@L["Welcome.Retail"]</h4>
    <p class="text">@L.Html("Welcome.RetailText", "<a href=\"#\" id=\"activation\">", "</a>")</p>
    <div class="cards">
        @Card("Welcome.Tutorials", "/tutorials", "Welcome.TutorialsGo", null)
        @Card("Welcome.Hunting", "/dashboard", "Welcome.HuntingGo", null)
        @Card("Welcome.Downloads", "/download", "Welcome.DownloadsGo", "download")
        @Card("Welcome.Settings", "/settings", "Welcome.SettingsGo", null)
        @Card("Welcome.Profile", "/profile/" + handle, "Welcome.ProfileGo", "user")
        @Card("Welcome.Help", "/help", "Welcome.HelpGo", null)
    </div>
</div>

@code {
    string handle = "", avatar = "avatar-current";
    RenderFragment Profile() => @<a href="/profile/@handle">@handle</a>;

    protected override async Task OnInitializedAsync()
    {
        handle = (await Sessions.CurrentAsync())?.Handle ?? "";
        avatar = (await Account.AccountAsync()).Avatar;
    }

    RenderFragment Card(string key, string href, string go, string? icon) => @<section class="card panel">
        <h3>@L[key]</h3>
        <p>@L[key + "Text"]</p>
        @if (icon is not null) { <Icon Name="@icon" /> }
        <a class="btn btn-primary" href="@href">@L[go] <Icon Name="chevron-right" /></a>
    </section>;
}
