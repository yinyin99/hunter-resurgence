@page "/restore"
@using Resurgence.Ui.Pages.RestoreProto
@inject IRestoreService Service
@inject HostMode Host

<PageTitle>@L["Restore.Title"]</PageTitle>

@* PROTOTYPE (UI.md sub-shape A): the data is loaded as before; ?variant= (0 = today's page, A, B, C) picks the markup, and, in Development, ?state= / ?claim= swap in stub data
   (RestoreModel.LoadFake: read-only, no service call). The bar below flips between them. *@
<div class="page-min">
    <h2 class="page-title">@L["Restore.Title"].Value.ToUpper(System.Globalization.CultureInfo.CurrentCulture)</h2>
    @if (m is not null)
    {
        @switch (variant)
        {
            case "0": <RestoreCurrent M="m" /> break;
            case "B": <RestoreB @key="loadKey" M="m" /> break;
            case "C": <RestoreC M="m" /> break;
            default: <RestoreA M="m" /> break;
        }
        <RestoreDelete M="m" />
    }
</div>
@if (Host.Dev)
{
    <PrototypeSwitcher Keys="Variants" Current="@variant" Names="VariantNames" States="RestoreModel.States" State="@State" />
}

@code {
    static readonly string[] Variants = ["0", "A", "B", "C"];
    static readonly Dictionary<string, string> VariantNames = new() { ["0"] = "Today's page", ["A"] = "Status first, timeline", ["B"] = "Step wizard", ["C"] = "Two columns, inbox" };

    [SupplyParameterFromQuery] public string? Variant { get; set; }
    [SupplyParameterFromQuery] public string? State { get; set; }
    [SupplyParameterFromQuery] public string? Claim { get; set; }

    RestoreModel? m;
    string? loadKey;
    string variant => Host.Dev && Variant is { } v && Variants.Contains(v) ? v : "A";

    protected override async Task OnParametersSetAsync()
    {
        m ??= new(Service, L, () => InvokeAsync(StateHasChanged));
        // stub data only in Development; a stub state resets the variant's own state (the wizard's step) through @key
        var key = Host.Dev && (State is not null || Claim is not null) ? $"{State ?? "empty"}/{Claim ?? "open"}" : "";
        if (key == loadKey) return;
        loadKey = key;
        if (key.Length == 0) await m.LoadAsync();
        else m.LoadFake(State ?? "empty", Claim ?? "open");
    }

}
