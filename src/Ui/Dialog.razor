@* Blazor-rendered modal overlay: interactive hosts only (the launcher). Escape and the close button call OnClose. *@
@if (Open)
{
    <div class="dialog-backdrop" @onclick="OnClose">
        <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="@titleId" tabindex="-1"
             @onclick:stopPropagation @onkeydown="Key">
            <div class="dialog-header">
                <h2 id="@titleId">@Title</h2>
                <button type="button" class="btn btn-ghost" aria-label="@L["Dialog.Close"]" @onclick="OnClose">&#x2715;</button>
            </div>
            <div class="dialog-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="dialog-footer">@Footer</div>
            }
        </div>
    </div>
}

@code {
    readonly string titleId = "dlg-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public bool Open { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    Task Key(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
