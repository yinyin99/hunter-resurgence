<a class="card trophy" href="/kills/@Trophy.Id">
    <div class="art" aria-hidden="true">@Glyph</div>
    <h3>
        <span>@Trophy.Species</span>
        <span class="badge accent" title="@L["Trophies.Score"]">@Trophy.Score</span>
    </h3>
    @if (Compact)
    {
        <p class="muted">@Trophy.Reserve, @Trophy.Date.ToString("d")</p>
    }
    else
    {
        <dl>
            <dt>@L["Trophies.Weight"]</dt><dd>@L["Players.Kg", Trophy.WeightKg]</dd>
            <dt>@L["Trophies.Weapon"]</dt><dd>@Trophy.Weapon</dd>
            <dt>@L["Trophies.Reserve"]</dt><dd>@Trophy.Reserve</dd>
            <dt>@L["Trophies.Date"]</dt><dd>@Trophy.Date.ToString("d")</dd>
        </dl>
    }
</a>

@code {
    [Parameter, EditorRequired] public Trophy Trophy { get; set; } = null!;
    /// <summary>Short card for the overview strip: only reserve and date.</summary>
    [Parameter] public bool Compact { get; set; }

    // initials of the species name stand in for artwork
    string Glyph => string.Concat(Trophy.Species.Split(' ').Take(2).Select(w => w[0]));
}
