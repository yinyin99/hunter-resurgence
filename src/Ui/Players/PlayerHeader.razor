<PageTitle>@Player.Handle - @Section - @L["App.Name"]</PageTitle>
<header class="player-header">
    <Avatar Handle="@Player.Handle" Class="lg" />
    <div>
        <h1>@Player.Handle</h1>
        <p class="muted row meta">
            <span>@L["Players.MemberSince", Player.MemberSince.ToString("y")]</span>
            <span class="row">
                <span class="dot @(Player.Online ? "online" : "offline")"></span>
                @if (Player.Online) { <span>@L["Common.Online"]</span> } else { <span>@L["Common.Offline"]</span> }
            </span>
        </p>
    </div>
</header>
<nav class="tabs" aria-label="@L["Players.Sections"]">
    <a class="@Css("overview")" href="/players/@Player.Handle" aria-current="@Current("overview")">@L["Players.Tab.Overview"]</a>
    <a class="@Css("trophies")" href="/players/@Player.Handle/trophies" aria-current="@Current("trophies")">@L["Players.Tab.Trophies"]</a>
    <a class="@Css("hunts")" href="/players/@Player.Handle/hunts" aria-current="@Current("hunts")">@L["Players.Tab.Hunts"]</a>
</nav>

@code {
    [Parameter, EditorRequired] public PlayerProfile Player { get; set; } = null!;
    /// <summary>"overview", "trophies" or "hunts".</summary>
    [Parameter, EditorRequired] public string Tab { get; set; } = "overview";

    string Section => Tab switch { "trophies" => L["Players.Tab.Trophies"], "hunts" => L["Players.Tab.Hunts"], _ => L["Players.Tab.Overview"] };
    string Css(string tab) => tab == Tab ? "tab active" : "tab";
    string? Current(string tab) => tab == Tab ? "page" : null;
}
