@inject NavigationManager Nav

<PageHeader Title="@L["NotFound.Title"]" Lead="@L["NotFound.Lead"]" />
<p><a href="/leaderboards">@L["Nav.Leaderboards"]</a></p>

@code {
    // static SSR (the website): answer HTTP 404; the interactive launcher keeps this friendly message
    protected override void OnInitialized()
    {
        if (!RendererInfo.IsInteractive) Nav.NotFound();
    }
}
