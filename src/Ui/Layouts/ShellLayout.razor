@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject HostMode Mode
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ModalService Modal
@inject ISessionService Sessions

<div class="shell @(Mode.Launcher ? "launcher" : "web")">
    @if (isPublic)
    {
        <PublicBar />
    }
    else
    {
        <StatusBar Session="session" Quick="quick" />
    }
    <div class="page @(isPublic ? "public" : "")">
        @if (!isPublic) { <MenuBar Hidden="quick" /> }
        <div class="body">
            <main @key="isPublic">@Body</main>
            <aside class="sidebar"></aside>
        </div>
        <Footer />
    </div>
    <ModalHost />
    @if (Mode.Launcher) { <PatchPanel /> }
</div>

@code {
    IJSObjectReference? module;
    DotNetObjectReference<ShellLayout>? self;
    bool quick, alerted;
    Session? session;
    Action? changed;

    /// <summary>The website without a session shows the public top bar and no menu.</summary>
    bool isPublic => !Mode.Launcher && session is null;

    [SupplyParameterFromQuery(Name = "alert")] public string? DevAlert { get; set; }
    /// <summary>Development only: ?modal=settings or ?modal=initial opens the game settings dialog (as the first start does).</summary>
    [SupplyParameterFromQuery(Name = "modal")] public string? DevModal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        session = await Sessions.CurrentAsync();
        Sessions.Changed += changed = async () => await InvokeAsync(async () =>
        {
            session = await Sessions.CurrentAsync();
            StateHasChanged();
        });
    }

    protected override void OnParametersSet()
    {
        if (Mode.Dev && DevAlert is not null && !alerted) { alerted = true; Modal.Alert(DevAlert); }
        if (Mode.Dev && DevModal is "settings" or "initial" && !alerted) { alerted = true; Modal.Show<GameSettingsModal>(new Dictionary<string, object?> { [nameof(GameSettingsModal.FirstStart)] = DevModal == "initial" }); }
        // launcher-only routes and signed-in routes are not served to the public website: back to the feed
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (!Mode.Launcher && (LauncherGuard.Blocks(path) || session is null && LauncherGuard.NeedsSession(path))) Nav.NavigateTo("/feed", replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Mode.Launcher) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Resurgence.Ui/shell.js");
        await module.InvokeVoidAsync("watchScroll", self = DotNetObjectReference.Create(this), 200);
    }

    /// <summary>Called by shell.js when the scroll position crosses 200 px.</summary>
    [JSInvokable]
    public void Scrolled(bool past)
    {
        if (quick == past) return;
        quick = past;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Sessions.Changed -= changed;
        self?.Dispose();
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("unwatchScroll");
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { } // the circuit is already gone: nothing to clean up in the browser
    }
}
