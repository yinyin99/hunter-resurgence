<footer class="footer">
    <div class="columns">
        <section>
            <h4>@L["Footer.DevelopedBy"]</h4>
            <a class="github" href="https://github.com/yinyin99" target="_blank" rel="noopener"><Icon Name="github" /> yinyin99</a>
        </section>
        <section>
            <h4>@L["Footer.Follow"]</h4>
            <div class="follow">
                <ExternalLink Key="source"><Icon Name="github" /></ExternalLink>
                <ExternalLink Key="discord"><Icon Name="discord" /></ExternalLink>
            </div>
        </section>
        <section>
            <h4>@L["Footer.Ratings"]</h4>
            <div class="ratings">
                @foreach (var n in new[] { 1, 2, 3, 4 }) { <AssetSlot Name="@($"logo-rating-{n}")" Width="62" Height="82" /> }
            </div>
        </section>
    </div>
    <div class="legal">
        <a href="/your-data">@L["Footer.Privacy"]</a>
        <a href="/terms">@L["Footer.Terms"]</a>
        @* the attribution that copies and modified versions must keep (AGPL-3.0 section 7(b), README "Disclaimer and license"); a name, so never translated *@
        <a class="credit" href="https://github.com/yinyin99/hunter-resurgence" target="_blank" rel="noopener">Hunter Resurgence © yinyin99</a>
    </div>
</footer>
