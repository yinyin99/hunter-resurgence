@inject HostMode Mode
@inject ModalService Modal
@inject ILauncherBridge Bridge
@inject IKitService Kit

<ul class="settings-menu">
    <li><a href="/settings">@L["Settings.Account"]</a></li>  @* the settings page: the avatar works, its other items show disabled *@
    @* could be built later (the lodges and bait sites the server keeps): shown disabled *@
    <li class="off" aria-disabled="true" title="@L["Settings.ComingLater"]"><span>@L["Settings.GameManagement"]</span><span class="sr"> (@L["Settings.ComingLater"])</span></li>
    <li><a href="/restore">@L["Settings.Restore"]</a></li>
    <li><a href="#" @onclick="() => Modal.Show<LanguageModal>()" @onclick:preventDefault>@L["Settings.Language"]</a></li>
    @if (Mode.Launcher)
    {
        <li><a href="#" id="seasonal-events" @onclick="() => Modal.Show<SeasonalEventsModal>()" @onclick:preventDefault>@L["Settings.SeasonalEvents"]</a></li>  @* the website has no item: hunts start in the launcher, where the launch map shows the same box while an event runs *@
        <li class="launcher-item"><a href="#" id="game-settings" @onclick="() => Modal.Show<GameSettingsModal>()" @onclick:preventDefault>@L["Settings.GameSettings"]</a></li>
        <li><a href="#" id="steam-option" @onclick="() => Modal.Show<SteamOptionModal>()" @onclick:preventDefault>@L["Settings.SteamOption"]</a></li>
        <li><a href="#" @onclick='() => Show(Bridge.OpenFolder("screenshots"))' @onclick:preventDefault>@L["Settings.Screenshots"]</a></li>
        <li><a href="#" @onclick='() => Show(Bridge.OpenFolder("logs"))' @onclick:preventDefault>@L["Settings.Logfiles"]</a></li>
        <li><a href="#" id="report-problem" @onclick="() => Modal.Show<ReportModal>()" @onclick:preventDefault>@L["Report.Menu"]</a></li>
        <li><a href="#" id="game-folder" @onclick="() => Modal.Show<GameFolderModal>()" @onclick:preventDefault>@L["Settings.GameFolder"]</a></li>
        <li><a href="#" @onclick='() => Show(Bridge.ClearCache("launcher"))' @onclick:preventDefault>@L["Settings.ClearLauncherCache"]</a></li>
        <li><a href="#" @onclick='() => Show(Bridge.ClearCache("game"))' @onclick:preventDefault>@L["Settings.ClearGameCache"]</a></li>
        @if (Kit.Available)
        {
            <li><a href="#" @onclick="SetUp" @onclick:preventDefault>@L["Settings.KitSetup"]</a></li>
            <li><a href="#" @onclick="Remove" @onclick:preventDefault>@L["Settings.KitRemove"]</a></li>
        }
    }
</ul>

@code {
    // a refused folder or cache action says why (the error is a text key)
    void Show(Result r)
    {
        if (!r.Ok) Modal.Alert(L[r.Error!]);
    }

    // setup again replaces everything it made (a new certificate); a settings.json without a usable server_url or *_host says so
    void SetUp()
    {
        try { Modal.Show<KitSetupModal>(new Dictionary<string, object?> { [nameof(KitSetupModal.Plan)] = Kit.Plan() }); }
        catch (InvalidOperationException e) { Modal.Alert(e.Message); }
    }

    async Task Remove()
    {
        if (!await Modal.Confirm(L["Kit.RemoveConfirm"])) return;
        var r = await Kit.RemoveAsync();
        Modal.Alert(r.Ok ? L["Kit.Removed"].Value : r.Error!);
    }
}
