@inject HostMode Mode
@inject ModalService Modal
@inject ILauncherBridge Bridge
@inject IKitService Kit

<ul class="settings-menu">
    @if (!Mode.Live)
    {
        <li><a href="/settings">@L["Settings.Account"]</a></li>
        <li><a href="/game-management">@L["Settings.GameManagement"]</a></li>
    }
    <li><a href="/restore">@L["Settings.Restore"]</a></li>
    <li><a href="#" @onclick="() => Modal.Show<LanguageModal>()" @onclick:preventDefault>@L["Settings.Language"]</a></li>
    @if (Mode.Launcher)
    {
        <li class="launcher-item"><a href="#" id="game-settings" @onclick="() => Modal.Show<GameSettingsModal>()" @onclick:preventDefault>@L["Settings.GameSettings"]</a></li>
        <li><a href="#" @onclick='() => Bridge.OpenFolder("screenshots")' @onclick:preventDefault>@L["Settings.Screenshots"]</a></li>
        <li><a href="#" @onclick='() => Bridge.OpenFolder("logs")' @onclick:preventDefault>@L["Settings.Logfiles"]</a></li>
        <li><a href="#" @onclick='() => Bridge.OpenFolder("game")' @onclick:preventDefault>@L["Settings.GameFolder"]</a></li>
        <li><a href="#" @onclick='() => Bridge.ClearCache("launcher")' @onclick:preventDefault>@L["Settings.ClearLauncherCache"]</a></li>
        <li><a href="#" @onclick='() => Bridge.ClearCache("game")' @onclick:preventDefault>@L["Settings.ClearGameCache"]</a></li>
        @if (Kit.Available)
        {
            <li><a href="#" @onclick="SetUp" @onclick:preventDefault>@L["Settings.KitSetup"]</a></li>
            <li><a href="#" @onclick="Remove" @onclick:preventDefault>@L["Settings.KitRemove"]</a></li>
        }
    }
</ul>

@code {
    // setup again replaces everything it made (a new certificate); a settings.json without a usable server_url or *_host says so
    void SetUp()
    {
        try { Modal.Show<KitSetupModal>(new Dictionary<string, object?> { [nameof(KitSetupModal.Plan)] = Kit.Plan() }); }
        catch (InvalidOperationException e) { Modal.Alert(e.Message); }
    }

    async Task Remove()
    {
        if (!await Modal.Confirm(L["Kit.RemoveConfirm"])) return;
        var r = await Kit.RemoveAsync();
        Modal.Alert(r.Ok ? L["Kit.Removed"].Value : r.Error!);
    }
}
