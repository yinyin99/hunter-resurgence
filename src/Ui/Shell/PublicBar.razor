@inject ISessionService Sessions
@inject NavigationManager Nav

<header class="public">
    <div class="inner">
        <a class="logo" href="/feed"><AssetSlot Name="logo-large" Width="300" Height="50" /></a>
        <div class="signin">
            @if (SignInUrl is { } url)
            {
                @* the community server signs in: a full page load to Steam and back (Blazor's router would take a plain link for a page) *@
                <a class="toggle" href="@url" @onclick="SignIn" @onclick:preventDefault><span class="ask">@L["Public.Already"]</span> <span class="in">@L["Public.SignIn"]</span></a>
            }
            else
            {
            <button type="button" class="toggle" popovertarget="signin"><span class="ask">@L["Public.Already"]</span> <span class="in">@L["Public.SignIn"]</span> <Icon Name="caret-down" /></button>
            <form id="signin" class="panel" popover @onsubmit="Submit" novalidate>
                @if (!codeSent)
                {
                    <input class="field-light" type="text" name="email" autocomplete="email" placeholder="@L["Signin.Email"]" @bind="email" @bind:event="oninput" />
                }
                else
                {
                    <input class="field-light" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" placeholder="@L["Signin.Code"]" @bind="code" @bind:event="oninput" />
                    <p class="hint">@L["Signin.Sent", email]</p>
                }
                @if (error is not null) { <div class="error" role="alert">@L[error]</div> }
                <div class="row">
                    @if (codeSent) { <a href="#" @onclick="Back" @onclick:preventDefault>@L["Signin.Back"]</a> }
                    <button type="submit" class="btn btn-primary">@L[codeSent ? "Signin.Submit" : "Signin.SendCode"]</button>
                </div>
            </form>
            }
        </div>
    </div>
</header>

@code {
    /// <summary>Where the community server signs in and comes back to the page the player is on; null: the e-mail panel.</summary>
    string? SignInUrl => Sessions.SignInUrl("/" + Nav.ToBaseRelativePath(Nav.Uri));

    // read again at the click: the bar is not rendered again when the page changes
    void SignIn() => Nav.NavigateTo(SignInUrl!, forceLoad: true);

    bool codeSent;
    string email = "", code = "";
    string? error;

    /// <summary>Step 1 asks for the e-mail address, step 2 for the one-time code; a good code signs in (the shell then shows the signed-in bar).</summary>
    async Task Submit()
    {
        var result = codeSent ? await Sessions.SignInAsync(email, code) : await Sessions.RequestCodeAsync(email);
        error = result.Error;
        if (!result.Ok) return;
        if (codeSent) { codeSent = false; code = ""; }
        else codeSent = true;
    }

    void Back()
    {
        codeSent = false;
        code = "";
        error = null;
    }
}
