@inject ISessionService Sessions

@* every page, for a signed-in hunter who has not linked Discord: a slim pill centred between the top bar and the menu bar, on the website and in the launcher *@
@if (DiscordOffer.Shown(Session, Sessions))
{
    <div class="host">
        <DiscordLinkButton Title="@L["Discord.LinkPill"]" Class="btn btn-large discord-pill"><span class="text">@L["Discord.LinkPill"]</span></DiscordLinkButton>
    </div>
}

@code {
    [Parameter] public Session? Session { get; set; }
}
