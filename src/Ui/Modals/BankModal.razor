@inject ModalService Modal
@inject IBankService Bank
@inject IWalletService Wallet
@inject NavigationManager Nav

<div class="bank" id="bank-modal" role="dialog" aria-modal="true">
    <header>
        <a href="#" class="@(Tab == "ems" ? "on" : "")" @onclick='() => Tab = "ems"' @onclick:preventDefault>@L["Bank.BuyEms"]</a>
        <a href="#" class="@(Tab == "help" ? "on" : "")" @onclick='() => Tab = "help"' @onclick:preventDefault>@L["Bank.Help"]</a>
        <a href="/wallet" @onclick="Leave">@L["Bank.History"]</a>
        <button type="button" class="close" aria-label="@L["Store.Close"]" @onclick="Close">&times;</button>
    </header>
    <div class="balance">
        <span>@L["Bank.Balance"] <b>@balances?.Ems</b></span>
        <button type="button" id="redeem-code" @onclick="() => asking = true">@L["Bank.Redeem"] <Icon Name="chevron-right" /></button>
    </div>
    @if (asking)
    {
        <form class="code" @onsubmit="Apply" @onsubmit:preventDefault>
            <input class="field-light" id="code" type="text" placeholder="@L["Bank.EnterCode"]" @bind="code" @bind:event="oninput" />
            <input id="apply-code" type="submit" value="@L["Alert.Ok"]" />
            <button type="button" id="cancel-code" @onclick="Cancel">@L["Bank.Cancel"]</button>
            @if (invalid) { <span class="invalid">@L["Bank.Invalid"]</span> }
        </form>
    }
    <p class="notice" role="status">@L["Bank.NoBuy"]</p>
    @if (catalog is not null)
    {
        @if (Tab == "ems")
        {
            <section>
                <h2>@L["Bank.InGame"]</h2>
                <p class="desc">@L["Bank.EmsDesc"]</p>
                <div class="packs">
                    @foreach (var p in catalog.EmPacks)
                    {
                        <div class="pack">
                            <AssetSlot Name="em-pack" Width="100" Height="80" />
                            <h3>@p.Ems Em$</h3>
                            <button type="button" class="buy" disabled>@L["Store.Buy"] <Icon Name="chevron-right" /></button>
                        </div>
                    }
                </div>
            </section>
        }
        else if (Tab == "help") { <section class="help">@Help()</section> }
        else
        {
            <section class="ms">
                <h2>@L["Bank.Starter"]</h2><p class="desc">@L["Bank.StarterDesc"]</p>
                <div class="cards">@foreach (var m in catalog.Starter) { @Card(m) }</div>
                <h2>@L["Bank.Special"]</h2><p class="desc">@L["Bank.SpecialDesc"]</p>
                <div class="cards">@foreach (var m in catalog.Special) { @Card(m) }</div>
                <h2>@L["Bank.Basic"]</h2>
                <div class="cards">@foreach (var m in catalog.Basic) { @Card(m) }</div>
                <p class="compare">@L["Bank.Kept"]</p>
            </section>
        }
    }
</div>

@code {
    BankCatalog? catalog;
    Balances? balances;
    bool asking, invalid;
    string code = "";

    /// <summary>ems, memberships or help.</summary>
    [Parameter] public string Tab { get; set; } = "ems";

    protected override async Task OnInitializedAsync()
    {
        (catalog, balances) = (await Bank.CatalogAsync(), await Wallet.BalancesAsync());
    }

    RenderFragment Card(Membership m) => @<div class="card">
        <AssetSlot Name="membership-card" Width="100" Height="70" />
        <div class="what">
            <p>@(m.Name.Length == 0 ? L["Bank.MonthsOnly", m.Months] : L["Bank.Months", m.Months])</p>
            <p>@L["Bank.Animals"]</p><p>@L["Bank.Reserves"]</p><p>@L["Bank.Ammo"]</p>
            @if (m.OtherItems > 0) { <p>@L["Bank.Extra", m.ExtraWeapons] @L["Bank.Other", m.OtherItems] <a href="#" @onclick:preventDefault>@L["Bank.Details"] <Icon Name="chevron-right" /></a></p> }
        </div>
        <button type="button" class="buy" disabled>@L["Store.Buy"] <Icon Name="chevron-right" /></button>
    </div>;

    RenderFragment Help() => @<div>
        <h2>@L["Bank.HelpTitle"]</h2>
        @foreach (var n in new[] { 1, 3, 6 })
        {
            <h4>@L["Bank.Q" + n]</h4>
            <p>@L["Bank.A" + n]</p>
        }
    </div>;

    async Task Apply()
    {
        if (code.Trim().Length == 0) return;
        invalid = !(await Bank.CheckCodeAsync(code.Trim())).Ok;
    }

    void Cancel() => (asking, invalid, code) = (false, false, "");

    void Close() { Modal.Close(); Nav.NavigateTo("/"); }

    void Leave() => Modal.Close();
}
