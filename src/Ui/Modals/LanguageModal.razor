@inject ModalService Modal
@inject ILanguageSwitcher Language

<div class="lang-select">
    <h2><Icon Name="caret-down" /> @L["Language.Title"] <button class="close" aria-label="@L["Alert.Close"]" @onclick="Modal.Close">&times;</button></h2>
    <ul>
        @foreach (var l in Languages.All)
        {
            <li><a href="#" @onclick="() => Language.Set(l.Code)" @onclick:preventDefault><img src="_content/Resurgence.Ui/flags/@(l.Flag).svg" alt="" /> @l.Name</a></li>
        }
    </ul>
</div>
