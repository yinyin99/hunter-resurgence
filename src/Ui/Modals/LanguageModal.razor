@inject ModalService Modal
@inject ILanguageSwitcher Language

<div class="lang-select">
    <h2><Icon Name="caret-down" /> @L["Language.Title"] <button class="close" aria-label="@L["Alert.Close"]" @onclick="Modal.Close">&times;</button></h2>
    <ul>
        @foreach (var (code, name) in languages)
        {
            <li><a href="#" @onclick="() => Language.Set(code)" @onclick:preventDefault><img src="_content/Resurgence.Ui/flags/@(code).svg" alt="" /> @L[name]</a></li>
        }
    </ul>
</div>

@code {
    static readonly (string Code, string Name)[] languages = [("en", "Language.English"), ("fr", "Language.French")];
}
