@inject ModalService Modal
@inject ILauncherBridge Bridge
@inject IServersService Servers
@inject IGameSettingsService GameSettings

@* the old container closes on a click beside the map and the details; the backdrop is a layer of its own as the dialog element belongs to the shell *@
<div class="backdrop" @onclick="Modal.Close"></div>
<div class="join" role="dialog" aria-modal="true">
    @* the map, the host's setup and the players' places are only for a player who may join: none for a game the server refuses, and for a game with a password none until it is entered *@
    @if (markers is { } shown)
    {
        <MapPlaceholder Markers="shown" Reserve="Server.Reserve" Height="608" Zoom="false" OnPick="Pick" Players="Server.Roster" HoverPlayer="@hoverPlayer">
            <p class="hint"><Icon Name="caret-down" /> @L["Join.Hint"]</p>
        </MapPlaceholder>
    }
    else
    {
        <div class="nomap">@if (!loading && !AsksPassword) { <p>@L["Join.Hidden"]</p> }</div>
    }
    <aside>
        <button class="close" aria-label="@L["Join.Close"]" @onclick="Modal.Close">&times;</button>
        <h2>@Server.Name</h2>
        <h5>@L["Servers.Details"]</h5>
        <p class="line">@L["Servers.HostLabel"] <a href="/profile/@Server.Host" @onclick="Modal.Close">@Server.Host</a></p>
        <p class="line">@L["Servers.ReserveLabel"] @reserve</p>
        <p class="line">@L["Servers.GameTime"] @Fmt.Elapsed(L, Server.Seconds)</p>
        @if (Server.Limited)
        {
            <p class="line gap">@L["Servers.MinScore"] @Server.MinScore</p>
            <p class="line">@L["Servers.MaxScore"] @Server.MaxScore</p>
        }
        @if (Server.Password) { <p class="line gap"><Icon Name="lock" /> @L["Servers.PasswordRequired"]</p> }
        <LoadoutPicker Loadouts="loadouts" @bind-Value="loadout" Id="join-loadout" />
        <h5 class="players-title">@L["Servers.PlayerList", Server.Players, Server.Max]</h5>
        @foreach (var (p, i) in Server.Roster.Select((p, i) => (p, i)))
        {
            <div class="player" style="border-color:@(i % 2 == 0 ? "#c0396b" : "#8e87d6")" @onmouseenter="() => hoverPlayer = p.Handle" @onmouseleave="() => hoverPlayer = null">
                <AssetSlot Name="@p.Avatar" Width="50" Height="50" />
                <a href="/profile/@p.Handle" @onclick="Modal.Close">@p.Handle</a>
                <span class="score"><Icon Name="paw" /> @p.HunterScore</span>
            </div>
        }
    </aside>
    @if (AsksPassword)
    {
        <form class="password" @onsubmit="Unlock" id="mp-password-dialog">
            <label for="join-password">@L["Join.Password"]</label>
            <input id="join-password" type="password" maxlength="20" placeholder="@L["Join.PasswordPlaceholder"]" @bind="password" autofocus />
            @if (wrong) { <p class="wrong" role="alert">@L["Join.WrongPassword"]</p> }
            <button class="btn btn-primary" disabled="@checking">@L["Join.Go"]</button>
        </form>
    }
</div>

@code {
    /// <summary>The starts and the host's items; null while there is no map to show.</summary>
    IReadOnlyList<MapMarker>? markers;
    string reserve = "";
    string? password, hoverPlayer;
    bool loading = true, wrong, checking;
    bool AsksPassword => !loading && markers is null && Server.Password && !Server.Refused;
    IReadOnlyList<Loadout> loadouts = [];
    int loadout;

    /// <summary>The game to join; set by the dashboard's Quick Join and the server list's Join Game.</summary>
    [Parameter, EditorRequired] public GameServer Server { get; set; } = null!;

    /// <summary>The loadout picked in the server list's preview.</summary>
    [Parameter] public int Loadout { get; set; }

    protected override async Task OnInitializedAsync()
    {
        loadout = Loadout;
        if (!Server.Refused && !Server.Password) markers = await Servers.JoinMarkersAsync(Server.Id, Server.Reserve, null);
        loadouts = await Servers.LoadoutsAsync();
        reserve = (await Servers.ReservesAsync()).FirstOrDefault(r => r.Id == Server.Reserve)?.Name ?? "";
        loading = false;
    }

    /// <summary>The server shows the map of a game with a password only after the right one (it checks it before it sends the host's items).</summary>
    async Task Unlock()
    {
        if (checking) return;
        checking = true;
        try
        {
            markers = await Servers.JoinMarkersAsync(Server.Id, Server.Reserve, password);
            wrong = markers is null;
        }
        finally { checking = false; }
    }

    Task Pick(MapMarker marker) => Join(marker, Server.Password ? password : null);

    bool joining;  // a second click while the join runs would open another hunt

    async Task Join(MapMarker marker, string? pass)
    {
        if (joining) return;
        joining = true;
        try
        {
            if (!await Modal.SetUpFirst(GameSettings)) return;
            var result = await Servers.JoinAsync(Server.Id, marker.Id, pass, loadout);
            // the map stays until the "Done hunting" window replaces it, as in the old app
            if (result.Ok) Modal.GameStarted(Bridge); else Modal.StartFailed(result);
        }
        finally { joining = false; }
    }
}
