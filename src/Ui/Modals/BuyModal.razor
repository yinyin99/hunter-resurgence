@implements IDisposable
@inject ModalService Modal
@inject HostMode Mode
@inject IStoreService Store
@inject IWalletService Wallet

<div class="buy dialog-card" role="dialog" aria-modal="true">
    <button class="close" aria-label="@L["Store.Close"]" @onclick="Modal.Close">&times;</button>
    @if (state == 0)
    {
        <h2>@L["Store.Confirm"]</h2>
        <p class="line">@count x @Name - @(Ems * count) em$</p>
        @if (Multi) { <select id="buy_count" class="field-sel" disabled="@pending" @bind="count">@foreach (var n in new[] { 1, 5, 10 }) { <option value="@n">@n</option> }</select> }
        @if (Lines is { Count: > 0 })
        {
            <h5>@L["Store.Includes"]</h5>
            <ul class="lines">
                @foreach (var g in Lines.GroupBy(l => l.ItemId))
                {
                    <li>@g.Sum(l => l.Count) x @if (!Mode.Live) { <span class="own">@L["Store.Own"] @g.First().Owned</span> } @g.First().Name</li>
                }
            </ul>
        }
        else if (DaysLeft is { } days) { <p class="own">@L["Store.Own"] @Fmt.DaysLeft(days) @L["Store.Days"]</p> }
        else if (Owned > 0) { <p class="own">@L["Store.Own"] @Owned</p> }
        @if (balances is not null)
        {
            <div class="buttons">
                @* an item the community server sells for gm$ alone has no em$ button *@
                @if (Ems > 0 || Gms <= 0)
                {
                    @if (balances.Ems >= Ems * count) { <button class="btn btn-primary" disabled="@pending" @onclick="() => Pay(false)">@L["Store.BuyEms"]</button> }
                    else if (Mode.Live) { @* no bank on the live site: the button stays off and the line below says why *@<button class="btn btn-primary" disabled>@L["Store.BuyEms"]</button> }
                    else { <a class="btn btn-primary" href="/bank/ems" @onclick="Modal.Close">@L["Store.GetMoreEms"]</a> }
                }
                @if (Gms > 0)
                {
                    <button class="btn btn-primary" disabled="@(pending || balances.Gms < Gms * count)" @onclick="() => Pay(true)">@(balances.Gms >= Gms * count || Mode.Live ? L["Store.BuyGms"] + " (" + Gms * count + " gm$)" : L["Store.NotEnoughGms"])</button>
                }
            </div>
            @if (Mode.Live && Ems > 0 && balances.Ems < Ems * count) { <p class="line">@L["Store.NotEnoughEms", balances.Ems, Ems * count]</p> }
            @if (Mode.Live && Gms > 0 && balances.Gms < Gms * count) { <p class="line">@L["Store.NotEnoughGmsHave", balances.Gms, Gms * count]</p> }
        }
    }
    else if (state == 1) { <h2>@L["Store.Complete"]</h2><p class="line">@L["Store.Enjoy", Name]</p> }
    else { <h2>@L["Store.Oops"]</h2><p class="line">@L["Mis.Failed"]</p><div class="buttons"><button class="btn btn-primary" @onclick="Modal.Close">@L["Alert.Ok"]</button></div> }
</div>

@code {
    readonly CancellationTokenSource gone = new();
    Balances? balances;
    int state, count = 1;
    bool pending;

    [Parameter, EditorRequired] public int Id { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public int Ems { get; set; }
    [Parameter] public int Gms { get; set; }
    [Parameter] public bool Bundle { get; set; }
    /// <summary>How many of the item the account owns, or the days left of an item owned for a time.</summary>
    [Parameter] public int Owned { get; set; }
    [Parameter] public double? DaysLeft { get; set; }
    /// <summary>Ammunition: the amount is picked (1, 5 or 10) and the prices are for all of them.</summary>
    [Parameter] public bool Multi { get; set; }
    /// <summary>The lines of a bundle, listed as what it includes.</summary>
    [Parameter] public IReadOnlyList<BundleLine>? Lines { get; set; }
    /// <summary>Raised after a purchase went through, so the page can show the new amounts.</summary>
    [Parameter] public EventCallback Bought { get; set; }

    protected override async Task OnInitializedAsync() => balances = await Wallet.BalancesAsync();

    // the buttons stay disabled while the request runs; the dialog closes by itself after the thanks (2 s) or the error (5 s)
    async Task Pay(bool gms)
    {
        if (pending) return;
        pending = true;
        var ok = (await Store.BuyAsync(Id, Bundle, gms, count)).Ok;
        (state, pending) = (ok ? 1 : 2, false);
        if (ok) await Bought.InvokeAsync();
        StateHasChanged();
        try
        {
            await Task.Delay(ok ? 2000 : 5000, gone.Token);
            Modal.Close();
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose() => gone.Cancel();
}
