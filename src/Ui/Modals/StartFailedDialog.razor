@inject ModalService Modal
@inject ILauncherBridge Bridge
@inject IKitService Kit

@* a refused start (docs/website.md#the-game-check): the text of the error key, with the values and the fix button of the install check that holds it *@
<AlertDialog Text="@text" FixLabel="@(GameCheckText.FixLabel(fix) is { } label ? L[label].Value : null)" Fix="() => Modal.FixAsync(fix!, Bridge, Kit)" />

@code {
    /// <summary>The key <see cref="ILauncherBridge.StartGame"/> and the servers' joins fail with: a Check.* or Launch.* key.</summary>
    [Parameter, EditorRequired] public string Error { get; set; } = "";

    string text = "";
    string? fix;

    protected override async Task OnInitializedAsync()
    {
        text = L.Text(Error, null);
        // the check that refused the start knows the values of its text and its fix (the server's join refusals, Join.*, come from no check); the keys of the older start errors have a fix of their own
        var check = Error.StartsWith("Check.") || Error.StartsWith("Kit.") ? (await Bridge.CheckInstallAsync()).FirstOrDefault(c => c.Level == "block" && c.Text == Error) : null;
        // the problem is gone by now and its text needs its values: the general text instead of a sentence with holes
        text = check is null && L[Error].Value.Contains("{0}") ? L["Launch.StartFailed"].Value : L.Text(Error, check?.Args);
        fix = check?.Fix ?? Error switch { "Launch.NoGame" => "choose-folder", _ => null };
    }
}
