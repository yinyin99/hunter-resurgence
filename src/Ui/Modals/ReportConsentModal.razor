@inject ModalService Modal
@inject ILauncherBridge Bridge

@* asked once, after the first sign-in (ModalService.OfferReportConsentAsync, docs/launcher.md#report-a-problem); Escape does nothing, so a choice is made *@
<div class="consent dialog-card" role="dialog" aria-modal="true" aria-labelledby="consent-title">
    <h1 id="consent-title">@L["Report.ConsentTitle"]</h1>
    <p>@L["Report.ConsentIntro"]</p>
    <p><a href="/your-data" id="consent-link" @onclick="Modal.Close">@L["Report.ConsentLink"]</a></p>
    <div class="buttons">
        <button type="button" class="btn btn-inverse" id="consent-ask" autofocus @onclick='() => Choose("ask")'>@L["Report.ConsentAsk"]</button>
        <button type="button" class="btn btn-inverse" id="consent-auto" @onclick='() => Choose("auto")'>@L["Report.ConsentAuto"]</button>
    </div>
</div>

@code {
    void Choose(string consent)
    {
        Bridge.ReportConsent = consent;
        Modal.Close();
    }
}
