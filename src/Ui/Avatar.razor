<span class="avatar @Class" aria-hidden="true">@Initials</span>

@code {
    [Parameter, EditorRequired] public string Handle { get; set; } = "";
    /// <summary>Extra CSS class, for example "lg".</summary>
    [Parameter] public string? Class { get; set; }

    // CamelCase handles give their capitals ("SampleHunter" -> "SH"), others their first two letters
    string Initials
    {
        get
        {
            var caps = new string(Handle.Where(char.IsUpper).Take(2).ToArray());
            return caps.Length == 2 ? caps : Handle.Length >= 2 ? Handle[..2].ToUpperInvariant() : Handle.ToUpperInvariant();
        }
    }
}
