@if (Server.Distance is { } distance)
{
    <i class="dot @distance.ToString().ToLowerInvariant()" data-tip="@L["Servers." + distance]"></i>
}

@code {
    /// <summary>The coloured distance dot of a game (short, medium or long, as the legend says); none when the server does not say how far the host is.</summary>
    [Parameter, EditorRequired] public GameServer Server { get; set; } = null!;
}
