@* PROTOTYPE (branch prototype/958-hunting-stats): variant C of the hunting statistics. One table per view with the figures in aligned, labelled columns (labels once, in the header, not on every
   row), the gm$ per hour as a 3D bar (the shared .bar3d of theme.css, like the achievements overview) with its number at the end; reserves first (few, the context), species below. *@
<div class="hunting">
    <section class="base" aria-label="@L["Board.HuntingBase"]">
        <p>@L["Board.HuntingBase"]</p>
        @if (Stats.Events.Count > 0)
        {
            <div class="events">
                <span>@L["Board.HuntingEvents"]</span>
                <ul>@foreach (var e in Stats.Events) { <li>@Fmt.EventLine(e, System.Globalization.CultureInfo.CurrentCulture)</li> }</ul>
            </div>
        }
    </section>

    <section>
        <h4 class="part">@L["Board.HuntingReserves"]</h4>
        <div class="scroll" tabindex="0" role="region" aria-label="@L["Board.HuntingReserves"]">
            <table>
                <thead><tr><th scope="col">@L["Stat.Reserve"]</th><th scope="col" class="rate">@L["Board.HuntingGmHour"]</th><th scope="col">@L["Board.HuntingGmHarvest"]</th><th scope="col">@L["Board.HuntingHarvestsHour"]</th><th scope="col">@L["Board.HuntingHours"]</th><th scope="col">@L["Board.HuntingPlayers"]</th></tr></thead>
                <tbody>
                    @{ var topReserve = Stats.Reserves.Count == 0 ? 0 : Stats.Reserves.Max(r => r.ComparableGmPerHour); }
                    @foreach (var r in Stats.Reserves.OrderByDescending(r => r.ComparableGmPerHour))
                    {
                        <tr>
                            <th scope="row">@r.Reserve</th>
                            <td class="rate"><span class="bar3d" aria-hidden="true"><i style="width:@Share(r.ComparableGmPerHour, topReserve)"></i></span><b>@Fmt.Num(r.ComparableGmPerHour, "0")</b></td>
                            <td>@Fmt.Num(r.ComparableGmPerHarvest, "0")</td><td>@Fmt.Num(r.HarvestsPerHour, "0.0")</td><td>@Fmt.Num(r.Hours, "0.0")</td><td>@r.Players</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section>
        <h4 class="part">@L["Board.HuntingSpecies"]</h4>
        <div class="scroll" tabindex="0" role="region" aria-label="@L["Board.HuntingSpecies"]">
            <table>
                <thead><tr><th scope="col">@L["Stat.Species"]</th><th scope="col" class="rate">@L["Board.HuntingGmHour"]</th><th scope="col">@L["Board.HuntingGmHarvest"]</th><th scope="col">@L["Board.HuntingHarvestsHour"]</th><th scope="col">@L["Board.HuntingHours"]</th><th scope="col">@L["Board.HuntingPlayers"]</th><th scope="col" class="text">@L["Board.HuntingBest"]</th></tr></thead>
                <tbody>
                    @{ var topSpecies = Stats.Species.Count == 0 ? 0 : Stats.Species.Max(s => s.ComparableGmPerHour); }
                    @foreach (var s in Stats.Species.OrderByDescending(s => s.ComparableGmPerHour))
                    {
                        <tr>
                            <th scope="row">@L.Term(s.Species)</th>
                            <td class="rate"><span class="bar3d" aria-hidden="true"><i style="width:@Share(s.ComparableGmPerHour, topSpecies)"></i></span><b>@Fmt.Num(s.ComparableGmPerHour, "0")</b></td>
                            <td>@Fmt.Num(s.ComparableGmPerHarvest, "0")</td><td>@Fmt.Num(s.HarvestsPerHour, "0.0")</td><td>@Fmt.Num(s.Hours, "0.0")</td><td>@s.Players</td><td class="text">@s.BestReserve</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public HuntingStats Stats { get; set; } = default!;

    static string Share(double value, double best) => (best > 0 ? Math.Max(0, 100 * value / best) : 0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
