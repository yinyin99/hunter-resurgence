<div class="su-paper @Class" style="width:@(Width)px;height:@(Height)px;left:@(X)px;top:@(Y)px"><AssetSlot Name="paper-notice" Width="Width" Height="Height" /><p>@ChildContent</p></div>

@code {
    /// <summary>A text on the torn paper of the signup screens: the paper picture is this size and at this position in the card (or page).</summary>
    [Parameter] public int X { get; set; }
    [Parameter] public int Y { get; set; }
    [Parameter] public int Width { get; set; } = 538;
    [Parameter] public int Height { get; set; } = 134;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
