<div class="multi">
    <button type="button" class="btn" popovertarget="@uid" aria-haspopup="listbox">
        <span>@(Selected.Count == 0 || Selected.Count == Options.Count ? L["Mis.AllSelected"] : L["Mis.NSelected", Selected.Count])</span><span class="caret"></span>
    </button>
    <ul id="@uid" class="pop" popover role="listbox">
        @foreach (var o in Options)
        {
            <li><label><input type="checkbox" checked="@(Selected.Contains(o))" @onchange="e => Toggle(o, (bool)e.Value!)" /> @(Label?.Invoke(o) ?? o)</label></li>
        }
    </ul>
</div>

@code {
    readonly string uid = "multi" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired] public IReadOnlyList<string> Options { get; set; } = [];
    /// <summary>The chosen options; empty means all.</summary>
    [Parameter] public HashSet<string> Selected { get; set; } = [];
    /// <summary>The text shown for an option; the option itself by default.</summary>
    [Parameter] public Func<string, string>? Label { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    async Task Toggle(string option, bool on)
    {
        if (on) Selected.Add(option); else Selected.Remove(option);
        await Changed.InvokeAsync();
    }
}
