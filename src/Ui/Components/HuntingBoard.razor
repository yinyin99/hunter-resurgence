@* The server-wide hunting statistics at the rewards' base: a strip saying so (with the bonus events of the period), species ranked by gm$ per hour, reserves beside them. The bars only
   repeat the number printed next to them, so they are hidden from assistive technology. *@
<div class="hunting">
    <section class="base" aria-label="@L["Board.HuntingBase"]">
        <p>@L["Board.HuntingBase"]</p>
        @if (Stats.Events.Count > 0)
        {
            <div class="events">
                <span>@L["Board.HuntingEvents"]</span>
                <ul>@foreach (var e in Stats.Events) { <li>@Fmt.EventLine(e, System.Globalization.CultureInfo.CurrentCulture)</li> }</ul>
            </div>
        }
    </section>
    <div class="cols">
        <section>
            <h4 class="part">@L["Board.HuntingSpecies"]</h4>
            @{ var topSpecies = Stats.Species.Count == 0 ? 0 : Stats.Species.Max(s => s.ComparableGmPerHour); }
            <ol class="species">
                @foreach (var s in Stats.Species.OrderByDescending(s => s.ComparableGmPerHour))
                {
                    <li>
                        <span class="name">@L.Term(s.Species)</span>
                        <span class="figure"><b>@Fmt.Num(s.ComparableGmPerHour, "0")</b> <small>@L["Board.HuntingGmHour"]</small></span>
                        <span class="bar" aria-hidden="true" style="--w:@Share(s.ComparableGmPerHour, topSpecies)"></span>
                        <dl>
                            <div><dt>@L["Board.HuntingGmHarvest"]</dt><dd>@Fmt.Num(s.ComparableGmPerHarvest, "0")</dd></div>
                            <div><dt>@L["Board.HuntingHarvestsHour"]</dt><dd>@Fmt.Num(s.HarvestsPerHour, "0.0")</dd></div>
                            <div><dt>@L["Board.HuntingHours"]</dt><dd>@Fmt.Num(s.Hours, "0.0")</dd></div>
                            <div><dt>@L["Board.HuntingPlayers"]</dt><dd>@s.Players</dd></div>
                            @if (s.BestReserve is not null) { <div><dt>@L["Board.HuntingBest"]</dt><dd>@s.BestReserve</dd></div> }
                        </dl>
                    </li>
                }
            </ol>
        </section>
        <section>
            <h4 class="part">@L["Board.HuntingReserves"]</h4>
            @{ var topReserve = Stats.Reserves.Count == 0 ? 0 : Stats.Reserves.Max(r => r.ComparableGmPerHour); }
            <ol class="reserves">
                @foreach (var r in Stats.Reserves.OrderByDescending(r => r.ComparableGmPerHour))
                {
                    <li>
                        <span class="name">@r.Reserve</span>
                        <span class="figure"><b>@Fmt.Num(r.ComparableGmPerHour, "0")</b> <small>@L["Board.HuntingGmHour"]</small></span>
                        <span class="bar" aria-hidden="true" style="--w:@Share(r.ComparableGmPerHour, topReserve)"></span>
                        <dl>
                            <div><dt>@L["Board.HuntingGmHarvest"]</dt><dd>@Fmt.Num(r.ComparableGmPerHarvest, "0")</dd></div>
                            <div><dt>@L["Board.HuntingHarvestsHour"]</dt><dd>@Fmt.Num(r.HarvestsPerHour, "0.0")</dd></div>
                            <div><dt>@L["Board.HuntingHours"]</dt><dd>@Fmt.Num(r.Hours, "0.0")</dd></div>
                            <div><dt>@L["Board.HuntingPlayers"]</dt><dd>@r.Players</dd></div>
                        </dl>
                    </li>
                }
            </ol>
        </section>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public HuntingStats Stats { get; set; } = default!;

    /// <summary>A row's bar: its share of the best row's figure, as a CSS percentage.</summary>
    static string Share(double value, double best) => (best > 0 ? Math.Max(0, 100 * value / best) : 0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
