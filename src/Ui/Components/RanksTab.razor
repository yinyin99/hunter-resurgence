@inject IProfileService Service

<SubPills Items="subs" Active="@sub" Base="@("/profile/" + Handle + "/ranks")" />
@if (sub == "")
{
    <h4>@L["Prof.Progress"]</h4>
    <h5>@L["Prof.HunterScore"]</h5>
    @if (bars.Count > 0) { @Overview(bars[0], "rank-score", 0) }
    <h5>@L["Prof.Categories"]</h5>
    @foreach (var (b, i) in bars.Skip(1).Select((b, i) => (b, i + 1))) { @Overview(b, b.Name == "Animals" ? "rank-animals" : b.Name == "Weapons" ? "rank-weapons" : "rank-collectables", i) }
}
else
{
    @foreach (var b in bars)
    {
        <div class="row">
            <AssetSlot Name="@(b.Id > 0 ? "rank-" + b.Id : "rank-" + sub)" Width="114" Height="114" Class="badge" />
            <div class="what"><h4>@L.Term(b.Name)</h4><div class="bar"><i style="width:@Pct(b)%"></i><b>@Fmt.Num(b.Level, "0")</b></div></div>
        </div>
    }
}

@code {
    static readonly (string Key, string Label)[] subs = [("", "Prof.Overview"), ("animals", "Prof.Animals"), ("weapons", "Prof.Weapons"), ("collectables", "Prof.Collectables")];
    IReadOnlyList<RankBar> bars = [];

    [Parameter, EditorRequired] public string Handle { get; set; } = "";
    [Parameter] public string? Sub { get; set; }
    string sub => subs.Any(s => s.Key == Sub) ? Sub! : "";

    Profile? profile;

    protected override async Task OnParametersSetAsync()
    {
        bars = await Service.RanksAsync(Handle, sub == "" ? "overview" : sub);
        if (sub == "") profile = await Service.ProfileAsync(Handle);
    }

    int Pct(RankBar b) => b.Total == 0 ? 0 : 100 * b.Done / b.Total;

    // the bars carry no text: the figures show in a tooltip on hover and on focus, as the achievements' steps do; the first bar is the hunterscore's, whose tooltip adds the score and the next step (the next 10 % of the rows)
    RenderFragment Overview(RankBar b, string slot, int i) => @<div class="ov">
        <AssetSlot Name="@slot" Width="40" Height="40" />
        <div class="bar @(i == 0 ? "big" : "")" style="--c:@F(Pct(b) / 100.0)" tabindex="0" role="img" aria-label="@L.Term(b.Name)" aria-describedby="@($"tip-rk-{i}")">
            <span class="track"><i style="width:@Pct(b)%"></i></span>
            <small id="@($"tip-rk-{i}")" role="tooltip" class="tip">
                @if (i == 0 && profile is not null) { <b>@L["Prof.HunterScore"]: @Fmt.Num(profile.HunterScore, "0")</b> }
                <span>@L["Prof.Unlocked"]: @Fmt.Num(b.Done, "0") / @Fmt.Num(b.Total, "0") (@Pct(b)%)</span>
                @if (i == 0 && Pct(b) < 100)
                {
                    var next = (Pct(b) / 10 + 1) * 10;
                    <span>@string.Format(L["Prof.RanksNext"], Fmt.Num(Math.Max(1, (int)Math.Ceiling(b.Total * next / 100.0) - b.Done), "0"), next)</span>
                }
            </small>
        </div>
    </div>;

    static string F(double d) => d.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
