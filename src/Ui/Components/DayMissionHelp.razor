<div class="dm">
    <nav class="index">
        <b>@L["DayHelp.Index"]</b>
        <p>@L["Mis.Daily"]</p>
        <ul>
            <li><a href="#how_it_works">@L["DayHelp.How.Title"]</a></li>
            <li><a href="#difficulty">@L["DayHelp.Diff.Title"]</a></li>
            <li><a href="#progression">@L["DayHelp.Prog.Title"]</a></li>
            <li><a href="#differences">@L["DayHelp.Reg.Title"]</a></li>
            <li><a href="#achievements">@L["Prof.TabAchievements"]</a></li>
            <li><a href="#rewards">@L["DayHelp.Rewards.Title"]</a></li>
        </ul>
        <p>@L["DayHelp.Services.Title"]</p>
        <ul><li><a href="#resume_streak">@L["DayHelp.Resume.Nav"]</a></li></ul>
    </nav>
    <h2>@L["Mis.Daily"]</h2>
    <p>@L.Html("DayHelp.Intro.1", "<a href=\"/missions/daily\">", "</a>")<br />@L["DayHelp.Intro.2"]</p>
    <AssetSlot Name="help-dm-interface" Width="940" Height="850" />
    <p class="cap"><i>@L["DayHelp.Intro.Cap"]</i></p>

    <h3 id="how_it_works">@L["DayHelp.How.Title"]</h3>
    <ul>
        <li>@L["DayHelp.How.1"]</li>
        <li>@L.Html("DayHelp.How.2", "<b>", "</b>")</li>
        <li>@L["DayHelp.How.3"]</li>
        <li>@L.Html("DayHelp.How.4", "<a href=\"#resume_streak\">", "</a>")</li>
    </ul>

    <h3 id="difficulty">@L["DayHelp.Diff.Title"]</h3>
    <p>@L["DayHelp.Diff.Intro"]</p>
    <ul><li>@L["DayHelp.Easy"]</li><li>@L["DayHelp.Medium"]</li><li>@L["DayHelp.Hard"]</li></ul>
    <p>@L["DayHelp.Diff.1"]<br />@L["DayHelp.Diff.2"]</p>
    <AssetSlot Name="help-dm-levels" Width="484" Height="200" />
    <p>@L.Html("DayHelp.Diff.3", "<b>", "</b>")<br />@L["DayHelp.Diff.4"]</p>

    <h3 id="progression">@L["DayHelp.Prog.Title"]</h3>
    <p>@L.Html("DayHelp.Prog.1", "<b>", "</b>")</p>
    <p>@L["DayHelp.Prog.2"]</p>
    <AssetSlot Name="help-dm-cycle" Width="910" Height="84" />
    <p>@L["DayHelp.Prog.3"]</p>
    <p>@L.Html("DayHelp.Prog.4", "<b>", "</b>")<br />@L["DayHelp.Prog.5"]</p>
    <p>@L["DayHelp.Prog.6"]</p>

    <h3 id="differences">@L["DayHelp.Reg.Title"]</h3>
    <ul>
        <li>@L.Html("DayHelp.Reg.1", "<b>", "</b>")</li>
        <li>@L["DayHelp.Reg.2"]</li>
    </ul>

    <h3 id="achievements">@L["Prof.TabAchievements"]</h3>
    <p>@L["DayHelp.Ach.1"]</p>
    <AssetSlot Name="help-dm-achievements" Width="800" Height="190" />
    <p>@L["DayHelp.Ach.2"]</p>
    <p>@L["DayHelp.Ach.3"]</p>
    <table class="tg">
        <thead><tr><th>@L["DayHelp.Ach.Col.Difficulty"]</th><th colspan="5">@L["DayHelp.Ach.Col.Completed"]</th></tr></thead>
        <tbody>
                <tr><td class="easy">@L["DayHelp.Easy"]</td><td>1</td><td>25</td><td>50</td><td>100</td><td>250</td></tr>
                <tr><td class="medium">@L["DayHelp.Medium"]</td><td>1</td><td>10</td><td>25</td><td>50</td><td>100</td></tr>
                <tr><td class="hard">@L["DayHelp.Hard"]</td><td>1</td><td>5</td><td>10</td><td>25</td><td>50</td></tr>
        </tbody>
    </table>

    <h3 id="rewards">@L["DayHelp.Rewards.Title"]</h3>
    <p>@L["DayHelp.Rewards.1"]</p>
    <p>@L["DayHelp.Rewards.2"]</p>
    <ul><li>em$</li><li>@L["DayHelp.Rewards.Items"]</li><li>@L["DayHelp.Rewards.Trophies"]</li></ul>
    <p>@L["DayHelp.Rewards.3"]</p>
    <p>@L.Html("DayHelp.Rewards.4", "<b>", "</b>")</p>
    <p>@L["DayHelp.Rewards.5"]</p>
    <AssetSlot Name="help-dm-rewards" Width="700" Height="200" />
    <p>@L["DayHelp.Rewards.6"]</p>
    <table class="tg rewards">
        <thead><tr><th>@L.Html("DayHelp.Rewards.Col.Streak", "<br />")</th><th>@L["DayHelp.Rewards.Col.Reward"]</th></tr></thead>
        <tbody>
                <tr><td>1</td><td>50 em$</td></tr>
                <tr><td>2</td><td>50 em$</td></tr>
                <tr><td>3</td><td>50 em$</td></tr>
                <tr><td>4</td><td>50 em$</td></tr>
                <tr><td>5</td><td><AssetSlot Name="reward-5" Width="60" Height="60" /> <span>@L["DayHelp.Reward.HuntingCap"]<br />@L["DayHelp.Reward.CamoPatternA"]</span></td></tr>
                <tr><td>6</td><td><AssetSlot Name="reward-6" Width="60" Height="60" /> <span>@L["DayHelp.Reward.TrophyMonths", 3]</span></td></tr>
                <tr><td>7</td><td>50 em$</td></tr>
                <tr><td>8</td><td>50 em$</td></tr>
                <tr><td>9</td><td>50 em$</td></tr>
                <tr><td>10</td><td><AssetSlot Name="reward-10" Width="60" Height="60" /> <span>@L["DayHelp.Reward.TrophyHardDms", 10]</span></td></tr>
                <tr><td>11</td><td><AssetSlot Name="reward-11" Width="60" Height="60" /> <span>@L["DayHelp.Reward.BasicTShirt"]<br />@L["DayHelp.Reward.DailyMissionsHero"]</span></td></tr>
                <tr><td>12</td><td><AssetSlot Name="reward-12" Width="60" Height="60" /> <span>@L["DayHelp.Reward.TrophyMonths", 6]</span></td></tr>
                <tr><td>13</td><td>50 em$</td></tr>
                <tr><td>14</td><td>50 em$</td></tr>
                <tr><td>15</td><td><AssetSlot Name="reward-15" Width="60" Height="60" /> <span>@L["DayHelp.Reward.BoltActionRifle"]<br />@L["DayHelp.Reward.CamoPatternB"]</span></td></tr>
                <tr><td>16</td><td>50 em$</td></tr>
                <tr><td>17</td><td>50 em$</td></tr>
                <tr><td>18</td><td>50 em$</td></tr>
                <tr><td>19</td><td>50 em$</td></tr>
                <tr><td>20</td><td><AssetSlot Name="reward-20" Width="60" Height="60" /> <span>@L["DayHelp.Reward.TrophyHardDms", 20]</span></td></tr>
                <tr><td>21</td><td><AssetSlot Name="reward-21" Width="60" Height="60" /> <span>@L["DayHelp.Reward.LeatherJacket"]<br />@L["DayHelp.Reward.HardCoreHunting"]</span></td></tr>
                <tr><td>22</td><td>50 em$</td></tr>
                <tr><td>23</td><td><AssetSlot Name="reward-23" Width="60" Height="60" /> <span>@L["DayHelp.Reward.TrophyYear"]</span></td></tr>
                <tr><td>24</td><td>50 em$</td></tr>
                <tr><td>25</td><td>50 em$</td></tr>
                <tr><td>26</td><td>50 em$</td></tr>
                <tr><td>27</td><td>50 em$</td></tr>
                <tr><td>28</td><td>50 em$</td></tr>
                <tr><td>29</td><td><AssetSlot Name="reward-29" Width="60" Height="60" /> <span>@L["DayHelp.Reward.LeverActionRifle"]<br />@L["DayHelp.Reward.Engraved"]</span></td></tr>
                <tr><td>30</td><td><AssetSlot Name="reward-30" Width="60" Height="60" /> <span>@L["DayHelp.Reward.TrophyHardDms", 30]</span></td></tr>
        </tbody>
    </table>

    <h2>@L["DayHelp.Services.Title"]</h2>
    <h3 id="resume_streak">@L["DayHelp.Resume.Title"]</h3>
    <p>@L["DayHelp.Resume.1"]</p>
    <p>@L["DayHelp.Resume.2"]<br />@L["DayHelp.Resume.3"]</p>
    <p>@L["DayHelp.Resume.4"]</p>
    <AssetSlot Name="help-dm-resume-buy" Width="700" Height="200" />
    <p>@L.Html("DayHelp.Resume.5", "<a href=\"/store\">", "</a>")</p>
    <p>@L["DayHelp.Resume.6"]</p>
    <AssetSlot Name="help-dm-resume-use" Width="700" Height="200" />
</div>
