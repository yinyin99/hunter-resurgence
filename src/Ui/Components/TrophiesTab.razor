@inject IProfileService Service
@inject HostMode Mode

@if (page is not null)
{
    @if (page.Rows.Count == 0) { <p class="empty">@L["Prof.TrophiesEmpty"]</p> }
    <ul class="grid">
        @foreach (var t in page.Rows)
        {
            <li>
                @* the live site has no competition pages *@
                @if (t.CompetitionId is { } id && !Mode.Live) { <a href="/competitions/details/@id"><h4>@t.Competition</h4></a> }
                else { <h4>@t.Competition</h4> }
                <AssetSlot Name="@(t.Image is { } image ? $"trophy-{image}" : $"trophy-{t.Name}")" Width="147" Height="147" />
                <p>@t.Name</p>
                @if (t.Date != default) { <h5>@t.Date.ToString("yyyy-MM-dd")</h5> }
            </li>
        }
    </ul>
    <Paginator Page="page.Number" Pages="page.Pages" Href="@(n => "/profile/" + Handle + "/trophies/" + n)" />
}

@code {
    Page<Trophy>? page;

    [Parameter, EditorRequired] public string Handle { get; set; } = "";
    [Parameter] public string? Sub { get; set; }

    protected override async Task OnParametersSetAsync() => page = await Service.TrophiesAsync(Handle, int.TryParse(Sub, out var n) ? n : 1);
}
