@inject IProfileService Service

@if (hunt is not null) { <HuntStats Hunt="hunt" Handle="@Handle" Reload="Reload" /> }

@code {
    Expedition? hunt;

    [Parameter, EditorRequired] public string Handle { get; set; } = "";
    [Parameter] public long Id { get; set; }

    protected override async Task OnParametersSetAsync() => hunt = await Service.ExpeditionAsync(Handle, Id);

    // a read that fails keeps the page as it is: the next one may answer
    async Task Reload() => hunt = await Service.ExpeditionAsync(Handle, Id) ?? hunt;
}
