<span class="ribbon @Class" aria-hidden="true"><span>@Text</span></span>

@code {
    /// <summary>The corner ribbon of a store card: SALE (red), BUNDLE (Class="blue") or an item banner (Class premium, limited, new or community).</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string? Class { get; set; }
}
