@implements IDisposable
@inject ModalService Modal

@* a harvest of the player's own: the button with the time left (hours, the server's window is 72), then the badge of what was bought (docs/website.md) *@
@if (done is not null)
{
    <span class="done"><Icon Name="check" /> @L[done == "skull" ? "Taxidermy.SkullBadge" : "Taxidermy.Badge"]</span>
}
else if (left > TimeSpan.Zero)
{
    <button type="button" class="btn" @onclick="Open"><span>@L["Taxidermy.Button"]</span><span class="left">@(left.TotalHours >= 1 ? L["Taxidermy.HoursLeft", (int)left.TotalHours] : L["Taxidermy.MinutesLeft", Math.Max(1, (int)left.TotalMinutes)])</span></button>
}

@code {
    TimeSpan left;
    string? done;

    [Parameter, EditorRequired] public Kill Kill { get; set; } = null!;
    [Parameter, EditorRequired] public TaxidermyOffer Offer { get; set; } = null!;

    CancellationTokenSource? stop;

    protected override void OnParametersSet() => (left, done) = (Offer.End - DateTime.UtcNow, Offer.Done);

    // after the first paint, once a minute: the hours left count down and the button goes when the offer ends, without a reload
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        stop = new();
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (left > TimeSpan.Zero && await timer.WaitForNextTickAsync(stop.Token))
            {
                left = Offer.End - DateTime.UtcNow;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose() => stop?.Cancel();

    void Open() => Modal.Show<TaxidermyModal>(new Dictionary<string, object?>
    {
        ["Kill"] = Kill, ["Offer"] = Offer, ["Bought"] = EventCallback.Factory.Create<string>(this, d => done = d)
    });
}
