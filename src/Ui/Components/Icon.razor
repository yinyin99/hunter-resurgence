<svg class="icon" aria-hidden="true"><use href="_content/Resurgence.Ui/icons.svg?v=@Version#@Name" /></svg>

@code {
    // the sprite is cached for hours under a fixed URL: a new build of this library (the sprite ships in it) is a new URL
    static readonly string Version = typeof(Icon).Assembly.ManifestModule.ModuleVersionId.ToString("N");

    /// <summary>Symbol id in wwwroot/icons.svg (a Font Awesome Free name; regular style ends in -regular).</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
