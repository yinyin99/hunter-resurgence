<svg class="icon" aria-hidden="true"><use href="@Assets["_content/Resurgence.Ui/icons.svg"]#@Name" /></svg>

@code {
    /// <summary>Symbol id in wwwroot/icons.svg (a Font Awesome Free name; regular style ends in -regular; paw-regular is the solid paw redrawn as an outline, as that set has none).</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
