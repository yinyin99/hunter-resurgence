@* PROTOTYPE (branch prototype/958-hunting-stats): variant B of the hunting statistics. Species lead as a ranked bar list of gm$ per hour at the base rate, the bonus events sit
   in a strip above it, next to the figures they are left out of; reserves are a compact side column. English strings, no resx. *@
@code {
    [Parameter, EditorRequired] public HuntingStats Stats { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, string> SpeciesName { get; set; } = default!;
    string Dates(HuntingEvent e) => Fmt.EventLine(e, System.Globalization.CultureInfo.CurrentCulture);
}

<div class="hb">
    <section class="strip" aria-label="Bonus events">
        <div class="strip-lead"><strong>Base rate</strong><span>Every gm$ below is counted without bonuses.</span></div>
        @if (Stats.Events.Count == 0) { <span class="chip none">No bonus event in this period</span> }
        else { <ul>@foreach (var e in Stats.Events) { <li class="chip"><b>@Dates(e)</b><em>left out</em></li> }</ul> }
    </section>

    <div class="cols">
        <section class="main">
            <h4>Species, by gm$ per hour</h4>
            @{ var top = Stats.Species.Count == 0 ? 1 : Stats.Species.Max(s => s.ComparableGmPerHour); }
            <ol class="rank">
                @foreach (var s in Stats.Species.OrderByDescending(s => s.ComparableGmPerHour))
                {
                    <li>
                        <span class="name">@SpeciesName(s.Species)</span>
                        <span class="bar" style="--w:@Fmt.Num(100 * s.ComparableGmPerHour / top, "0.#")%"><b>@Fmt.Num(s.ComparableGmPerHour, "0")</b><small>gm$/h</small></span>
                        <span class="meta">@Fmt.Num(s.ComparableGmPerHarvest, "0") gm$ per harvest · @Fmt.Num(s.HarvestsPerHour, "0.0") harvests/h · @Fmt.Num(s.Hours, "0") h · @s.Players hunters@(s.BestReserve is null ? "" : " · best on " + s.BestReserve)</span>
                    </li>
                }
            </ol>
        </section>
        <aside>
            <h4>Reserves</h4>
            @{ var topR = Stats.Reserves.Count == 0 ? 1 : Stats.Reserves.Max(r => r.ComparableGmPerHour); }
            <ul class="res">
                @foreach (var r in Stats.Reserves.OrderByDescending(r => r.ComparableGmPerHour))
                {
                    <li>
                        <div class="res-head"><span>@r.Reserve</span><b>@Fmt.Num(r.ComparableGmPerHour, "0") <small>gm$/h</small></b></div>
                        <span class="bar thin" style="--w:@Fmt.Num(100 * r.ComparableGmPerHour / topR, "0.#")%"></span>
                        <span class="meta">@Fmt.Num(r.ComparableGmPerHarvest, "0") per harvest · @Fmt.Num(r.HarvestsPerHour, "0.0")/h · @Fmt.Num(r.Hours, "0") h · @r.Players hunters</span>
                    </li>
                }
            </ul>
        </aside>
    </div>
</div>
