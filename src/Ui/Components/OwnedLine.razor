@* what the player owns of a store item, as the original's store shows it: a license's end (or "unlimited"), the days of a timed item, the amount, "Owned" for one single item; nothing for none, and nothing for a license that has ended (the original has no words for it) *@
@if (Expires is { } end)
{
    @if (end == 0) { <p class="own">@L["Store.UnlimitedLicense"]</p> }
    else if (end > DateTimeOffset.UtcNow.ToUnixTimeSeconds()) { <p class="own">@(Full ? L["Store.LicenseUntil"] : L["Store.Expires"]) @DateTimeOffset.FromUnixTimeSeconds(end).ToString("yyyy-MM-dd")</p> }
}
else if (DaysLeft is { } days) { <p class="own">@L["Store.Own"] @Fmt.DaysLeft(days) @L["Store.Days"]</p> }
else if (Owned == 1 && !Counted) { <p class="own">@L["Store.Owned"]</p> }
else if (Owned > 0) { <p class="own">@L["Store.Own"] @Owned</p> }

@code {
    [Parameter] public int Owned { get; set; }
    /// <summary>The amount is units (a counted item), so one is "You own: 1".</summary>
    [Parameter] public bool Counted { get; set; }
    /// <summary>The end of a license in unix seconds, 0 when unlimited.</summary>
    [Parameter] public long? Expires { get; set; }
    [Parameter] public double? DaysLeft { get; set; }
    /// <summary>The item's page words a license in full; the list and the buy dialog say when it expires.</summary>
    [Parameter] public bool Full { get; set; }
}
