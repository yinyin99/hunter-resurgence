<table>
    <thead><tr><th>@L["Stat.Species"]</th><th>@L["Stat.Spotted"]</th><th>@L["Stat.Tracked"]</th><th>@L["Stat.Harvested"]</th></tr></thead>
    <tbody>@foreach (var s in Rows) { <tr><td>@L.Term(s.Name)</td><td>@s.Spotted</td><td>@s.Tracked</td><td>@s.Harvested</td></tr> }</tbody>
</table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SpeciesStat> Rows { get; set; } = [];
}
