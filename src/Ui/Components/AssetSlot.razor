@inject AssetImages Images
@inject NavigationManager Nav
@if (src?.Contains(".webm?", StringComparison.OrdinalIgnoreCase) == true)
{
    @* as the original landing page's background video: muted, so the browser lets it start on its own. Markup, not a Blazor element:
       the muted attribute mutes only an element the HTML parser creates, and the browser plays nothing unmuted on its own *@
    @((MarkupString)$"<video class=\"asset-slot has-image {Enc(Class)}\" src=\"{Enc(src)}\" style=\"width:{Width}px;height:{Height}px\" width=\"{Width}\" height=\"{Height}\" aria-label=\"{Enc(Name)}\" autoplay muted loop playsinline></video>")
}
else if (src is not null)
{
    <img class="asset-slot has-image @Class" src="@src" style="width:@(Width)px;height:@(Height)px" width="@Width" height="@Height" alt="@Name" />
}
else
{
    <span class="asset-slot @Class" style="width:@(Width)px;height:@(Height)px" role="img" aria-label="@Name">@(Width < 80 ? "" : Name)</span>
}

@code {
    /// <summary>A picture of the old interface, or its neutral labelled stand-in when the operator has no file for it; the slot names and the picture files are listed in docs/images.md.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Width { get; set; } = 100;
    [Parameter] public int Height { get; set; } = 100;
    [Parameter] public string? Class { get; set; }

    string? src;

    protected override void OnParametersSet()
    {
        src = Images.Url(Name);
        if (src is null) Images.NoteMissing(Name, new Uri(Nav.Uri).AbsolutePath);
    }

    static string Enc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");
}
