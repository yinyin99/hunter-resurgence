@* the statistics of one expedition: the last hunt of a hunter, or one expedition of the history *@
<div class="head">
    <span class="where">@string.Join(" - ", new[] { Hunt.Reserve, Hunt.Lodge }.Where(n => !string.IsNullOrEmpty(n)))</span>
    <span class="when">@Hunt.Start.ToString("yyyy-MM-dd HH:mm") UTC - @(Hunt.End is { } e ? e.ToString("yyyy-MM-dd HH:mm") + " UTC" : L["Stat.Ongoing"])</span>
</div>
@if (Hunt.End is null)
{
    // the old page shows nothing else until the expedition is over
    <p>@L["Stat.WhenEnded"]</p>
    return;
}
<h4>@L["Prof.Weapons"]</h4>
@if (Hunt.Weapons.Count == 0) { <p>@L["Stat.NoShotsExp"]</p> }
else { <WeaponTable Weapons="Hunt.Weapons" /> }
<h4>@L["Prof.Animals"]</h4>
@if (Hunt.Animals.Count == 0) { <p>@L["Stat.NoAnimalsExp"]</p> }
else { <SpeciesTable Rows="Hunt.Animals" /> }
@if (Hunt.Collectables.Count > 0)
{
    <h4>@L["Prof.Collectables"]</h4>
    <table class="tbl tbl-c">
        <thead><tr><th>@L["Stat.Name"]</th><th>@L["Stat.Score"]</th><th>@L["Wal.Date"]</th></tr></thead>
        <tbody>@foreach (var c in Hunt.Collectables) { <tr><td>@c.Name</td><td>@Fmt.Score(c.Score)</td><td>@Fmt.Utc(c.When)</td></tr> }</tbody>
    </table>
}
@if (Hunt.Achievements.Count > 0)
{
    <h4>@L["Prof.TabAchievements"]</h4>
    <ul>@foreach (var a in Hunt.Achievements) { <li><b>@a.Title</b> - @a.Description</li> }</ul>
}
<h4>@L["Stat.Misc"]</h4>
<table class="misc tbl"><tbody>
    <tr><td>@L["Stat.Distance"]</td><td>@Fmt.Kilometres(L, Hunt.DistanceKm)</td></tr>
    <tr><td>@L["Stat.Duration"]</td><td>@Fmt.Duration(L, Hunt.Seconds)</td></tr>
</tbody></table>
@if (Hunt.Antlers.Count > 0)
{
    <h4 class="gap">@L["Stat.Antlers"]</h4>
    <table class="tbl tbl-c">
        <thead><tr><th>@L["Stat.Species"]</th><th>@L["Wal.Type"]</th><th>@L["Stat.Score"]</th></tr></thead>
        <tbody>@foreach (var a in Hunt.Antlers) { <tr><td>@L.Term(a.Species)</td><td>@L[a.Double ? "Board.Double" : "Board.Single"]</td><td>@Fmt.Score(a.Score)</td></tr> }</tbody>
    </table>
}
<h4>@L["Stat.Kills"]</h4>
@if (Hunt.Kills.Count == 0) { <p>@L["Stat.NoKillsExp"]</p> }
else
{
    <table class="kills tbl">
        <thead><tr><th>@L["Stat.Species"]</th><th>@L["Stat.Weapon"]</th><th>@L["Stat.Score"]</th><th>@L["Stat.Range"]</th>@if (Hunt.Kills.Any(k => k.Taxidermy is not null)) { <th></th> }</tr></thead>
        <tbody>@foreach (var k in Hunt.Kills) { <tr><td>@if (k.Sheet) { <a href="/profile/@Handle/score/@k.Id">@L.Term(k.Species)</a> } else { @L.Term(k.Species) }</td><td>@k.Weapon (@k.Ammo)</td><td>@Fmt.Score(k.Score)</td><td>@Fmt.Metres(k.DistanceM)</td>@if (k.Taxidermy is { } t) { <td><TaxidermyButton Kill="k" Offer="t" /></td> }</tr> }</tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public Expedition Hunt { get; set; } = null!;
    /// <summary>The hunter whose score sheets the kills link to.</summary>
    [Parameter, EditorRequired] public string Handle { get; set; } = "";
}
