@inject AssetImages Images
@inject NavigationManager Nav
<div class="map" style="height:@(Height)px">
    @* the picture sits on the plane, so it zooms and pans with the markers *@
    <div class="plane" style="transform:scale(@(1 + zoomLevel * .5)) @Pan;@(Bg is { } u ? $"background:url('{u}') center / 100% 100% no-repeat" : "")">
        @foreach (var m in Markers)
        {
            var pickable = m.Kind is MarkerKind.Lodge or MarkerKind.Tent;
            var slot = SlotOf(m);
            <button type="button" class="marker k-@Name(m.Kind) @(slot is null ? "" : "pic") @(m.Id == Selected ? "selected" : "") @(m.Id == Hover ? "hover" : "")" style="left:@Pc(m.X)%;top:@Pc(m.Y)%" data-tip="@m.Name" disabled="@(!pickable)" aria-label="@m.Name" @onclick="() => OnPick.InvokeAsync(m)">
                @if (slot is not null) { <AssetSlot Name="@slot" Width="@MarkerSize" Height="@MarkerSize" /> }
                else { <Icon Name="@IconOf(m.Kind)" /> }
            </button>
        }
        @foreach (var (p, i) in Players.Select((p, i) => (p, i)))
        {
            <span class="hunter c@(i % 2)" style="left:@(p.X)%;top:@(p.Y)%"></span>
            @if (p.Handle == HoverPlayer)
            {
                <span class="hunter-label c@(i % 2)" style="left:@(p.X)%;top:@(p.Y)%"><AssetSlot Name="@p.Avatar" Width="24" Height="24" /> @p.Handle</span>
            }
        }
        @if (Markers.FirstOrDefault(m => m.Id == Hover) is { } at)
        {
            <span class="popup" style="left:@Pc(at.X)%;top:@Pc(at.Y)%">@at.Name</span>
        }
    </div>
    @if (Bg is null) { <span class="slot">@BgKey</span> }
    @if (Zoom)
    {
    <div class="zoom">
        <button type="button" data-tip="@L["Launch.ZoomIn"]" aria-label="@L["Launch.ZoomIn"]" disabled="@(zoomLevel == 2)" @onclick="() => zoomLevel++"><Icon Name="plus" /></button>
        <button type="button" data-tip="@L["Launch.ZoomOut"]" aria-label="@L["Launch.ZoomOut"]" disabled="@(zoomLevel == 0)" @onclick="() => zoomLevel--"><Icon Name="minus" /></button>
    </div>
    }
    @ChildContent
</div>

@code {
    int zoomLevel;
    int? centred;

    /// <summary>Stand-in for the Leaflet map of a reserve: markers sit at fixed percent positions, zoom scales them.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<MapMarker> Markers { get; set; } = [];
    [Parameter] public int Height { get; set; } = 750;
    [Parameter] public int? Selected { get; set; }
    /// <summary>Marker whose label is shown (the hover of the old marker lists).</summary>
    [Parameter] public int? Hover { get; set; }
    /// <summary>Marker to bring to the middle of the map (the click of the old marker lists); the map zooms in once if it is not.</summary>
    [Parameter] public int? Centre { get; set; }
    /// <summary>Hunters of a game, drawn as dots (the join map).</summary>
    [Parameter] public IReadOnlyList<GamePlayer> Players { get; set; } = [];
    /// <summary>Hunter whose name label is shown.</summary>
    [Parameter] public string? HoverPlayer { get; set; }
    /// <summary>The zoom buttons; the join map of the old interface has none.</summary>
    [Parameter] public bool Zoom { get; set; } = true;
    /// <summary>Raised when a lodge or tent marker is clicked.</summary>
    [Parameter] public EventCallback<MapMarker> OnPick { get; set; }
    /// <summary>Extra layer over the map (the start label, the join hint).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The reserve whose map picture is drawn (<c>map-&lt;NN&gt;</c>); none: <c>map-bg</c>.</summary>
    [Parameter] public int? Reserve { get; set; }

    string Pan => Markers.FirstOrDefault(m => m.Id == Centre) is { } m ? $"translate({Pc(50 - m.X)}%, {Pc(50 - m.Y)}%)" : "";
    string BgKey => Reserve is { } r ? $"map-{r:00}" : "map-bg";
    string? Bg => Images.Url(BgKey);

    protected override void OnParametersSet()
    {
        if (Bg is null) Images.NoteMissing(BgKey, new Uri(Nav.Uri).AbsolutePath);
        if (Centre is null || Centre == centred) return;
        centred = Centre;
        if (Zoom && zoomLevel == 0) zoomLevel = 1;
    }

    const int MarkerSize = 24;

    /// <summary>A percent as the style wants it: a point for the decimals in every culture.</summary>
    public static string Pc(double percent) => Fmt.Num(percent, "0.##");

    static string Name(MarkerKind kind) => kind.ToString().ToLowerInvariant();

    /// <summary>The picture slot of a marker on a reserve map, <c>marker-&lt;kind&gt;</c> (<c>-active</c> for the selected or hovered one, when the operator has that picture), or null: the score sheet's map, or no picture of the kind, and the marker is its icon.</summary>
    string? SlotOf(MapMarker m)
    {
        if (Reserve is null) return null;
        var slot = "marker-" + Name(m.Kind);
        if (m.Id == Selected || m.Id == Hover)
            if (Images.Url(slot + "-active") is not null) return slot + "-active";
        if (Images.Url(slot) is not null) return slot;
        Images.NoteMissing(slot, new Uri(Nav.Uri).AbsolutePath);
        return null;
    }

    static string IconOf(MarkerKind kind) => kind switch
    {
        MarkerKind.Lodge => "house",
        MarkerKind.Tent => "campground",
        MarkerKind.Campsite => "fire",
        MarkerKind.Tower => "tower-observation",
        MarkerKind.Bait => "bucket",
        MarkerKind.Feeder => "bucket",
        MarkerKind.GroundBlind => "bullseye",
        _ => "location-dot",
    };

    /// <summary>The icon of a marker kind, for the lists beside the map.</summary>
    public static string IconFor(MarkerKind kind) => IconOf(kind);
}
