@inject IProfileService Service
@inject ModalService Modal
@inject IFriendsService Friends

@if (page is not null)
{
    @if (rows.Count == 0) { <p class="empty">@L["Prof.FriendsEmpty"]</p> }
    <ul class="list">
        @foreach (var f in rows)
        {
            <li>
                <AssetSlot Name="avatar" Width="48" Height="48" />
                <a href="/profile/@f.Handle" class="handle">@f.Handle</a> <Icon Name="paw" /> @f.HunterScore
                <span class="buttons">
                    <a class="btn btn-primary" href="/messages/@f.Handle">@L["Friends.SendMessage"]</a>
                    @if (Own) { <button class="btn btn-inverse" @onclick="() => Remove(f)">@L["Friends.Remove"]</button> }
                </span>
            </li>
        }
    </ul>
    <PrevNext Page="page.Number" Pages="page.Pages" Base="@("/profile/" + Handle + "/friends")" />
}

@code {
    Page<ProfileFriend>? page;
    List<ProfileFriend> rows = [];

    [Parameter, EditorRequired] public string Handle { get; set; } = "";
    [Parameter] public bool Own { get; set; }
    [Parameter] public string? Sub { get; set; }

    protected override Task OnParametersSetAsync() => Load();

    async Task Load()
    {
        page = await Service.FriendsAsync(Handle, int.TryParse(Sub, out var n) ? n : 1);
        rows = [.. page.Rows];
    }

    // the friend goes from the friends service, so the dropdown and the profile of that hunter agree; the list is read again as the old page did
    async Task Remove(ProfileFriend f)
    {
        if (!await Modal.Confirm(L["Friends.RemoveConfirm", f.Handle])) return;
        await Friends.RemoveAsync(f.Handle);
        await Load();
    }
}
