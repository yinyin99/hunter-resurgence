<PageTitle>@Title - @L["App.Name"]</PageTitle>
<header class="page-header">
    <h1>@Title</h1>
    @if (!string.IsNullOrEmpty(Lead))
    {
        <p class="lead">@Lead</p>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Lead { get; set; }
}
